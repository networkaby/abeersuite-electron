{
  "name": "abeersuite-electron",
  "version": "1.16.12",
  "description": "AbeerSuite Desktop Operating System",
  "author": "AbeerSuite",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-http-header-size=65536 next dev",
    "electron:dev": "concurrently -k -n \"NEXT,ELECTRON\" -c \"yellow,cyan\" \"cross-env PORT=786 NODE_OPTIONS=--max-http-header-size=65536 next dev\" \"wait-on http-get://127.0.0.1:786/staff/login && tsc -p electron/tsconfig.json && electron .\"",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "pg:fetch": "tsx scripts/fetch-pg.ts",
    "7za:fetch": "tsx scripts/fetch-7za.ts",
    "electron:build": "tsx scripts/electron-build.ts",
    "electron:pack": "pnpm electron:build && electron-builder --dir && pnpm verify:package",
    "electron:dist": "pnpm electron:build && electron-builder && pnpm verify:package",
    "electron:release": "pnpm electron:pack && tsx scripts/release-electron.ts",
    "verify:package": "tsx scripts/verify-package.ts",
    "icon:build": "electron scripts/make-icon.js",
    "build:downloader": "tsx scripts/build-downloader.ts",
    "build:downloader:dev": "tsx scripts/build-downloader-dev.ts",
    "build:update-splash": "tsx scripts/build-update-splash.ts",
    "vercel-build": "prisma migrate deploy && pnpm build",
    "build": "tsx scripts/strip-build.ts && prisma generate && cross-env NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/counter-build.ts",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:bridge": "node --test hardware-bridge/thermal.test.js",
    "test:reconcile": "node sync-engine/test-reconcile.js",
    "test:child-watermark": "node sync-engine/test-child-watermark.js",
    "reconcile:shop-orders": "tsx src/scripts/reconcile-shop-order-accounts.ts",
    "validate:account-linked-flow": "tsx src/scripts/validate-account-linked-flow.ts",
    "seed:helper-brands": "tsx prisma/seeds/helper-brands.ts",
    "seed:helper-all": "pnpm seed:helper-brands && pnpm seed:check-docs",
    "seed:generic": "tsx prisma/seeds/bootstrap-seed.ts",
    "seed:personal:capture": "tsx prisma/seeds/export-personal.ts",
    "seed:personal": "tsx prisma/seeds/personal-bootstrap.ts",
    "seed:purge-vouchers": "tsx prisma/seeds/purge-vouchers.ts",
    "seed:purge-demo-contacts": "tsx prisma/seeds/purge-demo-contacts.ts",
    "seed:purge-demo-products": "tsx prisma/seeds/purge-demo-products.ts",
    "seed:purge-demo": "pnpm seed:purge-demo-contacts && pnpm seed:purge-demo-products",
    "seed:hard-clean": "tsx prisma/seeds/hard-clean.ts",
    "seed:recompute-balances": "tsx prisma/seeds/recompute-balances.ts",
    "recompute:caches": "tsx src/scripts/recompute-caches.ts",
    "report:ps-double-count": "tsx src/scripts/report-physical-stock-double-count.ts",
    "backfill:receipt-allocations": "tsx src/scripts/backfill-online-receipt-allocations.ts",
    "backfill:voucher-branch": "tsx src/scripts/backfill-voucher-branch.ts",
    "backfill:pos-promo": "tsx src/scripts/backfill-pos-promo-snapshots.ts",
    "backfill:staff-codes": "tsx src/scripts/backfill-staff-codes.ts",
    "repair:bill-links": "tsx src/scripts/repair-bill-links.ts",
    "reconcile:bill-links": "tsx src/scripts/reconcile-bill-links.ts",
    "verify:bill-links": "tsx src/scripts/verify-bill-links.ts",
    "verify:line-resurrection": "tsx src/scripts/verify-line-resurrection.ts",
    "opening:preview": "tsx src/scripts/opening-bills-preview.ts",
    "opening:to-bills": "tsx src/scripts/opening-bills-backfill.ts",
    "opening:drop-suspense": "tsx src/scripts/opening-bills-drop-suspense.ts",
    "check:voucher-ledger": "tsx src/scripts/check-voucher-ledger.ts",
    "check:voucher-duplicates": "tsx src/scripts/check-voucher-duplicates.ts",
    "seed:apply-taxonomy": "tsx prisma/seeds/apply-taxonomy.ts",
    "seed:sync-permissions": "tsx prisma/seeds/sync-permissions.ts",
    "seed:leave-types": "tsx prisma/seeds/ensure-leave-types.ts",
    "seed:pos-return-template": "tsx prisma/seeds/ensure-pos-return-template.ts",
    "check:counter-mode": "tsx scripts/check-counter-mode.ts vercel && tsx scripts/check-counter-mode.ts counter && tsx scripts/check-counter-mode.ts counter-write-local && tsx scripts/check-counter-mode.ts counter-write-relay && tsx scripts/check-counter-mode.ts counter-write-relay-unconfigured",
    "sync:tables": "tsx scripts/gen-sync-registry.ts",
    "sync:tables:check": "tsx scripts/gen-sync-registry.ts --check",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:new": "prisma migrate dev --create-only",
    "db:migrate:baseline": "prisma migrate resolve --applied 0_init",
    "db:migrate:status": "prisma migrate status",
    "db:local-schema": "tsx scripts/gen-local-schema.ts",
    "db:local-schema:check": "tsx scripts/gen-local-schema.ts --check",
    "db:compare": "tsx scripts/compare-dbs.ts",
    "vyapar:survey": "tsx scripts/vyapar/survey.ts",
    "vyapar:check-balances": "tsx scripts/vyapar/check-balances.ts",
    "vyapar:restore-local": "tsx scripts/vyapar/restore-local.ts",
    "vyapar:match-report": "tsx scripts/vyapar/match-report.ts",
    "vyapar:ledger-map": "tsx scripts/vyapar/ledger-map.ts",
    "vyapar:create-ledgers": "tsx scripts/vyapar/create-ledgers.ts",
    "vyapar:dup-report": "tsx --tsconfig scripts/vyapar/tsconfig.json scripts/vyapar/dup-report.ts",
    "vyapar:replay": "tsx --tsconfig scripts/vyapar/tsconfig.json scripts/vyapar/replay.ts",
    "vyapar:loyalty": "tsx --tsconfig scripts/vyapar/tsconfig.json scripts/vyapar/loyalty.ts",
    "vyapar:reconcile": "tsx --tsconfig scripts/vyapar/tsconfig.json scripts/vyapar/reconcile.ts",
    "vyapar:replay-check": "tsx --tsconfig scripts/vyapar/tsconfig.json scripts/vyapar/replay-check.ts",
    "vyapar:resolve": "tsx --tsconfig scripts/vyapar/tsconfig.json scripts/vyapar/resolve.ts",
    "vyapar:opening-report": "tsx --tsconfig scripts/vyapar/tsconfig.json scripts/vyapar/opening-report.ts",
    "vyapar:opening": "tsx --tsconfig scripts/vyapar/tsconfig.json scripts/vyapar/opening.ts",
    "vyapar:pl-check": "tsx --tsconfig scripts/vyapar/tsconfig.json scripts/vyapar/pl-check.ts",
    "vyapar:table-audit": "tsx --tsconfig scripts/vyapar/tsconfig.json scripts/vyapar/table-audit.ts",
    "vyapar:payments": "tsx --tsconfig scripts/vyapar/tsconfig.json scripts/vyapar/payments.ts",
    "vyapar:backfill-details": "tsx --tsconfig scripts/vyapar/tsconfig.json scripts/vyapar/backfill-details.ts",
    "vyapar:renumber": "tsx --tsconfig scripts/vyapar/tsconfig.json scripts/vyapar/renumber-own-vouchers.ts",
    "vyapar:backup-live": "tsx scripts/vyapar/backup-live.ts",
    "pos:renumber-shifts": "tsx scripts/renumber-shifts.ts",
    "seed:check-docs": "tsx scripts/check-doc-sync.ts",
    "seed:fix-docs": "tsx scripts/check-doc-sync.ts --fix",
    "check:nav-icons": "tsx scripts/check-nav-icons.ts",
    "check:guard-lint": "tsx scripts/check-guard-lint.ts",
    "check:state-file": "tsx scripts/check-state-file.ts",
    "precommit": "tsx scripts/check-doc-sync.ts --strict && tsx scripts/check-nav-icons.ts && tsx scripts/gen-sync-registry.ts --check && tsx scripts/gen-local-schema.ts --check && tsx scripts/check-counter-mode.ts vercel && tsx scripts/check-counter-mode.ts counter && tsx scripts/check-counter-mode.ts counter-write-local && tsx scripts/check-counter-mode.ts counter-write-relay && tsx scripts/check-counter-mode.ts counter-write-relay-unconfigured && tsx scripts/check-guard-lint.ts",
    "install:git-hooks": "tsx scripts/install-git-hooks.ts",
    "seed:demo-attendance": "tsx prisma/seeds/demo-attendance.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.84",
    "@ai-sdk/google": "^4.0.98",
    "@ai-sdk/openai": "^4.0.98",
    "@ai-sdk/openai-compatible": "^3.0.74",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nextjs": "10",
    "@supabase/supabase-js": "^2.104.1",
    "@tanstack/react-virtual": "^3.13.25",
    "ai": "^7.0.142",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dexie": "^4.4.5",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "firebase": "^12.16.0",
    "jose": "^6.2.2",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.8.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.30",
    "next-cloudinary": "^6.17.5",
    "next-themes": "^0.4.6",
    "node-thermal-printer": "^4.6.1",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.72.1",
    "recharts": "^3.10.0",
    "require-in-the-middle": "^8.0.1",
    "serialport": "^13.0.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.29.0",
    "web-push": "^3.6.7",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "build": {
    "appId": "com.abeersuite.desktop",
    "productName": "AbeerSuite",
    "npmRebuild": false,
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist-electron/**/*",
      "!node_modules/**/*",
      "!**/node_modules/**/*",
      "dist-electron/node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          "!.env",
          "!.env.*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules",
        "filter": [
          "**/*",
          "!**/.env",
          "!**/.env.*"
        ]
      },
      {
        "from": "resources/counter.env",
        "to": "counter.env"
      },
      {
        "from": "resources/7za.exe",
        "to": "7za.exe"
      },
      {
        "from": "resources/swap-update.ps1",
        "to": "swap-update.ps1"
      },
      {
        "from": "resources/local-schema.sql",
        "to": "local-schema.sql"
      },
      {
        "from": "resources/shell",
        "to": "shell"
      },
      {
        "from": "sync-engine",
        "to": "sync-engine",
        "filter": [
          "**/*",
          "!config.json"
        ]
      },
      {
        "from": "prisma/sync-tables.json",
        "to": "sync-engine/sync-tables.json"
      },
      {
        "from": "hardware-bridge",
        "to": "hardware-bridge",
        "filter": [
          "**/*",
          "!config.json"
        ]
      },
      {
        "from": "sync-engine/node_modules",
        "to": "sync-engine/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "hardware-bridge/node_modules",
        "to": "hardware-bridge/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/pgsql",
        "to": "pgsql",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/AbeerSuiteUpdateSplash.exe",
        "to": "AbeerSuiteUpdateSplash.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "runAfterFinish": true,
      "installerHeaderIcon": "build/icon.ico",
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "AbeerSuite",
      "differentialPackage": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "include": "build/installer.nsh"
    }
  }
}
