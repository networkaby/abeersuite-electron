{
  "name": "abeersuite-electron",
  "version": "0.1.0",
  "description": "AbeerSuite Desktop Operating System",
  "author": "AbeerSuite",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-http-header-size=65536 next dev",
    "electron:dev": "concurrently -k -n \"NEXT,ELECTRON\" -c \"yellow,cyan\" \"cross-env PORT=3000 NODE_OPTIONS=--max-http-header-size=65536 next dev\" \"wait-on http-get://127.0.0.1:3000/staff/login && tsc -p electron/tsconfig.json && electron .\"",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:build": "cross-env COUNTER_BUILD=1 pnpm build && tsx scripts/prepare-standalone.ts && tsx scripts/generate-counter-env.ts && pnpm electron:compile",
    "electron:pack": "pnpm electron:build && electron-builder --dir && pnpm verify:package",
    "electron:dist": "pnpm electron:build && electron-builder && pnpm verify:package",
    "verify:package": "tsx scripts/verify-package.ts",
    "icon:build": "electron scripts/make-icon.js",
    "build": "prisma generate && cross-env NODE_OPTIONS=--max-old-space-size=8192 next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "reconcile:shop-orders": "tsx src/scripts/reconcile-shop-order-accounts.ts",
    "validate:account-linked-flow": "tsx src/scripts/validate-account-linked-flow.ts",
    "seed:dummy-users": "tsx prisma/seeds/dummy-users.ts",
    "seed:dummy-org-rich": "tsx prisma/seeds/dummy-org-rich.ts",
    "seed:dummy-shop": "tsx prisma/seeds/dummy-shop.ts",
    "seed:dummy-customers": "tsx prisma/seeds/dummy-customers.ts",
    "seed:dummy-vouchers": "tsx prisma/seeds/dummy-vouchers.ts",
    "seed:dummy-tasks": "tsx prisma/seeds/dummy-tasks.ts",
    "seed:dummy-deals": "tsx prisma/seeds/dummy-deals.ts",
    "seed:helper-brands": "tsx prisma/seeds/helper-brands.ts",
    "seed:helper-inventory": "tsx prisma/seeds/helper-inventory-masters.ts",
    "seed:helper-roles": "tsx prisma/seeds/helper-roles.ts",
    "seed:generic": "tsx prisma/seeds/bootstrap-seed.ts",
    "seed:personal:capture": "tsx prisma/seeds/export-personal.ts",
    "seed:personal": "tsx prisma/seeds/personal-bootstrap.ts",
    "seed:dummy-all": "pnpm seed:dummy-customers && pnpm seed:helper-roles && pnpm seed:dummy-users && pnpm seed:helper-brands && pnpm seed:helper-inventory && pnpm seed:dummy-shop && pnpm seed:dummy-vouchers && pnpm seed:dummy-tasks && pnpm seed:dummy-deals && pnpm seed:check-docs",
    "seed:purge-vouchers": "tsx prisma/seeds/purge-vouchers.ts",
    "seed:purge-demo-contacts": "tsx prisma/seeds/purge-demo-contacts.ts",
    "seed:purge-demo-products": "tsx prisma/seeds/purge-demo-products.ts",
    "seed:purge-demo": "pnpm seed:purge-demo-contacts && pnpm seed:purge-demo-products",
    "seed:hard-clean": "tsx prisma/seeds/hard-clean.ts",
    "seed:recompute-balances": "tsx prisma/seeds/recompute-balances.ts",
    "seed:apply-permissions": "tsx prisma/seeds/apply-permissions.ts",
    "seed:apply-delivery-methods": "tsx prisma/seeds/apply-delivery-methods.ts",
    "seed:apply-help-pipeline": "tsx prisma/seeds/apply-help-pipeline.ts",
    "seed:apply-status-entered-at": "tsx prisma/seeds/apply-status-entered-at.ts",
    "seed:apply-credit-card-group": "tsx prisma/seeds/apply-credit-card-group.ts",
    "seed:apply-account-groups": "tsx prisma/seeds/apply-account-groups.ts",
    "seed:apply-workgroup-name": "tsx prisma/seeds/apply-workgroup-name.ts",
    "check:counter-mode": "tsx scripts/check-counter-mode.ts vercel && tsx scripts/check-counter-mode.ts counter",
    "sync:tables": "tsx scripts/gen-sync-registry.ts",
    "sync:tables:check": "tsx scripts/gen-sync-registry.ts --check",
    "seed:check-docs": "tsx scripts/check-doc-sync.ts",
    "seed:fix-docs": "tsx scripts/check-doc-sync.ts --fix",
    "check:nav-icons": "tsx scripts/check-nav-icons.ts",
    "precommit": "tsx scripts/check-doc-sync.ts --strict && tsx scripts/check-nav-icons.ts && tsx scripts/gen-sync-registry.ts --check && tsx scripts/check-counter-mode.ts vercel && tsx scripts/check-counter-mode.ts counter",
    "install:git-hooks": "tsx scripts/install-git-hooks.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nextjs": "10",
    "@supabase/supabase-js": "^2.104.1",
    "@tanstack/react-virtual": "^3.13.25",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dexie": "^4.4.5",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "firebase": "^12.16.0",
    "jose": "^6.2.2",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.8.0",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.30",
    "next-cloudinary": "^6.17.5",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.72.1",
    "recharts": "^3.10.0",
    "require-in-the-middle": "^8.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
  "build": {
    "appId": "com.abeersuite.desktop",
    "productName": "AbeerSuite",
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          "!.env",
          "!.env.*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules",
        "filter": [
          "**/*",
          "!**/.env",
          "!**/.env.*"
        ]
      },
      {
        "from": "resources/counter.env",
        "to": "counter.env"
      },
      {
        "from": "resources/pgsql",
        "to": "pgsql",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AbeerSuite"
    }
  }
}
