generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TECHNICIAN
  FRONT_DESK
}

enum Status {
  RECEIVED
  DIAGNOSING
  REPAIRING
  ESCALATED
  RECEIVED_BACK
  READY
  RETURNED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model User {
  id         Int         @id @default(autoincrement())
  name       String
  email      String      @unique
  password   String
  role       Role        @default(TECHNICIAN)
  tickets    Ticket[]
  ticketLogs TicketLog[]
  createdAt  DateTime    @default(now())
}

model Customer {
  id            Int       @id @default(autoincrement())
  name          String
  phone         String
  email         String?
  devices       Device[]
  agreedToTerms Boolean   @default(false)
  agreedAt      DateTime?
  createdAt     DateTime  @default(now())
}

model Device {
  id         Int      @id @default(autoincrement())
  type       String
  brand      String
  model      String
  problem    String
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId Int
  tickets    Ticket[] // ← was ticket Ticket?
}

model Ticket {
  id              Int            @id @default(autoincrement())
  status          Status         @default(RECEIVED)
  priority        Priority       @default(NORMAL)
  notes           String?
  accessInfo      String?
  estimatedCost   Float?
  device          Device         @relation(fields: [deviceId], references: [id])
  deviceId        Int // ← remove @unique
  technician      User?          @relation(fields: [technicianId], references: [id])
  technicianId    Int?
  escalated       Boolean        @default(false)
  escalatedAt     DateTime?
  expectedReturn  DateTime?
  receivedBackAt  DateTime?
  externalRef     String?
  serviceCenter   ServiceCenter? @relation(fields: [serviceCenterId], references: [id])
  serviceCenterId Int?
  logs            TicketLog[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model TicketLog {
  id        Int      @id @default(autoincrement())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  ticketId  Int
  status    Status
  note      String?
  changedBy User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime @default(now())
}

model ServiceCenter {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  address   String?
  tickets   Ticket[]
  createdAt DateTime @default(now())
}
