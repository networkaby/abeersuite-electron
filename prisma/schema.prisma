generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Pipeline {
  id          String   @id
  name        String   @unique
  label       String
  description String?
  color       String   @default("bg-gray-100 text-gray-600")
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  statuses    TicketStatus[]
  subStatuses TicketSubStatus[]
  tickets     Ticket[]
}

model TicketStatus {
  id              String             @id
  label           String
  color           String
  order           Int
  isTerminal      Boolean            @default(false)
  isEntryPoint    Boolean            @default(false)
  allowedRoles    String[]
  notifyRoles     String[]
  actionLabel     String?
  warrantyScope   String             @default("any")
  pipelineId      String?
  pipeline        Pipeline?          @relation(fields: [pipelineId], references: [id])
  fromTransitions StatusTransition[] @relation("FromStatus")
  toTransitions   StatusTransition[] @relation("ToStatus")
  tickets         Ticket[]
  logs            TicketLog[]
}

model TicketSubStatus {
  id                  String                @id
  label               String
  color               String                @default("bg-gray-100 text-gray-600")
  group               String
  order               Int
  applicableStatusIds String[]
  allowedRoles        String[]
  notifyRoles         String[]
  triggerMap          Json                  @default("{}")
  actionLabel         String?
  autoRevertOnClear   Boolean               @default(true)
  handoffRole         String?
  warrantyScope       String                @default("any")
  groupId             String?
  pipelineId          String?
  pipeline            Pipeline?             @relation(fields: [pipelineId], references: [id])
  fromTransitions     SubStatusTransition[] @relation("FromSubStatus")
  toTransitions       SubStatusTransition[] @relation("ToSubStatus")
  tickets             Ticket[]
  logs                TicketLog[]
  participants        TicketParticipant[]   @relation("ParticipantSubStatus")
  SubStatusGroup      SubStatusGroup?       @relation(fields: [groupId], references: [id])
}

model SubStatusTransition {
  id              Int              @id @default(autoincrement())
  fromSubStatusId String?
  toSubStatusId   String
  from            TicketSubStatus? @relation("FromSubStatus", fields: [fromSubStatusId], references: [id], onDelete: Cascade)
  to              TicketSubStatus  @relation("ToSubStatus", fields: [toSubStatusId], references: [id], onDelete: Cascade)

  @@unique([fromSubStatusId, toSubStatusId])
}

model StatusTransition {
  id           Int          @id @default(autoincrement())
  fromStatusId String
  toStatusId   String
  from         TicketStatus @relation("FromStatus", fields: [fromStatusId], references: [id], onDelete: Cascade)
  to           TicketStatus @relation("ToStatus", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@unique([fromStatusId, toStatusId])
}

model Priority {
  id      String   @id
  label   String
  color   String
  order   Int
  tasks   Task[]
  tickets Ticket[]
}

model Role {
  id          String               @id
  label       String
  color       String
  isSystem    Boolean              @default(false)
  users       User[]
  userRoles   UserRole[]
  permissions UserRolePermission[]
}

model Permission {
  id          String               @id
  label       String
  description String?
  module      String               @default("core")
  userGrants  UserPermission[]
  roleGrants  UserRolePermission[]
}

model UserRole {
  userId     Int
  roleId     String
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
}

model UserRolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       Int
  permissionId String
  granted      Boolean    @default(true)
  grantedBy    Int?
  grantedAt    DateTime   @default(now())
  granter      User?      @relation("UserPermissionGranter", fields: [grantedBy], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation("UserPermissionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model User {
  id                 Int                 @id @default(autoincrement())
  name               String
  email              String              @unique
  password           String
  role               String              @default("R2")
  createdAt          DateTime            @default(now())
  managerId          Int?
  notifications      Notification[]
  assignedTasks      Task[]              @relation("TaskAssignee")
  createdTasks       Task[]              @relation("TaskCreator")
  pickedUpTasks      Task[]              @relation("TaskPickup")
  taskLogs           TaskLog[]           @relation("TaskLogUser")
  ownedTickets       Ticket[]
  ticketLogs         TicketLog[]
  participantAdded   TicketParticipant[] @relation("ParticipantAddedBy")
  participantEntries TicketParticipant[] @relation("ParticipantUser")
  manager            User?               @relation("UserHierarchy", fields: [managerId], references: [id])
  reports            User[]              @relation("UserHierarchy")
  userRole           Role                @relation(fields: [role], references: [id])
  grantedPerms       UserPermission[]    @relation("UserPermissionGranter")
  permissions        UserPermission[]    @relation("UserPermissionUser")
  userRoles          UserRole[]
  warrantyLogs       WarrantyLog[]       @relation("WarrantyLogUser")
  journalEntries     JournalEntry[]      @relation("JournalCreatedBy")
  invoices           Invoice[]           @relation("InvoiceCreatedBy")
  payments           Payment[]           @relation("PaymentCreatedBy")
}

// ── Identity models ───────────────────────────────────────────────────────────

model Customer {
  id            Int               @id @default(autoincrement())
  name          String
  phone         String?
  email         String?
  address       String?
  agreedToTerms Boolean           @default(false)
  agreedAt      DateTime?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())

  account       Account?
  devices       Device[]
  companies     CustomerCompany[]
}

model Company {
  id         Int               @id @default(autoincrement())
  name       String
  phone      String?
  email      String?
  address    String?
  companyReg String?
  taxId      String?
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())

  account    Account?
  devices    Device[]
  customers  CustomerCompany[]
}

model CustomerCompany {
  id         Int       @id @default(autoincrement())
  customerId Int
  companyId  Int
  role       String?
  linkedAt   DateTime  @default(now())
  unlinkedAt DateTime?
  customer   Customer  @relation(fields: [customerId], references: [id])
  company    Company   @relation(fields: [companyId], references: [id])

  @@index([customerId])
  @@index([companyId])
}

// Pure ledger — one Account per Customer or Company. Internal only.
model Account {
  id         Int       @id @default(autoincrement())
  customerId Int?      @unique
  companyId  Int?      @unique
  createdAt  DateTime  @default(now())

  customer      Customer? @relation(fields: [customerId], references: [id])
  company       Company?  @relation(fields: [companyId], references: [id])
  billedTickets Ticket[]  @relation("TicketBillingAccount")
}

// ── Device / Ticket ───────────────────────────────────────────────────────────

model Device {
  id         Int       @id @default(autoincrement())
  type       String
  brand      String
  model      String
  problem    String
  customerId Int?
  companyId  Int?
  customer   Customer? @relation(fields: [customerId], references: [id])
  company    Company?  @relation(fields: [companyId], references: [id])
  tickets    Ticket[]
}

model Ticket {
  id              Int                 @id @default(autoincrement())
  pipelineId      String?
  pipeline        Pipeline?           @relation(fields: [pipelineId], references: [id])
  status          String              @default("S1")
  priority        String              @default("P2")
  notes           String?
  accessInfo      String?
  estimatedCost   Float?
  deviceId        Int
  escalated       Boolean             @default(false)
  escalatedAt     DateTime?
  expectedReturn  DateTime?
  receivedBackAt  DateTime?
  externalRef     String?
  serviceCenterId Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  subStatusId     String?
  escalationType  String?
  isWarranty      Boolean             @default(false)
  primaryOwnerId  Int?
  billingAccountId Int?
  purchaseDate    DateTime?
  voidReason      String?
  warrantyRef     String?
  warrantyStatus  String              @default("none")
  notifications   Notification[]
  tasks           Task[]
  device          Device              @relation(fields: [deviceId], references: [id])
  primaryOwner    User?               @relation(fields: [primaryOwnerId], references: [id])
  billingAccount  Account?            @relation("TicketBillingAccount", fields: [billingAccountId], references: [id])
  ticketPriority  Priority            @relation(fields: [priority], references: [id])
  serviceCenter   ServiceCenter?      @relation(fields: [serviceCenterId], references: [id])
  ticketStatus    TicketStatus        @relation(fields: [status], references: [id])
  ticketSubStatus TicketSubStatus?    @relation(fields: [subStatusId], references: [id])
  logs            TicketLog[]
  participants    TicketParticipant[]
  warrantyLogs    WarrantyLog[]
}

model WarrantyLog {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  fromWarranty Boolean
  toWarranty   Boolean
  fromStatus   String
  toStatus     String
  voidReason   String?
  note         String?
  changedById  Int
  createdAt    DateTime @default(now())
  changedBy    User     @relation("WarrantyLogUser", fields: [changedById], references: [id])
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model TicketParticipant {
  id                   Int              @id @default(autoincrement())
  ticketId             Int
  userId               Int
  addedById            Int
  addedForRole         String?
  addedBySubStatusId   String?
  removedAt            DateTime?
  removedBySubStatusId String?
  createdAt            DateTime         @default(now())
  addedBy              User             @relation("ParticipantAddedBy", fields: [addedById], references: [id])
  addedBySubStatus     TicketSubStatus? @relation("ParticipantSubStatus", fields: [addedBySubStatusId], references: [id])
  ticket               Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user                 User             @relation("ParticipantUser", fields: [userId], references: [id])

  @@unique([ticketId, userId, addedBySubStatusId])
  @@index([ticketId])
  @@index([userId])
}

model TicketLog {
  id              Int              @id @default(autoincrement())
  ticketId        Int
  status          String
  note            String?
  userId          Int
  createdAt       DateTime         @default(now())
  subStatusId     String?
  visibility      String           @default("internal")
  ticketStatus    TicketStatus     @relation(fields: [status], references: [id])
  ticketSubStatus TicketSubStatus? @relation(fields: [subStatusId], references: [id])
  ticket          Ticket           @relation(fields: [ticketId], references: [id])
  changedBy       User             @relation(fields: [userId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  ticketId  Int
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model ServiceCenter {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  address   String?
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model Task {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?
  source       String    @default("manual")
  status       String    @default("open")
  priority     String    @default("P2")
  assignedToId Int?
  assignedRole String?
  pickedUpById Int?
  pickedUpAt   DateTime?
  ticketId     Int?
  createdById  Int
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  assignedTo   User?     @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy    User      @relation("TaskCreator", fields: [createdById], references: [id])
  pickedUpBy   User?     @relation("TaskPickup", fields: [pickedUpById], references: [id])
  taskPriority Priority  @relation(fields: [priority], references: [id])
  ticket       Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  logs         TaskLog[]

  @@unique([ticketId, assignedRole, source, status])
}

model TaskLog {
  id        Int      @id @default(autoincrement())
  taskId    Int
  action    String
  note      String?
  byUserId  Int
  createdAt DateTime @default(now())
  byUser    User     @relation("TaskLogUser", fields: [byUserId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model SubStatusGroup {
  id              String            @id
  label           String
  order           Int               @default(0)
  TicketSubStatus TicketSubStatus[]
}

// ── Finance Module ─────────────────────────────────────────────────────────────
// Standalone — no FK relations to Ticket/Account/Device.
// Customer/Company references use loose partyType + partyId (no FK constraint).

enum GlAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalStatus {
  DRAFT
  POSTED
  VOIDED
}

enum EntryType {
  DEBIT
  CREDIT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  MOBILE_PAYMENT
  OTHER
}

model GlAccount {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  name          String
  type          GlAccountType
  normalBalance NormalBalance
  description   String?
  isActive      Boolean       @default(true)
  balance       Decimal       @default(0) @db.Decimal(14, 2)
  parentId      Int?
  parent        GlAccount?    @relation("GlAccountHierarchy", fields: [parentId], references: [id])
  children      GlAccount[]   @relation("GlAccountHierarchy")
  lines         JournalLine[]
  createdAt     DateTime      @default(now())

  @@index([type])
  @@index([isActive])
}

model JournalEntry {
  id          Int           @id @default(autoincrement())
  date        DateTime      @db.Date
  reference   String        @unique
  description String
  status      JournalStatus @default(DRAFT)
  postedAt    DateTime?
  voidedAt    DateTime?
  voidReason  String?
  createdById Int
  createdBy   User          @relation("JournalCreatedBy", fields: [createdById], references: [id])
  lines       JournalLine[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, date])
  @@index([date])
}

model JournalLine {
  id             Int          @id @default(autoincrement())
  journalEntryId Int
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  glAccountId    Int
  glAccount      GlAccount    @relation(fields: [glAccountId], references: [id])
  type           EntryType
  amount         Decimal      @db.Decimal(14, 2)
  description    String?

  @@index([glAccountId])
  @@index([glAccountId, journalEntryId])
}

model Invoice {
  id          Int           @id @default(autoincrement())
  number      String        @unique
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime      @db.Date
  dueDate     DateTime      @db.Date
  notes       String?
  partyName   String
  partyType   String
  partyId     Int
  subtotal    Decimal       @db.Decimal(14, 2)
  taxAmount   Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount Decimal       @db.Decimal(14, 2)
  amountPaid  Decimal       @default(0) @db.Decimal(14, 2)
  amountDue   Decimal       @db.Decimal(14, 2)
  createdById Int
  createdBy   User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  lines       InvoiceLine[]
  payments    Payment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([partyType, partyId])
  @@index([issueDate])
}

model InvoiceLine {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)

  @@index([invoiceId])
}

model Payment {
  id             Int           @id @default(autoincrement())
  invoiceId      Int
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  amount         Decimal       @db.Decimal(14, 2)
  method         PaymentMethod
  reference      String?
  date           DateTime      @db.Date
  notes          String?
  journalEntryId Int?
  createdById    Int
  createdBy      User          @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())

  @@index([invoiceId])
}
