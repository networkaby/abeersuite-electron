// ── POS Counter, Shift & Cash-drawer reconciliation ───────────────────────────
//
// Each branch has one or more POS counters (physical billing stations). Each
// counter has its own GL till account (e.g. "Cash – Counter 1 – Main Branch").
// Cashiers open shifts at a specific counter. Cash sales debit the counter's
// till account. At close, surplus cash is swept to the branch vault via Contra;
// a configurable float can be left in the counter overnight (carryOverNextPaise).
//
// Shift handover (A → B, same counter):
//   A initiates (shift → AWAITING_HANDOVER), A logs out, B logs in, B counts
//   the physical cash and accepts. On accept: variance JE + closing Contra
//   (surplus to vault) are posted, A's shift is CLOSED, B's shift opens.
//   No Contra needed for same-counter handover — cash never leaves the counter
//   till account.
//
// Contra is only needed when cash physically moves to/from the vault:
//   • Day start top-up:    Vault → Counter till (vaultTopUpPaise portion)
//   • End-of-day sweep:    Counter till → Vault (surplus after carry-over)
//
// See docs/modules/pos.md.

// ── POS Counter (physical billing station) ────────────────────────────────────

model PosCounter {
  id                       Int                        @id @default(autoincrement())
  branchId                 String
  branch                   Branch                     @relation("BranchCounters", fields: [branchId], references: [id])
  name                     String // "Counter 1", "Billing Desk", "Service Counter"
  tillAccountId            Int                        @unique
  tillAccount              Account                    @relation("CounterTill", fields: [tillAccountId], references: [id])
  // Non-cash payment accounts are a flexible LIST (paymentAccounts below) — each
  // a {channel, label, bank ledger, VPA?}. CASH always routes to tillAccountId
  // above; the list covers UPI (possibly several: UPI 1 → HDFC, UPI 2 → SBI),
  // Card, Cheque, Wallet, Bank Transfer, and gateway channels (Razorpay/Cashfree).
  // User-managed via /office/admin/counters.
  paymentAccounts          PosCounterPaymentAccount[]
  // POS Expenditure (Exp button) — which EXPENSE-group ledgers this counter may
  // spend to. Empty array = no restriction (all expense ledgers allowed). When
  // non-empty, only these account ids appear in the Exp dialog and the API
  // rejects anything else. Shape: number[] (Account ids).
  allowedExpenseAccountIds Json                       @default("[]")
  isActive                 Boolean                    @default(true)
  shifts                   PosShift[]

  @@unique([branchId, name])
  @@index([branchId])
  @@map("pos_counters")
}

// ── POS Counter payment account (one collection rail on a counter) ─────────────
//
// Replaces the former fixed per-method columns on PosCounter. A counter can now
// hold any number of these — e.g. two UPIs landing in different banks, plus a
// card terminal and a gateway. At checkout the cashier picks one; its `accountId`
// is the ledger debited (written onto InvVoucherTender.accountId) and its `vpa`
// drives the shared "Scan to Pay" QR. `channel` is the method dropdown; the
// InvVoucherTender's PaymentMethod is derived from it (see counterTenders.ts).
model PosCounterPaymentAccount {
  id             Int             @id @default(autoincrement())
  counterId      Int
  counter        PosCounter      @relation(fields: [counterId], references: [id], onDelete: Cascade)
  channel        PosPayChannel
  // Cashier-facing name shown on the checkout row, e.g. "UPI 1", "PhonePe", "HDFC UPI".
  label          String
  // The GL ledger that gets debited when money is collected via this account.
  accountId      Int
  account        Account         @relation("PosPayAccountLedger", fields: [accountId], references: [id])
  // UPI/gateway pay-to id (VPA), e.g. "networkservice@okhdfcbank". Drives the QR.
  vpa            String?
  // Reserved for future method-specific config (gateway merchant id / keys ref).
  configJson     Json            @default("{}")
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  // Show this account as a checkout row by default (like the old fixed UPI row).
  // Off = available only via "Add payment line". Set per account in the counters UI.
  defaultVisible Boolean         @default(false)
  // Optional link to a configured gateway from the global catalog (PaymentGateway),
  // set in the counters UI when channel = GATEWAY (e.g. this counter collects via
  // Razorpay). The GL ledger debited is still `accountId` above — the gateway is
  // metadata for which provider the cashier collects through, NOT a GL change.
  // Nullable + SetNull so deleting a catalog entry just clears this pointer.
  gatewayId      Int?
  gateway        PaymentGateway? @relation("PayAccountGateway", fields: [gatewayId], references: [id], onDelete: SetNull)

  @@index([counterId])
  @@index([accountId])
  @@index([gatewayId])
  @@map("pos_counter_payment_accounts")
}

// ── Payment Gateway (global catalog, configured in Settings → Payment Methods) ──
//
// The "heavy" payment configuration that doesn't belong on the per-counter screen.
// Each row is one configured gateway/method (Razorpay, Cashfree, manual UPI, …);
// a counter then PICKS one via PosCounterPaymentAccount.gatewayId, and online
// checkout reads the single `enabledForOnline` row.
//
// SECRETS NEVER LIVE HERE. API keys/secrets stay in env vars; the Settings page
// only reports whether a provider's env vars are present (✓/✗) — it never stores
// or returns their values. `configJson` holds NON-SECRET extras only (e.g. a
// manual UPI VPA). `provider` is a plain string keyed to the code registry
// (src/modules/pos/lib/paymentGateways.ts) so new providers (PayU, PayPal) need
// no migration. See docs/modules/pos.md.
model PaymentGateway {
  id                Int      @id @default(autoincrement())
  // Registry key: "razorpay" | "cashfree" | "manual_upi" | future "payu"/"paypal".
  provider          String
  displayName       String
  // "TEST" | "LIVE" — validated in the API; drives which env-var set is checked.
  environment       String   @default("TEST")
  // Selectable as a collection rail on a counter (PosCounterPaymentAccount.gatewayId).
  enabledForCounter Boolean  @default(true)
  // The active online-checkout gateway. API enforces ≤1 enabled per environment.
  enabledForOnline  Boolean  @default(false)
  // NON-SECRET config only (e.g. { "vpa": "shop@okhdfcbank" } for manual UPI).
  configJson        Json     @default("{}")
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  counterAccounts PosCounterPaymentAccount[] @relation("PayAccountGateway")

  @@index([provider])
  @@index([enabledForOnline])
  @@map("payment_gateways")
}

// ── POS Shift (one cashier's session at one counter) ─────────────────────────

model PosShift {
  id Int @id @default(autoincrement())

  // Who & where
  userId    Int
  user      User       @relation("PosShiftUser", fields: [userId], references: [id])
  counterId Int
  counter   PosCounter @relation(fields: [counterId], references: [id])
  // branchId duplicated from counter for indexed lookups (avoids join on hot paths)
  branchId  String
  branch    Branch     @relation("PosShiftBranch", fields: [branchId], references: [id])

  status PosShiftStatus @default(OPEN)

  // ── Open ──────────────────────────────────────────────────────────────────
  openedAt               DateTime @default(now())
  openedById             Int
  openedBy               User     @relation("PosShiftOpenedBy", fields: [openedById], references: [id])
  // openingFloatPaise = carryOverFloatPaise + vaultTopUpPaise
  openingFloatPaise      BigInt   @default(0)
  carryOverFloatPaise    BigInt   @default(0) // already in counter from previous close
  vaultTopUpPaise        BigInt   @default(0) // fresh draw from vault (Contra posted)
  // Phase 5 5E: carries the SPINE id of the opening Contra (Voucher table dropped).
  openingContraVoucherId Int? // null when vaultTopUpPaise = 0

  // ── Close ─────────────────────────────────────────────────────────────────
  closedAt               DateTime?
  closedById             Int?
  closedBy               User?     @relation("PosShiftClosedBy", fields: [closedById], references: [id])
  declaredCashPaise      BigInt? // what the closer physically counted
  expectedCashPaise      BigInt? // opening + cash sales − drops (computed at close)
  variancePaise          BigInt? // declared − expected; +ve = over, −ve = short
  carryOverNextPaise     BigInt? // float left in counter for next shift
  toVaultPaise           BigInt? // amount swept to vault (declared − carryOverNext)
  // Phase 5 5E: carries the SPINE id of the closing Contra (Voucher table dropped).
  closingContraVoucherId Int? // null when toVaultPaise = 0
  // Vestigial — now carries the SPINE id of the variance posting (JournalEntry dropped, G5).
  varianceJournalEntryId Int?

  // ── Handover chain ────────────────────────────────────────────────────────
  // Set when A's AWAITING_HANDOVER shift is accepted by B: points to B's shift.
  handoverToShiftId  Int?
  handoverToShift    PosShift?    @relation("ShiftHandover", fields: [handoverToShiftId], references: [id])
  handoverFromShifts PosShift[]   @relation("ShiftHandover")
  // The pending handover record (only exists during AWAITING_HANDOVER state).
  handover           PosHandover? @relation("HandoverFromShift")
  // If this shift was opened via handover acceptance, link back.
  receivedHandover   PosHandover? @relation("HandoverToShift")

  notes        String?
  drops        PosCashDrop[]
  expenditures PosExpenditure[]
  receipts     PosReceipt[]

  @@index([userId, status])
  @@index([branchId, openedAt])
  @@index([counterId, status])
  @@map("pos_shifts")
}

enum PosShiftStatus {
  OPEN
  AWAITING_HANDOVER
  CLOSED
}

// ── Mid-shift cash drop ───────────────────────────────────────────────────────
// Staff puts cash into the safe mid-shift to reduce drawer risk. Log only;
// no GL movement (cash is still "in the counter till" from the GL's perspective).

model PosCashDrop {
  id          Int      @id @default(autoincrement())
  shiftId     Int
  shift       PosShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  amountPaise BigInt
  droppedAt   DateTime @default(now())
  droppedById Int
  droppedBy   User     @relation("PosCashDropBy", fields: [droppedById], references: [id])
  notes       String?

  @@index([shiftId, droppedAt])
  @@map("pos_cash_drops")
}

// ── Mid-shift counter expenditure ─────────────────────────────────────────────
// Small cash expense paid OUT OF the counter drawer (tea, sundry donation,
// etc.). Unlike a cash DROP (log-only — cash stays in custody), this is real
// money leaving the business, so it posts a PAYMENT voucher
// (Dr <expense ledger> / Cr counter till) and reduces the expected drawer at
// shift close. `voucherId` links the posted PV; `expenseAccountId` is the GL
// expense ledger (an EXPENSE-group account). Plain int FKs to keep the change
// local to this model — joins are done explicitly where a name is needed.
model PosExpenditure {
  id               Int      @id @default(autoincrement())
  shiftId          Int
  shift            PosShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  amountPaise      BigInt
  description      String
  expenseAccountId Int
  voucherId        Int?     @unique
  createdById      Int
  createdAt        DateTime @default(now())

  @@index([shiftId, createdAt])
  @@map("pos_expenditures")
}

// ── Mid-shift counter receipt ─────────────────────────────────────────────────
// Cash collected from a party at the counter (the POS "Rcv" flow) — a customer
// clears credit or pays an advance. Posts a RECEIPT voucher (Dr counter till /
// Cr party AR); this row links that voucher to the shift for audit (which
// receipts a cashier took on which shift). The cash is already folded into the
// shift's cash sales via sumShiftCashSalesPaise, so this row is log/audit only.
model PosReceipt {
  id          Int      @id @default(autoincrement())
  shiftId     Int
  shift       PosShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  amountPaise BigInt
  accountId   Int // party AR ledger credited
  note        String?
  voucherId   Int?     @unique
  createdById Int
  createdAt   DateTime @default(now())

  @@index([shiftId, createdAt])
  @@map("pos_receipts")
}

// ── POS Handover (two-step cashier-to-cashier) ───────────────────────────────
// A initiates: shift → AWAITING_HANDOVER, PosHandover created (PENDING).
// A logs out, B logs in. B sees the pending handover, counts physical cash,
// and accepts. On accept (one transaction):
//   1. Variance JE posted against counter till if declared ≠ expected.
//   2. Closing Contra posted if (declared − carryOverNext) > 0 (vault sweep).
//   3. A's shift → CLOSED; B's new PosShift created (OPEN).
//   4. PosHandover → ACCEPTED.
// Any discrepancy between A's declared and B's count hits A's shift variance.

model PosHandover {
  id Int @id @default(autoincrement())

  fromShiftId Int      @unique
  fromShift   PosShift @relation("HandoverFromShift", fields: [fromShiftId], references: [id])

  toUserId Int
  toUser   User @relation("HandoverToUser", fields: [toUserId], references: [id])

  // Filled when B accepts — points to B's new shift.
  toShiftId Int?      @unique
  toShift   PosShift? @relation("HandoverToShift", fields: [toShiftId], references: [id])

  status PosHandoverStatus @default(PENDING)

  declaredByAPaise BigInt // what A declared (pre-filled from A's declared count)
  countedByBPaise  BigInt? // what B counted on acceptance
  carryOverPaise   BigInt  @default(0) // carry-over float for B's shift
  notes            String?

  initiatedAt DateTime  @default(now())
  acceptedAt  DateTime?

  @@map("pos_handovers")
}

enum PosHandoverStatus {
  PENDING
  ACCEPTED
  CANCELLED
}
