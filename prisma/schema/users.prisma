// ── Users ─────────────────────────────────────────────────────────────────────

model User {
  id                      Int                 @id @default(autoincrement())
  name                    String
  email                   String              @unique
  password                String
  // Authority is granted via Position appointments — `role` is only populated
  // when a user holds a Position whose roleTemplate matches. New users start
  // with `role = null` (no operational permissions). The canonical source for
  // effective permissions is `userPositions[].position.roleTemplate.permissions`.
  role                    String?
  title                   String?
  scope                   UserScope           @default(OWN)
  createdAt               DateTime            @default(now())
  managerId               Int?
  // public profile
  avatarUrl               String?
  coverUrl                String?
  phone                   String?
  birthday                DateTime?
  bio                     String?
  linkedIn                String?
  twitter                 String?
  instagram               String?
  facebook                String?
  ownedTickets            Ticket[]
  ticketLogs              TicketLog[]
  participantAdded        TicketParticipant[] @relation("ParticipantAddedBy")
  participantEntries      TicketParticipant[] @relation("ParticipantUser")
  manager                 User?               @relation("UserHierarchy", fields: [managerId], references: [id])
  reports                 User[]              @relation("UserHierarchy")
  userRole                Role?               @relation(fields: [role], references: [id])
  journalEntries          JournalEntry[]      @relation("JournalCreatedBy")
  journalEntriesCancelled JournalEntry[]      @relation("JournalCancelledBy")
  journalEntriesDeleted   JournalEntry[]      @relation("JournalDeletedBy")
  journalEntryAudits      JournalEntryAudit[] @relation("JournalAuditActor")
  vouchers                Voucher[]           @relation("VoucherCreatedBy")
  vouchersCancelled       Voucher[]           @relation("VoucherCancelledBy")
  vouchersDeleted         Voucher[]           @relation("VoucherDeletedBy")
  voucherAudits           VoucherAudit[]      @relation("VoucherAuditActor")
  voucherAllocations      VoucherAllocation[] @relation("VoucherAllocationCreatedBy")
  invVouchers             InvVoucher[]        @relation("InvVoucherCreatedBy")
  invVouchersCancelled    InvVoucher[]        @relation("InvVoucherCancelledBy")
  invVouchersDeleted      InvVoucher[]        @relation("InvVoucherDeletedBy")
  invVoucherAudits        InvVoucherAudit[]   @relation("InvVoucherAuditActor")
  ownedChatRooms          ChatRoom[]          @relation("OwnedChatRooms")
  chatRoomMembers         ChatRoomMember[]
  chatMessages            ChatMessage[]
  wallPosts               WallPost[]          @relation("WallPosts")
  authoredPosts           WallPost[]          @relation("AuthoredPosts")
  userPositions           UserPosition[]
  userPermissions         UserPermission[]
  // POS shift relations
  posShifts               PosShift[]          @relation("PosShiftUser")
  posShiftsOpenedBy       PosShift[]          @relation("PosShiftOpenedBy")
  posShiftsClosedBy       PosShift[]          @relation("PosShiftClosedBy")
  posCashDrops            PosCashDrop[]       @relation("PosCashDropBy")
  handoversReceived       PosHandover[]       @relation("HandoverToUser")
  quickNotes              QuickNote[]
  loyaltyLedgerEntries    LoyaltyLedger[]     @relation("LoyaltyLedgerCreatedBy")
  couponsCreated          Coupon[]            @relation("CouponCreatedBy")
  giftCardsCreated        GiftCard[]          @relation("GiftCardCreatedBy")
  giftCardTxnsCreated     GiftCardTxn[]       @relation("GiftCardTxnCreatedBy")
  additionalCostAllocationsCreated AdditionalCostAllocation[] @relation("AdditionalCostAllocationCreatedBy")
}

// ── QuickNote — per-user scratch pad ──────────────────────────────────────

model QuickNote {
  id        Int      @id @default(autoincrement())
  userId    Int
  text      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
