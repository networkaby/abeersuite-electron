// ── Users ─────────────────────────────────────────────────────────────────────

model User {
  id                 Int                 @id @default(autoincrement())
  name               String
  email              String              @unique
  password           String
  role               String              @default("R2")
  title              String?
  scope              UserScope           @default(OWN)
  createdAt          DateTime            @default(now())
  managerId          Int?
  // public profile
  avatarUrl          String?
  coverUrl           String?
  phone              String?
  birthday           DateTime?
  bio                String?
  linkedIn           String?
  twitter            String?
  instagram          String?
  facebook           String?
  ownedTickets       Ticket[]
  ticketLogs         TicketLog[]
  participantAdded   TicketParticipant[] @relation("ParticipantAddedBy")
  participantEntries TicketParticipant[] @relation("ParticipantUser")
  manager            User?               @relation("UserHierarchy", fields: [managerId], references: [id])
  reports            User[]              @relation("UserHierarchy")
  userRole           Role                @relation(fields: [role], references: [id])
  departments        Department[]
  branches           Branch[]
  journalEntries     JournalEntry[]      @relation("JournalCreatedBy")
  journalEntriesVoided  JournalEntry[]   @relation("JournalVoidedBy")
  journalEntriesDeleted JournalEntry[]   @relation("JournalDeletedBy")
  journalEntryAudits    JournalEntryAudit[] @relation("JournalAuditActor")
  invoices           Invoice[]           @relation("InvoiceCreatedBy")
  payments           Payment[]           @relation("PaymentCreatedBy")
  invVouchers        InvVoucher[]        @relation("InvVoucherCreatedBy")
  ownedChatRooms     ChatRoom[]          @relation("OwnedChatRooms")
  chatRoomMembers    ChatRoomMember[]
  chatMessages       ChatMessage[]
  wallPosts          WallPost[]          @relation("WallPosts")
  authoredPosts      WallPost[]          @relation("AuthoredPosts")
  posts              UserPost[]
  userPermissions    UserPermission[]
  crmLeadsOwned      CrmLead[]          @relation("CrmLeadOwner")
  crmLeadsCreated    CrmLead[]          @relation("CrmLeadCreatedBy")
}
