// ── Users ─────────────────────────────────────────────────────────────────────

model User {
  id                               Int                        @id @default(autoincrement())
  name                             String
  email                            String                     @unique
  password                         String
  // Authority is granted via Position appointments — `role` is only populated
  // when a user holds a Position whose role templates match. New users start
  // with `role = null` (no operational permissions). The canonical source for
  // effective permissions is `userPositions[].position.roleTemplates[].role.permissions`.
  role                             String?
  title                            String?
  scope                            UserScope                  @default(OWN)
  createdAt                        DateTime                   @default(now())
  /// Lets the Day Book's local cache delta-sync creator NAMES — a rename writes
  /// User, never the vouchers the name is shown on. See Branch.updatedAt.
  updatedAt                        DateTime                   @default(now()) @updatedAt
  /// Server-side session revocation. Any JWT whose login time is BEFORE this
  /// instant is rejected by the auth `jwt` callback. Bumped on sign-out (= log
  /// out of every tab/device at once) and available for password-change / admin
  /// force-logout later. null = never revoked.
  tokensValidFrom                  DateTime?
  managerId                        Int?
  // public profile
  avatarUrl                        String?
  coverUrl                         String?
  phone                            String?
  birthday                         DateTime?
  bio                              String?
  linkedIn                         String?
  twitter                          String?
  instagram                        String?
  facebook                         String?
  participantAdded                 TicketParticipant[]        @relation("ParticipantAddedBy")
  participantEntries               TicketParticipant[]        @relation("ParticipantUser")
  manager                          User?                      @relation("UserHierarchy", fields: [managerId], references: [id])
  reports                          User[]                     @relation("UserHierarchy")
  userRole                         Role?                      @relation(fields: [role], references: [id])
  voucherAllocations               VoucherAllocation[]        @relation("VoucherAllocationCreatedBy")
  // Phase 5 5D-2/5D-3: InvVoucher createdBy + cancelledBy/deletedBy dropped —
  // creator + lifecycle metadata live on the spine (UniversalVoucher).
  auditLogs                        AuditLog[]                 @relation("AuditLogActor")
  auditLogsRestored                AuditLog[]                 @relation("AuditLogRestoredBy")
  ownedChatRooms                   ChatRoom[]                 @relation("OwnedChatRooms")
  chatRoomMembers                  ChatRoomMember[]
  chatMessages                     ChatMessage[]
  // WallPost owner/author are now FK-free polymorphic (SocialActor USER|PERSON);
  // resolved via socialActor.ts, so no back-relation here.
  userPositions                    UserPosition[]
  userPermissions                  UserPermission[]
  // POS shift relations
  posShifts                        PosShift[]                 @relation("PosShiftUser")
  posShiftsOpenedBy                PosShift[]                 @relation("PosShiftOpenedBy")
  posShiftsClosedBy                PosShift[]                 @relation("PosShiftClosedBy")
  posCashDrops                     PosCashDrop[]              @relation("PosCashDropBy")
  counterPins                      UserCounterPin[]           @relation("UserCounterPins")
  handoversReceived                PosHandover[]              @relation("HandoverToUser")
  quickNotes                       QuickNote[]
  savedFilters                     SavedFilter[]              @relation("UserSavedFilters")
  loyaltyLedgerEntries             LoyaltyLedger[]            @relation("LoyaltyLedgerCreatedBy")
  couponsCreated                   Coupon[]                   @relation("CouponCreatedBy")
  giftCardsCreated                 GiftCard[]                 @relation("GiftCardCreatedBy")
  giftCardTxnsCreated              GiftCardTxn[]              @relation("GiftCardTxnCreatedBy")
  additionalCostAllocationsCreated AdditionalCostAllocation[] @relation("AdditionalCostAllocationCreatedBy")
  ledgersReconciled                Account[]                  @relation("AccountReconciledBy")
  bankStatementImports             BankStatementImport[]      @relation("BankStatementImportedBy")
  bankStatementMatches             BankStatementMatch[]       @relation("BankStatementMatchCreatedBy")
  surfacesSeen                     UserSurfaceSeen[]
  // HR & People — the employment record of this staff member (hr.prisma).
  staffProfile                     StaffProfile?
  attendanceDays                   AttendanceDay[]            @relation("AttendanceUser")
  leaveRequests                    LeaveRequest[]             @relation("LeaveUser")
}

// ── UserSurfaceSeen — per-user "I have looked at this list" markers ───────────
// Drives the `new` half of every sidebar count badge: anything arriving after
// `seenAt` is new to THIS user. One row per user per surface (`surface` keyed the
// same generic way as SavedFilter), so a new badge needs a registry entry, not a
// new column on User. No row yet = never looked, so everything counts as new.
model UserSurfaceSeen {
  userId  Int
  surface String
  seenAt  DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, surface])
}

// ── QuickNote — per-user scratch pad ──────────────────────────────────────

model QuickNote {
  id        Int      @id @default(autoincrement())
  userId    Int
  text      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── SavedFilter — a named, reusable list filter (Zoho-style saved view) ──────
// Generic on `surface` (e.g. "reconnect") so any list can reuse it; `payload` is
// the surface-specific filter criteria (JSON). Personal to its owner unless
// `isShared`, which exposes it to all staff on that surface.
model SavedFilter {
  id          Int      @id @default(autoincrement())
  surface     String
  name        String
  ownerUserId Int
  owner       User     @relation("UserSavedFilters", fields: [ownerUserId], references: [id], onDelete: Cascade)
  isShared    Boolean  @default(false)
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([surface, ownerUserId])
  @@index([surface, isShared])
}
