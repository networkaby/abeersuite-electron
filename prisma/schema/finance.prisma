// ── Finance Module ─────────────────────────────────────────────────────────────
// GlAccount is unified into Account (see accounts.prisma).
// Customer/Company references on Invoice use loose partyType + partyId (no FK).

model JournalEntry {
  id                Int           @id @default(autoincrement())
  date              DateTime      @db.Date
  reference         String        @unique
  description       String
  status            VoucherStatus @default(DRAFT)
  postedAt          DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  cancelledById     Int?
  deletedAt         DateTime?
  deletedById       Int?
  deleteReason      String?
  createdById       Int
  createdBy         User          @relation("JournalCreatedBy", fields: [createdById], references: [id])
  cancelledBy       User?         @relation("JournalCancelledBy", fields: [cancelledById], references: [id])
  deletedBy         User?         @relation("JournalDeletedBy", fields: [deletedById], references: [id])
  lines             JournalLine[]
  // POS shift variance adjustment JEs link back here
  posShiftVariances PosShift[]    @relation("PosShiftVarianceJe")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, date])
  @@index([date])
  @@index([deletedAt])
}

// Snapshot of hard-deleted journal entries. Created in the same transaction as the
// physical row deletion so the deletion itself is traceable (who/when/why + full data).
model JournalEntryAudit {
  id          Int      @id @default(autoincrement())
  originalId  Int
  originalRef String
  action      String
  reason      String?
  snapshot    Json
  actorId     Int
  actor       User     @relation("JournalAuditActor", fields: [actorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([originalId])
  @@index([actorId])
  @@index([createdAt])
}

model JournalLine {
  id             Int          @id @default(autoincrement())
  journalEntryId Int
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      Int
  account        Account      @relation(fields: [accountId], references: [id])
  type           EntryType
  amount         Decimal      @db.Decimal(14, 2)
  description    String?

  @@index([accountId])
  @@index([accountId, journalEntryId])
}

model Invoice {
  id          Int           @id @default(autoincrement())
  number      String        @unique
  // InvoiceStatus tracks workflow + payment progress (DRAFT/SENT/PARTIAL/PAID/VOID).
  // VOID is treated as the cancel-tier sentinel for invoices; cancelledAt below
  // captures the metadata in the same shape as other voucher types so the
  // shared lifecycle helpers in src/modules/tally/lib/voucherLifecycle.ts can
  // operate uniformly across Invoice, Payment, InvVoucher, and Voucher.
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime      @db.Date
  dueDate     DateTime      @db.Date
  notes       String?
  // Primary GL link — account name derived from account.customer?.name ?? account.company?.name
  accountId   Int?
  // Linked shop order — null for direct walk-in invoices
  shopOrderId Int?          @unique
  // Linked repair ticket — soft back-link so reports can find "all invoices for ticket #N"
  // and "tickets without an invoice." Replaced the deprecated TicketPart model 2026-05-07.
  ticketId    Int?
  // Legacy loose-party fields — nullable; kept for old invoices created before accountId
  partyName   String?
  partyType   String?
  partyId     Int?
  subtotal    Decimal       @db.Decimal(14, 2)
  taxAmount   Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount Decimal       @db.Decimal(14, 2)
  amountPaid  Decimal       @default(0) @db.Decimal(14, 2)
  createdById Int

  // ── Lifecycle metadata (Cancel / Delete / Hard Delete) ──────────────────
  cancelledAt   DateTime?
  cancelledById Int?
  cancelReason  String?
  deletedAt     DateTime?
  deletedById   Int?
  deleteReason  String?

  createdBy   User       @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  cancelledBy User?      @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id])
  deletedBy   User?      @relation("InvoiceDeletedBy", fields: [deletedById], references: [id])
  account     Account?   @relation("AccountInvoices", fields: [accountId], references: [id])
  shopOrder   ShopOrder? @relation("OrderInvoice", fields: [shopOrderId], references: [id], onDelete: SetNull)
  ticket      Ticket?    @relation("TicketInvoices", fields: [ticketId], references: [id], onDelete: SetNull)
  // Credit note back-link — set when this invoice is a return of another invoice.
  returnOfId  Int?
  returnOf    Invoice?   @relation("InvoiceReturns", fields: [returnOfId], references: [id])
  returns     Invoice[]  @relation("InvoiceReturns")

  lines     InvoiceLine[]
  payments  Payment[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([accountId])
  @@index([shopOrderId])
  @@index([ticketId])
  @@index([issueDate])
  @@index([deletedAt])
}

// Hard-delete snapshot for invoices (mirrors JournalEntryAudit shape).
model InvoiceAudit {
  id          Int      @id @default(autoincrement())
  originalId  Int
  originalRef String
  action      String
  reason      String?
  snapshot    Json
  actorId     Int
  actor       User     @relation("InvoiceAuditActor", fields: [actorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([originalId])
  @@index([actorId])
  @@index([createdAt])
}

model InvoiceLine {
  id          Int         @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Nullable — populated on POS sales so sale-return can locate the product for stock reversal.
  productId   Int?
  product     InvProduct? @relation("InvoiceLineProduct", fields: [productId], references: [id])
  description String
  quantity    Decimal     @db.Decimal(10, 3)
  unitPrice   Decimal     @db.Decimal(14, 2)
  taxRate     Decimal     @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal     @default(0) @db.Decimal(14, 2)
  amount      Decimal     @db.Decimal(14, 2)

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id             Int           @id @default(autoincrement())
  // invoiceId stays for legacy 1:1 payments; bill-wise allocations use
  // VoucherAllocation (free-form linking — see model below).
  invoiceId      Int
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  amount         Decimal       @db.Decimal(14, 2)
  method         PaymentMethod
  reference      String?
  date           DateTime      @db.Date
  notes          String?
  journalEntryId Int?
  createdById    Int

  // ── Voucher-style lifecycle (Cancel / Delete / Hard Delete) ─────────────
  status        VoucherStatus @default(POSTED) // payments default POSTED on creation
  postedAt      DateTime?
  cancelledAt   DateTime?
  cancelledById Int?
  cancelReason  String?
  deletedAt     DateTime?
  deletedById   Int?
  deleteReason  String?

  createdBy   User     @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  cancelledBy User?    @relation("PaymentCancelledBy", fields: [cancelledById], references: [id])
  deletedBy   User?    @relation("PaymentDeletedBy", fields: [deletedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@index([journalEntryId])
  @@index([status, date])
  @@index([deletedAt])
}

model PaymentAudit {
  id          Int      @id @default(autoincrement())
  originalId  Int
  originalRef String
  action      String
  reason      String?
  snapshot    Json
  actorId     Int
  actor       User     @relation("PaymentAuditActor", fields: [actorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([originalId])
  @@index([actorId])
  @@index([createdAt])
}

// ── Unified accounting voucher (Contra / Payment / Receipt / Credit Note / Debit Note) ───────────
// Each row's lines must sum to zero (Σ debits = Σ credits). On POST the helper
// in src/modules/tally/lib/voucherLifecycle.ts creates a JournalEntry with the
// same lines so the GL stays consistent with traditional double-entry tooling.
model Voucher {
  id             Int           @id @default(autoincrement())
  type           VoucherType
  reference      String        @unique
  date           DateTime      @db.Date
  narration      String?
  partyAccountId Int?
  totalAmount    Decimal       @db.Decimal(14, 2)
  status         VoucherStatus @default(DRAFT)
  postedAt       DateTime?
  // Counter-entry created on POST — lets reports tie back to GL.
  journalEntryId Int?
  createdById    Int

  // ── Lifecycle metadata ──────────────────────────────────────────────────
  cancelledAt   DateTime?
  cancelledById Int?
  cancelReason  String?
  deletedAt     DateTime?
  deletedById   Int?
  deleteReason  String?

  partyAccount     Account?      @relation("VoucherPartyAccount", fields: [partyAccountId], references: [id])
  createdBy        User          @relation("VoucherCreatedBy", fields: [createdById], references: [id])
  cancelledBy      User?         @relation("VoucherCancelledBy", fields: [cancelledById], references: [id])
  deletedBy        User?         @relation("VoucherDeletedBy", fields: [deletedById], references: [id])
  lines            VoucherLine[]
  // POS shift back-relations (Contra vouchers posted on shift open / close)
  posShiftOpenings PosShift[]    @relation("PosShiftOpeningContra")
  posShiftClosings PosShift[]    @relation("PosShiftClosingContra")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([type, status])
  @@index([date])
  @@index([deletedAt])
  @@index([partyAccountId])
}

model VoucherLine {
  id          Int       @id @default(autoincrement())
  voucherId   Int
  voucher     Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  accountId   Int
  account     Account   @relation(fields: [accountId], references: [id])
  type        EntryType
  amount      Decimal   @db.Decimal(14, 2)
  description String?

  @@index([voucherId])
  @@index([accountId])
}

model VoucherAudit {
  id          Int      @id @default(autoincrement())
  originalId  Int
  originalRef String
  action      String
  reason      String?
  snapshot    Json
  actorId     Int
  actor       User     @relation("VoucherAuditActor", fields: [actorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([originalId])
  @@index([actorId])
  @@index([createdAt])
}

// ── Bill-wise allocation (free-form linking) ─────────────────────────────
// Polymorphic: any voucher (target) can be settled by any other voucher (source),
// fully or partially, now or later. AllocationMethod mirrors Tally's four modes:
// New Ref / Against Ref / Advance / On Account.
model VoucherAllocation {
  id          Int                  @id @default(autoincrement())
  targetType  AllocationTargetType
  targetId    Int
  sourceType  AllocationSourceType
  sourceId    Int
  amount      Decimal              @db.Decimal(14, 2)
  method      AllocationMethod
  reference   String?
  createdById Int
  createdBy   User                 @relation("VoucherAllocationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())

  @@index([targetType, targetId])
  @@index([sourceType, sourceId])
  @@index([method])
}

// ── Voucher Series (numbering configuration per voucher kind) ─────────────
// Reference is assembled from configurable parts (type/user/year/number) joined
// by a separator. On the next voucher creation past `yearClosingDate`, the year
// part rolls forward and `nextSeq` resets to 0 automatically.
//
// Reference = parts in `partOrder` (subset of: type,user,year,number) joined by `separator`.
//   type   → typeValue (truncated to typeMaxWidth)
//   user   → creator's User.id (zero-padded to userMaxWidth)
//   year   → fiscal year derived from fyStartYear, formatted per yearFormat
//   number → startFrom + nextSeq - 1 (zero-padded to padWidth)
// Singleton org-level configuration. The book-restart day is shared by every
// voucher series so a single year-end change rolls the whole business forward.
model BooksConfig {
  id           Int      @id @default(1) // singleton — always row id=1
  restartMonth Int      @default(4) // 1-12; default April (Indian FY)
  restartDay   Int      @default(1) // 1-31; default 1
  updatedAt    DateTime @updatedAt
}

model VoucherSeries {
  // Values: CONTRA | PAYMENT | RECEIPT | CREDIT_NOTE | DEBIT_NOTE | INVOICE | JOURNAL
  kind  String @id
  label String

  // Per-series fiscal year tracker. The closing date is derived from
  // BooksConfig.restartMonth/restartDay + this year. Rollover happens
  // automatically when today >= next restart date.
  fyStartYear Int? // e.g. 2026 = FY Apr-2026 → Mar-2027

  // Type part (voucher type code, used as-is — keep it short)
  typeEnabled Boolean @default(true)
  typeValue   String  @default("")

  // User part (creator's user ID)
  userEnabled  Boolean @default(false)
  userMaxWidth Int     @default(3)

  // Year part
  yearEnabled Boolean @default(true)
  // CALENDAR (2026) | CALENDAR_SHORT (26) | FY_SHORT (26-27) | FY_LONG (2026-27)
  yearFormat  String  @default("FY_SHORT")

  // Number part (always part of the reference — it's the actual counter)
  startFrom Int @default(1)
  padWidth  Int @default(4)
  nextSeq   Int @default(0)

  // Assembly: comma-separated list of parts. Reserved tokens — type, user,
  // year, number — expand to their values. Anything else is a literal,
  // letting the admin embed separators or text inline. Examples:
  //   "type,/,year,-,number"     →  INV/26-27-0001
  //   "type,number,-,user"       →  INV0001-007
  //   "type,/,year,/,user,number"→  INV/26-27/0070001
  partOrder String @default("type,-,year,-,number")

  updatedAt DateTime @updatedAt
}
