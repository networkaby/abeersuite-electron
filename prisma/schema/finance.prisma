// ── Finance Module ─────────────────────────────────────────────────────────────
// GlAccount is unified into Account (see accounts.prisma).
// Customer/Company references on Invoice use loose partyType + partyId (no FK).

model JournalEntry {
  id            Int           @id @default(autoincrement())
  date          DateTime      @db.Date
  reference     String        @unique
  description   String
  status        VoucherStatus @default(DRAFT)
  postedAt      DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById Int?
  deletedAt     DateTime?
  deletedById   Int?
  deleteReason  String?
  createdById   Int
  createdBy     User          @relation("JournalCreatedBy", fields: [createdById], references: [id])
  cancelledBy   User?         @relation("JournalCancelledBy", fields: [cancelledById], references: [id])
  deletedBy     User?         @relation("JournalDeletedBy", fields: [deletedById], references: [id])
  lines         JournalLine[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, date])
  @@index([date])
  @@index([deletedAt])
}

// Snapshot of hard-deleted journal entries. Created in the same transaction as the
// physical row deletion so the deletion itself is traceable (who/when/why + full data).
model JournalEntryAudit {
  id          Int      @id @default(autoincrement())
  originalId  Int
  originalRef String
  action      String
  reason      String?
  snapshot    Json
  actorId     Int
  actor       User     @relation("JournalAuditActor", fields: [actorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([originalId])
  @@index([actorId])
  @@index([createdAt])
}

model JournalLine {
  id             Int          @id @default(autoincrement())
  journalEntryId Int
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      Int
  account        Account      @relation(fields: [accountId], references: [id])
  type           EntryType
  amount         Decimal      @db.Decimal(14, 2)
  description    String?

  @@index([accountId])
  @@index([accountId, journalEntryId])
}

model Invoice {
  id          Int           @id @default(autoincrement())
  number      String        @unique
  // InvoiceStatus tracks workflow + payment progress (DRAFT/SENT/PARTIAL/PAID/VOID).
  // VOID is treated as the cancel-tier sentinel for invoices; cancelledAt below
  // captures the metadata in the same shape as other voucher types so the
  // shared lifecycle helpers in src/modules/tally/lib/voucherLifecycle.ts can
  // operate uniformly across Invoice, Payment, InvVoucher, and Voucher.
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime      @db.Date
  dueDate     DateTime      @db.Date
  notes       String?
  // Primary GL link — account name derived from account.customer?.name ?? account.company?.name
  accountId   Int?
  // Linked shop order — null for direct walk-in invoices
  shopOrderId Int?          @unique
  // Linked repair ticket — soft back-link so reports can find "all invoices for ticket #N"
  // and "tickets without an invoice." Replaced the deprecated TicketPart model 2026-05-07.
  ticketId    Int?
  // Legacy loose-party fields — nullable; kept for old invoices created before accountId
  partyName   String?
  partyType   String?
  partyId     Int?
  subtotal    Decimal       @db.Decimal(14, 2)
  taxAmount   Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount Decimal       @db.Decimal(14, 2)
  amountPaid  Decimal       @default(0) @db.Decimal(14, 2)
  createdById Int

  // ── Lifecycle metadata (Cancel / Delete / Hard Delete) ──────────────────
  cancelledAt   DateTime?
  cancelledById Int?
  cancelReason  String?
  deletedAt     DateTime?
  deletedById   Int?
  deleteReason  String?

  createdBy   User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  cancelledBy User?         @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id])
  deletedBy   User?         @relation("InvoiceDeletedBy", fields: [deletedById], references: [id])
  account     Account?      @relation("AccountInvoices", fields: [accountId], references: [id])
  shopOrder   ShopOrder?    @relation("OrderInvoice", fields: [shopOrderId], references: [id], onDelete: SetNull)
  ticket      Ticket?       @relation("TicketInvoices", fields: [ticketId], references: [id], onDelete: SetNull)
  lines       InvoiceLine[]
  payments    Payment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([accountId])
  @@index([shopOrderId])
  @@index([ticketId])
  @@index([issueDate])
  @@index([deletedAt])
}

// Hard-delete snapshot for invoices (mirrors JournalEntryAudit shape).
model InvoiceAudit {
  id          Int      @id @default(autoincrement())
  originalId  Int
  originalRef String
  action      String
  reason      String?
  snapshot    Json
  actorId     Int
  actor       User     @relation("InvoiceAuditActor", fields: [actorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([originalId])
  @@index([actorId])
  @@index([createdAt])
}

model InvoiceLine {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)

  @@index([invoiceId])
}

model Payment {
  id             Int           @id @default(autoincrement())
  // invoiceId stays for legacy 1:1 payments; bill-wise allocations use
  // VoucherAllocation (free-form linking — see model below).
  invoiceId      Int
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  amount         Decimal       @db.Decimal(14, 2)
  method         PaymentMethod
  reference      String?
  date           DateTime      @db.Date
  notes          String?
  journalEntryId Int?
  createdById    Int

  // ── Voucher-style lifecycle (Cancel / Delete / Hard Delete) ─────────────
  status        VoucherStatus @default(POSTED) // payments default POSTED on creation
  postedAt      DateTime?
  cancelledAt   DateTime?
  cancelledById Int?
  cancelReason  String?
  deletedAt     DateTime?
  deletedById   Int?
  deleteReason  String?

  createdBy   User     @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  cancelledBy User?    @relation("PaymentCancelledBy", fields: [cancelledById], references: [id])
  deletedBy   User?    @relation("PaymentDeletedBy", fields: [deletedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@index([journalEntryId])
  @@index([status, date])
  @@index([deletedAt])
}

model PaymentAudit {
  id          Int      @id @default(autoincrement())
  originalId  Int
  originalRef String
  action      String
  reason      String?
  snapshot    Json
  actorId     Int
  actor       User     @relation("PaymentAuditActor", fields: [actorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([originalId])
  @@index([actorId])
  @@index([createdAt])
}

// ── Unified accounting voucher (Contra / Payment / Receipt / Credit Note / Debit Note) ───────────
// Each row's lines must sum to zero (Σ debits = Σ credits). On POST the helper
// in src/modules/tally/lib/voucherLifecycle.ts creates a JournalEntry with the
// same lines so the GL stays consistent with traditional double-entry tooling.
model Voucher {
  id             Int           @id @default(autoincrement())
  type           VoucherType
  reference      String        @unique
  date           DateTime      @db.Date
  narration      String?
  partyAccountId Int?
  totalAmount    Decimal       @db.Decimal(14, 2)
  status         VoucherStatus @default(DRAFT)
  postedAt       DateTime?
  // Counter-entry created on POST — lets reports tie back to GL.
  journalEntryId Int?
  createdById    Int

  // ── Lifecycle metadata ──────────────────────────────────────────────────
  cancelledAt   DateTime?
  cancelledById Int?
  cancelReason  String?
  deletedAt     DateTime?
  deletedById   Int?
  deleteReason  String?

  partyAccount Account?      @relation("VoucherPartyAccount", fields: [partyAccountId], references: [id])
  createdBy    User          @relation("VoucherCreatedBy", fields: [createdById], references: [id])
  cancelledBy  User?         @relation("VoucherCancelledBy", fields: [cancelledById], references: [id])
  deletedBy    User?         @relation("VoucherDeletedBy", fields: [deletedById], references: [id])
  lines        VoucherLine[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([type, status])
  @@index([date])
  @@index([deletedAt])
  @@index([partyAccountId])
}

model VoucherLine {
  id          Int       @id @default(autoincrement())
  voucherId   Int
  voucher     Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  accountId   Int
  account     Account   @relation(fields: [accountId], references: [id])
  type        EntryType
  amount      Decimal   @db.Decimal(14, 2)
  description String?

  @@index([voucherId])
  @@index([accountId])
}

model VoucherAudit {
  id          Int      @id @default(autoincrement())
  originalId  Int
  originalRef String
  action      String
  reason      String?
  snapshot    Json
  actorId     Int
  actor       User     @relation("VoucherAuditActor", fields: [actorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([originalId])
  @@index([actorId])
  @@index([createdAt])
}

// ── Bill-wise allocation (free-form linking) ─────────────────────────────
// Polymorphic: any voucher (target) can be settled by any other voucher (source),
// fully or partially, now or later. AllocationMethod mirrors Tally's four modes:
// New Ref / Against Ref / Advance / On Account.
model VoucherAllocation {
  id          Int                  @id @default(autoincrement())
  targetType  AllocationTargetType
  targetId    Int
  sourceType  AllocationSourceType
  sourceId    Int
  amount      Decimal              @db.Decimal(14, 2)
  method      AllocationMethod
  reference   String?
  createdById Int
  createdBy   User                 @relation("VoucherAllocationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())

  @@index([targetType, targetId])
  @@index([sourceType, sourceId])
  @@index([method])
}

// ── Voucher Series (numbering configuration per voucher kind) ─────────────
// One row per kind. Admins configure prefix/suffix/startFrom/padWidth here.
// At year-end: update suffix (e.g. /24-25 → /25-26) and reset nextSeq to 0.
// Reference formula: prefix + padStart(startFrom + nextSeq - 1, padWidth) + suffix
// where nextSeq is the post-increment value from an atomic UPDATE in $transaction.
model VoucherSeries {
  // Values: CONTRA | PAYMENT | RECEIPT | CREDIT_NOTE | DEBIT_NOTE | INVOICE | JOURNAL
  kind      String   @id
  label     String
  prefix    String   @default("")
  suffix    String   @default("")
  startFrom Int      @default(1)
  padWidth  Int      @default(4)
  nextSeq   Int      @default(0)
  updatedAt DateTime @updatedAt
}
