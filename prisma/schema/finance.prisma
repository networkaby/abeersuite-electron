// ── Finance Module ─────────────────────────────────────────────────────────────
// GlAccount is unified into Account (see accounts.prisma).
//
// The legacy Invoice / InvoiceLine / InvoiceAudit / Payment / PaymentAudit
// models were retired on 2026-05-24 (Layer 5 of the Invoice → InvVoucher
// consolidation). Sales / purchases / POS now live on InvVoucher
// (inventory.prisma); customer receipts are Voucher type=RECEIPT with a
// VoucherAllocation tying them to the InvVoucher's JournalEntry.

// Phase 4 G5 (2026-06-27): `JournalEntry` + `JournalLine` were DROPPED — the
// universal-voucher spine (`UniversalVoucher` + `VoucherGlLine`) is now the sole
// GL. The engine writes only the spine; `journalEntryId` / `sourceJournalEntryId`
// columns are kept as vestigial ints carrying the SPINE id (self-reference).

// Unified audit / recycle-bin for every hard-deleted entity (vouchers + journal
// entries). One row per removed entity, discriminated by `entityType`, with the
// full JSON snapshot needed to restore it. Written in the same transaction as the
// physical row deletion so the deletion is traceable (who/when/why + data) AND
// recoverable. Replaced the 3 byte-identical InvVoucherAudit/VoucherAudit/
// JournalEntryAudit tables (2026-06-09). `restoredAt` is stamped when an entry is
// rebuilt from its snapshot via the recycle-bin restore.
model AuditLog {
  id           Int       @id @default(autoincrement())
  entityType   String // "INV_VOUCHER" | "GL_VOUCHER" | "JOURNAL_ENTRY"
  subtype      String? // the removed voucher's concrete type (e.g. POS_ESTIMATE, SALE, PAYMENT) for a readable label; null for journal entries
  originalId   Int
  originalRef  String
  action       String
  reason       String?
  snapshot     Json
  actorId      Int
  actor        User      @relation("AuditLogActor", fields: [actorId], references: [id])
  restoredAt   DateTime?
  restoredById Int?
  restoredBy   User?     @relation("AuditLogRestoredBy", fields: [restoredById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([entityType, originalRef])
  @@index([actorId])
  @@index([createdAt])
  @@index([restoredAt])
}

// (JournalLine dropped — see the G5 note above; spine VoucherGlLine is the GL.)

// ── Unified accounting voucher (Contra / Payment / Receipt / Credit Note / Debit Note) ───────────
// Each row's lines must sum to zero (Σ debits = Σ credits). On POST the helper
// in src/modules/accountancy/lib/voucherLifecycle.ts creates a JournalEntry with the
// same lines so the GL stays consistent with traditional double-entry tooling.
// Phase 5 5E: the financial-voucher tables (Voucher + VoucherLine) are DROPPED.
// The UniversalVoucher spine + VoucherGlLine children ARE the financial voucher
// now — type/reference/date/status/lifecycle on the spine, Dr/Cr legs as
// VoucherGlLine. Financial vouchers are spine-only (no document sidecar).

// ── Phase 4: Universal Voucher (the posting spine) ───────────────────────────
// Added Stage C as a TRANSITIONAL dual-write target: `engineGlArm` writes these
// ALONGSIDE the legacy JournalEntry/JournalLine on every post. No reader uses
// them yet (Stage E cuts readers over; Stage G retires the legacy tables and
// slims InvVoucher to a 1:1 detail sidecar).
//
// Scalar/id-only (no Prisma relations on createdById/accountId/partyAccountId/
// branchId) ON PURPOSE — same pattern as AuditLog/VoucherPrintTemplate — so this
// stage touches only finance.prisma + the engine. Relations + FK constraints get
// promoted in Stage G when these become canonical. `sourceJournalEntryId` is the
// provenance back-link used by Stage D backfill reconciliation.
model UniversalVoucher {
  id                        Int                        @id @default(autoincrement())
  //uvNo                 Int                       @id @default (auto increment)  //todo: add this back in User recomendetion
  // Spans EVERY kind — VoucherType (CONTRA/PAYMENT/…), InvVoucherType (SALE/…),
  // and JOURNAL. String (not enum) so the spine isn't coupled to either enum.
  type                      String
  // Universal Voucher No (UVNo) — the spine's `id` (above) IS the universal
  // identifier; there is no separate number column. Display label = `UV-<id>`
  // via formatUvNo() (src/shared/lib/accountancy/uvNo.ts). The old `reference`
  // string (GL_POSTING ref) was dropped (Phase 5 5D-7) — it was unnecessary
  // and `GL-` wrongly implied GL-only. The word `reference` is reserved for a
  // FUTURE cross-reference column, never a number. (vocabulary.md)
  // Voucher No — the per-kind user-facing document number (SV-/PMT-/POS-/CV-…)
  // carried from the source voucher. Unique per type among posted vouchers
  // (OPENING excluded) through a partial index the B3a migration creates by
  // hand — Prisma cannot declare it, and a replica does not carry it. Keep it
  // out of any generated migration's DROP list.
  voucherNo                 String?
  // Bill key — a one-time id the POS screen makes when a new bill starts and
  // sends on every Save of that bill. Unique, so a retried Save whose first try
  // committed but lost its reply finds this row and answers "already saved"
  // instead of writing a second bill (src/app/api/pos/sale/route.ts). Null for
  // every other voucher and every older sale; Postgres lets NULLs repeat under a
  // unique index. Never shown and never edited.
  requestKey                String?                    @unique
  date                      DateTime                   @db.Date
  description               String
  narration                 String?
  // Contra deposit-slip capture — the FINAL combined breakdown of what goes to
  // the bank (not per-line; GL lines stay plain amounts). Null → not captured;
  // the printed slip falls back to blank pen-fill boxes.
  // Shape: { notes: { "500": 10, ... }, cheques: [{ no: "483920", amount: 12500 }] }
  denomJson                 Json?
  status                    VoucherStatus              @default(DRAFT)
  // Phase 5 5D-9: REGULAR (real txn: GL/stock) vs OPTIONAL (non-binding document:
  // estimate/order/quote, no GL/stock). Derived from `type` at creation.
  binding                   VoucherBinding             @default(REGULAR)
  // Phase 5 5D-12: branch where the voucher originates — PRIMARY on the spine
  // header now (moved off InvVoucher).
  //
  // REQUIRED since 2026-09-17. It was nullable on the reading that a money
  // voucher can be "org-level", but org-level was never a state anybody chose:
  // it was the working-branch picker left on "All branches", plus the POS
  // shift-close vouchers that passed no branch at all. A blank branch drops the
  // voucher out of every branch-wise report without saying so.
  //
  // Enforced twice over, on purpose. In the application: writes go through
  // `requireWritableBranchId` (which refuses "All branches") and `branchId` is a
  // required argument on every engine entry point, so the compiler catches a
  // caller that omits it. And here, in the column, so no future writer can put
  // the blanks back.
  //
  // ⚠ A counter release must ship BEFORE the deploy that carries this
  // (AGENTS.md §3). `schemaGuard.js` compares nullability, and until the release
  // carrying its directional fix reaches a till, a NOT NULL server against a
  // still-nullable replica reads as drift and halts that till's whole worker.
  branchId                  String
  branch                    Branch                     @relation("UvBranch", fields: [branchId], references: [id])
  // Source counter — the till this voucher was RAISED at. Plain int, no FK: a
  // retired counter must not erase the provenance of the vouchers it raised,
  // which an optional relation's SetNull would quietly do. Holds PosCounter.id
  // (not counterNumber) because a counter can be renumbered and the id cannot,
  // so historic rows keep pointing at the counter that actually made them.
  // Null = raised at the office. Branch is NOT stored twice — `branchId` above
  // already carries it here, and PosCounter.branchId carries it for tickets.
  // Set once, at creation, by sourceCounterId() (shared/lib/counter/sourceCounter).
  sourceCounterId           Int?
  // Source shift — the POS shift this voucher was raised ON. Plain int, no FK,
  // for the same reason as sourceCounterId above: provenance must survive the
  // shift row, and an optional relation's SetNull would quietly erase it.
  // Null = not raised on a shift (every office voucher, and any counter voucher
  // written while no shift was open). Set once, at creation, by sourceShiftId()
  // (shared/lib/counter/sourceShift) — or passed explicitly by the POS routes
  // that already know which shift they are writing for.
  //
  // This column REPLACED the old pos_receipts / pos_expenditures side tables.
  // Those held a copy of the voucher (amount, account, note, creator, time) whose
  // only non-duplicate column was the shift link, and because the link lived
  // outside the voucher, deleting a voucher left the POS row behind as an orphan.
  // The shift link belongs on the voucher: one row, one lifecycle.
  sourceShiftId             Int?
  partyAccountId            Int?
  postedAt                  DateTime?
  cancelledAt               DateTime?
  cancelledById             Int?
  cancelReason              String?
  // deletedAt / deletedById / deleteReason dropped in B3b (2026-10-01): soft-delete
  // was retired 2026-08-01 and nothing wrote them since — a delete is a hard delete
  // with an AuditLog snapshot (Recycle Bin).
  createdById               Int
  // Phase 4 G5 groundwork: faithful transaction wall-clock (= the source
  // voucher's posting time). Lets intra-day windowed readers (POS shift
  // reconciliation) move off Voucher.createdAt onto the spine before the drop —
  // `createdAt` alone is backfill-time for historical rows, so it can't window.
  sourceCreatedAt           DateTime?
  // Phase 5 5D-16: the vestigial `sourceJournalEntryId` self-ref (= this row's own
  // `id` since G5 dropped JournalEntry) is removed — callers key by `id` directly.
  lines                     VoucherGlLine[]
  // Phase 4 G4d: direct 1:1 sidecar (the document/print detail).
  voucherDetail             VoucherDetail?             @relation("InvVoucherSpine")
  // Phase 5 5A: cross-module workflow links (loose, FK-free — see VoucherLink).
  links                     VoucherLink[]              @relation("VoucherLinks")
  // Phase 5 5C: inventory children re-homed onto the spine (dual-written; sole
  // parent once InvVoucher.voucherId is dropped in 5C-3).
  inventoryLines            VoucherInventoryLine[]     @relation("SpineInventoryLines")
  stockLedger               InvStockLedger[]           @relation("SpineStockLedger")
  // Phase 5 5B: loyalty / coupon / gift-card / cost-pool satellites anchored on the
  // spine (the document), re-pointed off InvVoucher.
  loyaltyLots               LoyaltyLot[]               @relation("SpineLoyaltyLots")
  loyaltyLedger             LoyaltyLedger[]            @relation("SpineLoyaltyLedger")
  loyaltyMilestoneAwards    LoyaltyMilestoneAward[]    @relation("SpineLoyaltyMilestoneAwards")
  couponRedemptions         CouponRedemption[]         @relation("SpineCouponRedemptions")
  giftCardTxns              GiftCardTxn[]              @relation("SpineGiftCardTxns")
  additionalCostAllocations AdditionalCostAllocation[] @relation("SpineAdditionalCostAllocations")
  // Payroll runs posted as this voucher. SetNull on the other side: deleting
  // a journal breaks the run's pointer, it never deletes the run.
  payrollRuns               PayrollRun[]               @relation("PayrollVoucher")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([status, date])
  @@index([date])
  @@index([type, status])
  @@index([partyAccountId])
  @@index([branchId])
  // "Only this counter" on the POS register filters on this alone.
  @@index([sourceCounterId])
  // Everything a shift did — the Payment/Receipt tab, the shift close tally and
  // the shift report all filter on this alone.
  @@index([sourceShiftId])
  // Poll-and-skip: the finance top bar asks "any voucher touched since <ts>?" on
  // every tick. Without this the common answer (no) costs a full table scan,
  // because proving no row matches means visiting all of them.
  @@index([updatedAt])
}

model VoucherGlLine {
  id                 Int              @id @default(autoincrement())
  universalVoucherId Int
  universalVoucher   UniversalVoucher @relation(fields: [universalVoucherId], references: [id], onDelete: Cascade)
  accountId          Int
  type               EntryType
  amount             Decimal          @db.Decimal(14, 2)
  description        String?
  // No per-line branchId: a line belongs to its voucher's branch (UniversalVoucher.branchId).
  // The copy was dropped 2026-11-06 — some save paths left it blank, so the ledger
  // showed no branch where the Day Book did.

  // Phase 4 G4: self-describing line — `role` = which section of the voucher
  // form this leg belongs to (BODY/TAX/TENDER/CHARGE/…), `seq` = its ordinal
  // position. Lets the edit/display UI rebuild the form straight from the stored
  // GL lines (filter by role, sort by seq) and is the foundation for folding
  // InvVoucherTender/InvVoucherCharge into role-tagged GL lines. Nullable: only
  // the trading GL builder tags roles; generic financial legs leave role null.
  role      VoucherGlRole?
  seq       Int?
  // Phase 4 G4b: tender metadata, populated only on role=TENDER lines — the
  // display-only channel label + the UPI ref / cheque # / txn id. Folding
  // InvVoucherTender's `method`/`reference` onto the GL line is what lets that
  // table retire (the role=TENDER GL lines become the complete tender record).
  method    PaymentMethod?
  reference String?

  // Phase 4 G2: line-level twin link to the legacy JournalLine this spine line
  // mirrors — the per-line analog of UniversalVoucher.sourceJournalEntryId. Lets
  // consumers that referenced a specific posted line (the cost-pool) re-home onto
  // the spine. A PLAIN scalar (no FK into the legacy table) so G5 can drop
  // JournalLine freely; this column is dropped alongside it.
  sourceJournalLineId Int? @unique

  // Pricing-strategy additional-cost allocations that consume this posted debit
  // (re-homed off JournalLine in G2). Read-only relative to the GL.
  additionalCostAllocations AdditionalCostAllocation[]

  @@index([accountId])
  @@index([universalVoucherId])
  @@index([accountId, universalVoucherId])
}

// ── Cross-module connections (Phase 5 G…/5A) ─────────────────────────────
// A voucher's links to DISPOSABLE workflow entities (a repair ticket it was
// raised for, a CRM deal it captured, an ecommerce order, an Orders-board
// pipeline stage). Deliberately a LOOSE link, NOT a foreign key: `targetId` is a
// plain String so the protected accounting spine holds NO FK into Ticket /
// Pipeline — a workflow schema change can never touch the ledger, and the
// voucher's record of "raised for ticket 123" survives that ticket's deletion
// (workflow is disposable; the accounting fact is not). Reverse lookup
// ("which vouchers point at ticket X") via the @@index([kind, targetId]).
// String targetId spans Int Ticket ids AND cuid pipeline ids.
enum VoucherLinkKind {
  TICKET
  DEAL
  SHOP_ORDER
  ORDER_PIPELINE
  ORDER_STATUS
  // A counter advance Receipt, pointing at the order it was collected against.
  // `targetId` = the ORDER's UniversalVoucher id (as text, like every other
  // kind here). Replaced matching the old pos_receipts.note text
  // ("Advance against <ref>"), which broke whenever the order was renumbered.
  ADVANCE_FOR
}

model VoucherLink {
  id                 Int              @id @default(autoincrement())
  universalVoucherId Int
  universalVoucher   UniversalVoucher @relation("VoucherLinks", fields: [universalVoucherId], references: [id], onDelete: Cascade)
  kind               VoucherLinkKind
  targetId           String

  @@unique([universalVoucherId, kind])
  @@index([kind, targetId])
  @@index([universalVoucherId])
}

// ── Bill-wise allocation (free-form linking) ─────────────────────────────
// Polymorphic: any voucher (target) can be settled by any other voucher (source),
// fully or partially, now or later. AllocationMethod mirrors Tally's four modes:
// New Ref / Against Ref / Advance / On Account.
model VoucherAllocation {
  id          Int                  @id @default(autoincrement())
  targetType  AllocationTargetType
  targetId    Int
  sourceType  AllocationSourceType
  sourceId    Int
  amount      Decimal              @db.Decimal(14, 2)
  method      AllocationMethod
  reference   String?
  createdById Int
  createdBy   User                 @relation("VoucherAllocationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())

  // One row per pair, so linking the same two vouchers again tops the existing
  // row up instead of leaving two rows each telling half the story. Orientation
  // is normalised by the writer (the receivable side is always the target), which
  // is what turns an unordered pair into a plain ordered key.
  @@unique([targetType, targetId, sourceType, sourceId])
  @@index([targetType, targetId])
  @@index([sourceType, sourceId])
  @@index([method])
}

// ── Voucher Series (numbering configuration per voucher kind) ─────────────
// Reference is assembled from configurable parts (type/counter/year/number) joined
// by custom separators / literals. On the next voucher creation past `yearClosingDate`,
// the year part rolls forward and `nextSeq` resets to 0 automatically.
//
// Reference = parts in `partOrder` (subset of: type,counter,year,number).
//   type    → typeValue
//   counter → POS counter / workstation number (e.g. 24)
//   year    → fiscal year derived from fyStartYear, formatted per yearFormat
//   number  → startFrom + nextSeq - 1 (zero-padded to padWidth)
// Singleton org-level configuration. The book-restart day is shared by every
// voucher series so a single year-end change rolls the whole business forward.
model BooksConfig {
  id           Int      @id @default(1) // singleton — always row id=1
  restartMonth Int      @default(4) // 1-12; default April (Indian FY)
  restartDay   Int      @default(1) // 1-31; default 1

  // ── Org period anchor ────────────────────────────────────────────────────
  // The counterpart of Company.booksBeginningFrom, which is per-PARTY (a
  // customer's own books). This one is OURS: it answers "from which date have
  // we been on this software", and therefore which period still lives in the
  // old register.
  //
  // There is deliberately NO separate financialYearFrom. It would carry no
  // information: its month and day are restartMonth/restartDay above, and its
  // year is whichever financial year contains this date — so the first FY here
  // is `fyStartYearFor(restartMonth, restartDay, booksBeginningFrom)`, derived,
  // never stored twice. That holds for a mid-year migration too (books begin
  // 15 Nov, FY still starts 1 Apr — the derivation returns exactly that).
  //
  // Null on an install that has never been told, and the date rule is then
  // inert: nothing is enforced against a date nobody has stated.
  /// First day whose entries live HERE. A voucher may not be dated before it;
  /// anything earlier belongs to the previous software or manual register.
  booksBeginningFrom DateTime? @db.Date

  updatedAt    DateTime @updatedAt
}

model VoucherSeries {
  // Values: CONTRA | PAYMENT | RECEIPT | CREDIT_NOTE | DEBIT_NOTE | INVOICE | JOURNAL
  kind  String @id
  label String

  // Per-series fiscal year tracker. The closing date is derived from
  // BooksConfig.restartMonth/restartDay + this year. Rollover happens
  // automatically when today >= next restart date.
  fyStartYear Int? // e.g. 2026 = FY Apr-2026 → Mar-2027

  // Type part (voucher type code, used as-is — keep it short)
  typeEnabled Boolean @default(true)
  typeValue   String  @default("")

  // Counter part (workstation / POS counter number, e.g. 24)
  counterEnabled Boolean @default(true)

  // Year part
  yearEnabled Boolean @default(true)
  // CALENDAR (2026) | CALENDAR_SHORT (26) | FY_SHORT (26-27) | FY_SHORT_SLASH (26/27) | FY_LONG (2026-27)
  yearFormat  String  @default("FY_SHORT")

  // Number part (always part of the reference — it's the actual counter)
  startFrom Int @default(1)
  padWidth  Int @default(4)
  // The running number is per counter (VoucherSeriesCounter.nextSeq); the old
  // series-level `nextSeq` was dropped in B3b (2026-10-02).
  /// Reset generation. The office's "Reset Counter" bumps this instead of zeroing
  /// every counter's row; each counter catches up on its OWN row the next time it
  /// numbers (see VoucherSeriesCounter.resetGen), so an offline till's queued
  /// increments are never overwritten.
  resetGen  Int @default(0)

  // Assembly: comma-separated list of parts. Reserved tokens — type, counter,
  // year, number — expand to their values. Anything else is a literal,
  // letting the admin embed separators or text inline. Examples:
  //   "type,-,year,-,counter,number" →  BT-26-240001 (or 24368 for counter 24 + seq 368)
  //   "type,/,year,/,counter,number" →  INV/26-27/240001
  //   "counter,number"               →  240001
  partOrder String @default("type,-,year,-,counter,number")

  updatedAt DateTime @updatedAt

  counters VoucherSeriesCounter[]
}

/// The running number of one series on ONE counter.
///
/// `VoucherSeries` holds the format (prefix, year, padding, part order) and is the
/// office's to edit. The number itself lives here, one row per (kind, counter), so
/// that only the machine numbering on that row ever writes it: two counters that
/// shared a row would each increment from the value they last pulled and overwrite
/// each other under last-write-wins, re-issuing invoice numbers. The office numbers
/// as counter 1. The Year Ending page shows these rows, one per counter.
model VoucherSeriesCounter {
  kind          String
  counterNumber Int
  nextSeq       Int  @default(0)
  /// Per-row FY tracker, same rollover rule as the series (BooksConfig restart day).
  fyStartYear   Int?
  /// The series' resetGen this row has applied. Behind the series → the owning
  /// counter zeroes nextSeq and catches up, in the same write as the FY rollover.
  resetGen      Int  @default(0)
  updatedAt     DateTime @updatedAt

  series VoucherSeries @relation(fields: [kind], references: [kind])

  @@id([kind, counterNumber])
}

// ── Print templates ─────────────────────────────────────────────────────────
// "Print Templates" (customer-facing name) — one row per printable document.
// The `kind` PK is a plain string that's one of:
//   • VoucherType   (CONTRA | PAYMENT | RECEIPT | CREDIT_NOTE | DEBIT_NOTE | JOURNAL)
//   • InvVoucherType (PURCHASE | SALE | POS | ESTIMATE | SALE_RETURN | PURCHASE_RETURN
//                     | MANUFACTURING_JOURNAL | PHYSICAL_STOCK | BRANCH_TRANSFER | GRN
//                     | CHALLAN | REJECTION_IN | REJECTION_OUT | SALES_ORDER | PURCHASE_ORDER)
//   • Repair documents (REPAIR_TICKET | SHIPPING_SLIP) — no enum, plain ids.
// Drives the thermal 80mm receipt rendered by /receipt/invoice/[id], the shared
// <ThermalReceiptPreview>, and the repair prints (/receipt/[id], /shipping-slip).
// Bootstrap seed inserts one row per VoucherTemplateKind; reset endpoint re-applies the defaults
// from src/shared/lib/print/voucherTemplateDefaults.ts (same source). The model
// name stays VoucherPrintTemplate to avoid a table rename on the production DB.
model VoucherPrintTemplate {
  kind String @id

  // Header
  headerLine1  String @default("")
  headerLine2  String @default("")
  addressBlock String @default("")
  gstinLine    String @default("")
  phoneLine    String @default("")
  logoUrl      String @default("")

  // Body toggles — every visible element has an A4 flag (base name) and a
  // matching `…Thermal` flag, so a shop can show something on the A4 invoice
  // but hide it on the 80mm counter slip (or vice-versa). One
  // `resolveTemplateForFormat()` picks the right flag per print format.
  showLogo                 Boolean @default(false)
  showLogoThermal          Boolean @default(false)
  showHeaderText           Boolean @default(true) // brand-name line; off when the logo already shows the name
  showHeaderTextThermal    Boolean @default(true)
  showAddress              Boolean @default(true) // Head-Office (Organisation) address block
  showAddressThermal       Boolean @default(true)
  showBranchAddress        Boolean @default(false) // issuing-branch address (voucher-backed prints only)
  showBranchAddressThermal Boolean @default(false)
  showGstin                Boolean @default(true)
  showGstinThermal         Boolean @default(true)
  showPhone                Boolean @default(true)
  showPhoneThermal         Boolean @default(true)
  showTaxSummary           Boolean @default(true)
  showTaxSummaryThermal    Boolean @default(true)
  showMrp                  Boolean @default(true) // struck-through MRP on the customer price ladder (POS/SALE)
  showMrpThermal           Boolean @default(true)
  // The note typed on a goods line (serial no., colour, config) — printed
  // under the item name. On by default: a serial on the bill is the warranty.
  showLineNote             Boolean @default(true)
  showLineNoteThermal      Boolean @default(true)
  showSignature            Boolean @default(false)
  showSignatureThermal     Boolean @default(false)
  showQrCode               Boolean @default(false) // dormant (not yet rendered)
  // Scannable CODE128 of the voucher number — helps look up the original sale
  // at return time.
  showBarcode              Boolean @default(false)
  showBarcodeThermal       Boolean @default(false)
  // Shop's primary bank details (from Organisation.bankJson) — opt-in per kind
  // so customers can pay in. Off by default; admin enables where wanted.
  showBank                 Boolean @default(false)
  showBankThermal          Boolean @default(false)
  // Party's running ledger balance beside the bill's own balance-due —
  // "Previous balance" / "Closing balance". Off by default: it exposes the
  // customer's whole outstanding on a document that may be handed to anyone.
  showPartyBalance         Boolean @default(false)
  showPartyBalanceThermal  Boolean @default(false)

  // Service Shipping Label meta fields — which lines print on the label's bottom
  // strip. Device defaults OFF (naming contents invites courier theft). A4 flag
  // covers the A4/A5/A6 sheet sizes; the Thermal flag covers the 80mm roll.
  // Base flag = A4/A5/A6 sheets · Thermal = 80mm roll · Tl = Thermal Label 100×50.
  showTicket        Boolean @default(true)
  showTicketThermal Boolean @default(true)
  showTicketTl      Boolean @default(true)
  showDate          Boolean @default(true)
  showDateThermal   Boolean @default(true)
  showDateTl        Boolean @default(true)
  showRef           Boolean @default(true)
  showRefThermal    Boolean @default(true)
  showRefTl         Boolean @default(true)
  showDevice        Boolean @default(false)
  showDeviceThermal Boolean @default(false)
  showDeviceTl      Boolean @default(false)
  showFooter        Boolean @default(true)
  showFooterThermal Boolean @default(true)
  showFooterTl      Boolean @default(true)

  // Service Slip sign-off + notes. Each toggles independently, per format (A4
  // base flag + Thermal flag) like the other print elements.
  showSentBy            Boolean @default(true)
  showSentByThermal     Boolean @default(true)
  showReceivedBy        Boolean @default(true)
  showReceivedByThermal Boolean @default(true)
  showPreparedBy        Boolean @default(true)
  showPreparedByThermal Boolean @default(true)
  // The "for Service Centre use" part — findings write-area + the
  // return-with-device note — one toggle.
  showFindings          Boolean @default(true)
  showFindingsThermal   Boolean @default(true)
  // Salary slip only: the month's attendance accounted day by day under the
  // pay heads. On by default — the whole point of the section is that the
  // slip's Overtime / Hours owed figures explain themselves.
  showAttendance        Boolean @default(true)
  showAttendanceThermal Boolean @default(true)
  /// Salary slip: the commission section, head by head (A4 / thermal).
  showCommission        Boolean @default(true)
  showCommissionThermal Boolean @default(true)

  // Footer
  termsText      String @default("")
  footerLine     String @default("Thank you · Visit again")
  signatureLabel String @default("Authorised Signatory")
  // Legal boilerplate shown at the very bottom of every print (below the
  // footer line, above the barcode) — e.g. "computer generated, no signature
  // required". Blank hides it, same convention as termsText/footerLine.
  disclaimerLine String @default("This is a computer-generated document and does not require a signature.")

  // Paper — default format used when the print route doesn't pass `?paper=`.
  // Values: "A4" | "THERMAL_80MM". POS rows are seeded with "THERMAL_80MM";
  // everything else seeds with "A4" (formal tax invoice on a printer).
  defaultPaper String @default("A4")
  paperWidthMm Int    @default(80)
  fontFamily   String @default("Courier New, monospace")
  fontSizePx   Int    @default(12)

  // Audit — no FK to User to avoid relation churn; just record the id.
  updatedAt   DateTime @updatedAt
  updatedById Int?
}

// ── Bank reconciliation — the bank's statement, kept ─────────────────────────
// Three satellite tables; the posting spine is untouched. A match points at a
// VoucherGlLine by a LOOSE id (no FK), the same way VoucherAllocation and
// VoucherLink point at their targets: the ledger never carries a constraint from
// a disposable workflow table, and a voucher edited (lines rewritten) or removed
// simply leaves a match that the read path reports as `stale` and auto-match
// clears. The statement is stored rather than consumed — that is what makes a
// re-download harmless (row fingerprints), a missing row visible (running-balance
// walk) and "not in books" lines stay on screen until they are booked.

/// One upload of one bank ledger's statement.
model BankStatementImport {
  id                Int       @id @default(autoincrement())
  /// The bank ledger (Account under Bank Accounts / Bank OD A/c). Loose id.
  accountId         Int
  fileName          String
  /// sha1 of the file bytes — the same file uploaded twice is refused whole.
  fileHash          String    @db.VarChar(40)
  /// Which parser understood the file: "sbi-tsv" | "generic" | …
  profile           String
  /// Read from the statement's own header when the bank prints them; checked
  /// against the ledger's bankJson before anything is saved.
  bankAccountNumber String?
  ifsc              String?
  fromDate          DateTime? @db.Date
  toDate            DateTime? @db.Date
  openingBalance    Decimal?  @db.Decimal(14, 2)
  closingBalance    Decimal?  @db.Decimal(14, 2)
  /// Rows saved from this file.
  lineCount         Int
  /// Rows the file carried that were already saved by an earlier upload.
  skippedCount      Int       @default(0)
  /// Rows refused because they were dated before the ledger's reconciled lock.
  beforeLock        Int       @default(0)
  importedById      Int
  importedBy        User      @relation("BankStatementImportedBy", fields: [importedById], references: [id])
  createdAt         DateTime  @default(now())
  lines             BankStatementLine[]

  @@index([accountId, createdAt])
}

/// One line of a bank statement, normalised: every bank's layout lands here in
/// the same shape. `withdrawal` = money out of the bank (our CREDIT leg),
/// `deposit` = money in (our DEBIT leg).
model BankStatementLine {
  id          Int                 @id @default(autoincrement())
  importId    Int
  import      BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  /// Denormalised from the import so the reconcile read can filter by ledger and date alone.
  accountId   Int
  /// Row order inside the file.
  seq         Int
  date        DateTime            @db.Date
  narration   String
  /// Cheque no / UTR / UPI ref / IMPS no — the bank's own column when it has one,
  /// else the token pulled out of the narration.
  reference   String?
  withdrawal  Decimal?            @db.Decimal(14, 2)
  deposit     Decimal?            @db.Decimal(14, 2)
  /// Running balance after this line, when the bank prints it.
  balance     Decimal?            @db.Decimal(14, 2)
  /// sha1(accountId|date|withdrawal|deposit|balance|narration|nth) — nth is the
  /// line's index among identical rows in the same file, so two genuinely equal
  /// entries on one day survive while a re-upload of the same period is skipped.
  fingerprint String              @db.VarChar(40)
  createdAt   DateTime            @default(now())
  matches     BankStatementMatch[]

  @@unique([accountId, fingerprint])
  @@index([accountId, date])
  @@index([importId])
}

/// A statement line tied to a book entry. Many-to-many: one gateway settlement
/// can cover several receipts, one receipt can arrive as two transfers. Every
/// row written by one Match action shares a `groupId`, and both sides of a group
/// total the same — enforced by the writer, and how Unmatch undoes the whole
/// group at once.
model BankStatementMatch {
  id              Int               @id @default(autoincrement())
  groupId         String
  statementLineId Int
  statementLine   BankStatementLine @relation(fields: [statementLineId], references: [id], onDelete: Cascade)
  /// VoucherGlLine.id — loose, no FK (see the header note).
  glLineId        Int
  /// Written by auto-match rather than a person.
  auto            Boolean           @default(false)
  createdById     Int
  createdBy       User              @relation("BankStatementMatchCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())

  @@unique([statementLineId, glLineId])
  @@index([glLineId])
  @@index([groupId])
}
