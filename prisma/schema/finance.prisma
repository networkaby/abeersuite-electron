// ── Finance Module ─────────────────────────────────────────────────────────────
// GlAccount is unified into Account (see accounts.prisma).
//
// The legacy Invoice / InvoiceLine / InvoiceAudit / Payment / PaymentAudit
// models were retired on 2026-05-24 (Layer 5 of the Invoice → InvVoucher
// consolidation). Sales / purchases / POS now live on InvVoucher
// (inventory.prisma); customer receipts are Voucher type=RECEIPT with a
// VoucherAllocation tying them to the InvVoucher's JournalEntry.

model JournalEntry {
  id                Int           @id @default(autoincrement())
  date              DateTime      @db.Date
  reference         String        @unique
  description       String
  status            VoucherStatus @default(DRAFT)
  postedAt          DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  cancelledById     Int?
  deletedAt         DateTime?
  deletedById       Int?
  deleteReason      String?
  createdById       Int
  createdBy         User          @relation("JournalCreatedBy", fields: [createdById], references: [id])
  cancelledBy       User?         @relation("JournalCancelledBy", fields: [cancelledById], references: [id])
  deletedBy         User?         @relation("JournalDeletedBy", fields: [deletedById], references: [id])
  lines             JournalLine[]
  // POS shift variance adjustment JEs link back here
  posShiftVariances PosShift[]    @relation("PosShiftVarianceJe")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, date])
  @@index([date])
  @@index([deletedAt])
}

// Snapshot of hard-deleted journal entries. Created in the same transaction as the
// physical row deletion so the deletion itself is traceable (who/when/why + full data).
model JournalEntryAudit {
  id          Int      @id @default(autoincrement())
  originalId  Int
  originalRef String
  action      String
  reason      String?
  snapshot    Json
  actorId     Int
  actor       User     @relation("JournalAuditActor", fields: [actorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([originalId])
  @@index([actorId])
  @@index([createdAt])
}

model JournalLine {
  id             Int          @id @default(autoincrement())
  journalEntryId Int
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      Int
  account        Account      @relation(fields: [accountId], references: [id])
  type           EntryType
  amount         Decimal      @db.Decimal(14, 2)
  description    String?
  // Branch context where this entry was posted. Nullable for legacy entries and
  // rare org-wide adjustments. New entries stamp the active branch on POST.
  branchId       String?
  branch         Branch?      @relation("JournalLineBranch", fields: [branchId], references: [id])

  @@index([accountId])
  @@index([accountId, journalEntryId])
  @@index([branchId, accountId])
  @@index([accountId, branchId])
}

// ── Unified accounting voucher (Contra / Payment / Receipt / Credit Note / Debit Note) ───────────
// Each row's lines must sum to zero (Σ debits = Σ credits). On POST the helper
// in src/modules/tally/lib/voucherLifecycle.ts creates a JournalEntry with the
// same lines so the GL stays consistent with traditional double-entry tooling.
model Voucher {
  id             Int           @id @default(autoincrement())
  type           VoucherType
  reference      String        @unique
  date           DateTime      @db.Date
  narration      String?
  partyAccountId Int?
  totalAmount    Decimal       @db.Decimal(14, 2)
  status         VoucherStatus @default(DRAFT)
  postedAt       DateTime?
  // Counter-entry created on POST — lets reports tie back to GL.
  journalEntryId Int?
  createdById    Int

  // ── Lifecycle metadata ──────────────────────────────────────────────────
  cancelledAt   DateTime?
  cancelledById Int?
  cancelReason  String?
  deletedAt     DateTime?
  deletedById   Int?
  deleteReason  String?

  partyAccount     Account?      @relation("VoucherPartyAccount", fields: [partyAccountId], references: [id])
  createdBy        User          @relation("VoucherCreatedBy", fields: [createdById], references: [id])
  cancelledBy      User?         @relation("VoucherCancelledBy", fields: [cancelledById], references: [id])
  deletedBy        User?         @relation("VoucherDeletedBy", fields: [deletedById], references: [id])
  lines            VoucherLine[]
  // POS shift back-relations (Contra vouchers posted on shift open / close)
  posShiftOpenings PosShift[]    @relation("PosShiftOpeningContra")
  posShiftClosings PosShift[]    @relation("PosShiftClosingContra")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([type, status])
  @@index([date])
  @@index([deletedAt])
  @@index([partyAccountId])
}

model VoucherLine {
  id          Int       @id @default(autoincrement())
  voucherId   Int
  voucher     Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  accountId   Int
  account     Account   @relation(fields: [accountId], references: [id])
  type        EntryType
  amount      Decimal   @db.Decimal(14, 2)
  description String?

  @@index([voucherId])
  @@index([accountId])
}

model VoucherAudit {
  id          Int      @id @default(autoincrement())
  originalId  Int
  originalRef String
  action      String
  reason      String?
  snapshot    Json
  actorId     Int
  actor       User     @relation("VoucherAuditActor", fields: [actorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([originalId])
  @@index([actorId])
  @@index([createdAt])
}

// ── Bill-wise allocation (free-form linking) ─────────────────────────────
// Polymorphic: any voucher (target) can be settled by any other voucher (source),
// fully or partially, now or later. AllocationMethod mirrors Tally's four modes:
// New Ref / Against Ref / Advance / On Account.
model VoucherAllocation {
  id          Int                  @id @default(autoincrement())
  targetType  AllocationTargetType
  targetId    Int
  sourceType  AllocationSourceType
  sourceId    Int
  amount      Decimal              @db.Decimal(14, 2)
  method      AllocationMethod
  reference   String?
  createdById Int
  createdBy   User                 @relation("VoucherAllocationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())

  @@index([targetType, targetId])
  @@index([sourceType, sourceId])
  @@index([method])
}

// ── Voucher Series (numbering configuration per voucher kind) ─────────────
// Reference is assembled from configurable parts (type/user/year/number) joined
// by a separator. On the next voucher creation past `yearClosingDate`, the year
// part rolls forward and `nextSeq` resets to 0 automatically.
//
// Reference = parts in `partOrder` (subset of: type,user,year,number) joined by `separator`.
//   type   → typeValue (truncated to typeMaxWidth)
//   user   → creator's User.id (zero-padded to userMaxWidth)
//   year   → fiscal year derived from fyStartYear, formatted per yearFormat
//   number → startFrom + nextSeq - 1 (zero-padded to padWidth)
// Singleton org-level configuration. The book-restart day is shared by every
// voucher series so a single year-end change rolls the whole business forward.
model BooksConfig {
  id           Int      @id @default(1) // singleton — always row id=1
  restartMonth Int      @default(4) // 1-12; default April (Indian FY)
  restartDay   Int      @default(1) // 1-31; default 1
  updatedAt    DateTime @updatedAt
}

model VoucherSeries {
  // Values: CONTRA | PAYMENT | RECEIPT | CREDIT_NOTE | DEBIT_NOTE | INVOICE | JOURNAL
  kind  String @id
  label String

  // Per-series fiscal year tracker. The closing date is derived from
  // BooksConfig.restartMonth/restartDay + this year. Rollover happens
  // automatically when today >= next restart date.
  fyStartYear Int? // e.g. 2026 = FY Apr-2026 → Mar-2027

  // Type part (voucher type code, used as-is — keep it short)
  typeEnabled Boolean @default(true)
  typeValue   String  @default("")

  // User part (creator's user ID)
  userEnabled  Boolean @default(false)
  userMaxWidth Int     @default(3)

  // Year part
  yearEnabled Boolean @default(true)
  // CALENDAR (2026) | CALENDAR_SHORT (26) | FY_SHORT (26-27) | FY_LONG (2026-27)
  yearFormat  String  @default("FY_SHORT")

  // Number part (always part of the reference — it's the actual counter)
  startFrom Int @default(1)
  padWidth  Int @default(4)
  nextSeq   Int @default(0)

  // Assembly: comma-separated list of parts. Reserved tokens — type, user,
  // year, number — expand to their values. Anything else is a literal,
  // letting the admin embed separators or text inline. Examples:
  //   "type,/,year,-,number"     →  INV/26-27-0001
  //   "type,number,-,user"       →  INV0001-007
  //   "type,/,year,/,user,number"→  INV/26-27/0070001
  partOrder String @default("type,-,year,-,number")

  updatedAt DateTime @updatedAt
}

// ── Voucher print templates ─────────────────────────────────────────────────
// One row per voucher kind. The `kind` PK is a string that's one of:
//   • VoucherType   (CONTRA | PAYMENT | RECEIPT | CREDIT_NOTE | DEBIT_NOTE | JOURNAL)
//   • InvVoucherType (PURCHASE | SALE | POS | ESTIMATE | SALE_RETURN | PURCHASE_RETURN
//                     | MANUFACTURING_JOURNAL | PHYSICAL_STOCK | BRANCH_TRANSFER | GRN
//                     | CHALLAN | REJECTION_IN | REJECTION_OUT | SALES_ORDER | PURCHASE_ORDER)
// Drives the thermal 80mm receipt rendered by /receipt/invoice/[id] and the
// shared <ThermalReceiptPreview> component (src/shared/components/print/).
// Bootstrap seed inserts all 21 rows; reset endpoint re-applies the defaults
// from src/shared/lib/print/voucherTemplateDefaults.ts (same source).
model VoucherPrintTemplate {
  kind String @id

  // Header
  headerLine1  String @default("")
  headerLine2  String @default("")
  addressBlock String @default("")
  gstinLine    String @default("")
  phoneLine    String @default("")
  logoUrl      String @default("")

  // Body toggles
  showLogo       Boolean @default(false)
  showAddress    Boolean @default(true)
  showGstin      Boolean @default(true)
  showPhone      Boolean @default(true)
  showTaxSummary Boolean @default(true)
  showSignature  Boolean @default(false)
  showQrCode     Boolean @default(false)

  // Footer
  termsText      String @default("")
  footerLine     String @default("Thank you · Visit again")
  signatureLabel String @default("Authorised Signatory")

  // Paper — default format used when the print route doesn't pass `?paper=`.
  // Values: "A4" | "THERMAL_80MM". POS rows are seeded with "THERMAL_80MM";
  // everything else seeds with "A4" (formal tax invoice on a printer).
  defaultPaper String @default("A4")
  paperWidthMm Int    @default(80)
  fontFamily   String @default("Courier New, monospace")
  fontSizePx   Int    @default(12)

  // Audit — no FK to User to avoid relation churn; just record the id.
  updatedAt   DateTime @updatedAt
  updatedById Int?
}
