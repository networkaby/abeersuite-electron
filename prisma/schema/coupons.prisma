// ── Coupons / Promotions (unified POS + shop) ───────────────────────────────
//
// A real, admin-managed promotions engine that supersedes (and replaced) the
// ecommerce-only ShopCoupon, now removed. Works at the POS and the online shop
// via the per-coupon `channels` flag.
//
// GL treatment mirrors loyalty redemption: a coupon discount is a server-resolved
// ₹ value posted as a NEGATIVE InvVoucherCharge to a dedicated "Coupon Discounts"
// expense ledger (see /api/pos/sale). The protected postInvVoucherToGl is never
// touched. Gift cards (Phase 4) are different — redemption is a payment TENDER
// drawing down a "Gift Card Liability" ledger, not a discount.
//
// Phasing: Phase 1 implements PERCENT + FLAT with code entry, the full constraint
// set, and stacking. FREE_ITEM / BOGO mechanic fields exist on the model (so no
// future migration) but their discount logic lands in Phases 2-3. Gift cards and
// milestone-issued coupons are Phases 4-5.

enum CouponType {
  PERCENT // % off the eligible subtotal, optionally capped at maxDiscountAmt
  FLAT // flat ₹ off the bill
  FREE_ITEM // free / discounted specific item (Phase 2)
  BOGO // buy X get Y (Phase 3)
  SET_PRICE // fix eligible lines to a flat ₹ unit price (stock clearance)
}

/// Whether a non-stackable coupon's exclusivity blocks the WHOLE bill's tier +
/// loyalty (today's only behavior) or just the lines the coupon itself matches.
/// Meaningless when `stackable` is true. Applies to every coupon type, not just
/// SET_PRICE, so BILL stays the default and existing coupons don't change.
enum CouponStackScope {
  BILL
  LINE
}

enum CouponChannel {
  POS // in-store POS only
  SHOP // online shop only
  BOTH // valid in both channels
}

enum CouponApplyMode {
  CODE // customer/cashier enters a code
  AUTO // fires automatically when conditions are met (Phase 2)
}

enum CouponEligibility {
  ANY // any customer
  NEW // first-time buyers only (lifetime invoice count = 0)
  RETURNING // existing customers only
}

enum GiftCardStatus {
  DRAFT // generated in the UI, NOT yet sold — no GL posting; freely deletable
  ACTIVE // issued/sold — Gift Card Liability posted; redeemable
  REDEEMED // balance hit 0
  EXPIRED // past expiry with balance left — recognised as breakage income
  VOID // cancelled by admin (liability reversed)
}

enum GiftCardTxnType {
  ISSUE // +balance, Cr Gift Card Liability (on sale)
  REDEEM // −balance, Dr Gift Card Liability (POS tender)
  REFUND // +balance restored on a return
  EXPIRE // −balance, Dr Gift Card Liability / Cr "Gift Card Breakage" (income)
  ADJUST // manual admin correction / void
}

model Coupon {
  id          Int             @id @default(autoincrement())
  /// Redemption code. null for AUTO coupons (no code to type). Unique among
  /// non-null codes (Postgres allows multiple nulls).
  code        String?         @unique
  name        String // admin label
  description String?
  type        CouponType
  channels    CouponChannel   @default(BOTH)
  applyMode   CouponApplyMode @default(CODE)

  // ── Mechanic values (only the fields relevant to `type` are populated) ──
  /// PERCENT: % off the eligible subtotal.
  percentOff      Decimal?    @db.Decimal(5, 2)
  /// PERCENT: max ₹ discount cap (null = uncapped).
  maxDiscountAmt  Decimal?    @db.Decimal(14, 2)
  /// FLAT: flat ₹ off.
  flatAmt         Decimal?    @db.Decimal(14, 2)
  /// FREE_ITEM / BOGO "get" product + qty + discount (100 = free). (Phases 2-3)
  freeProductId   Int?
  freeProduct     InvProduct? @relation("CouponFreeProduct", fields: [freeProductId], references: [id], onDelete: SetNull)
  freeQty         Decimal?    @db.Decimal(10, 3)
  freeDiscountPct Decimal?    @db.Decimal(5, 2)
  /// BOGO "buy" product (null = any) + thresholds. (Phase 3)
  buyProductId    Int?
  buyProduct      InvProduct? @relation("CouponBuyProduct", fields: [buyProductId], references: [id], onDelete: SetNull)
  buyQty          Decimal?    @db.Decimal(10, 3)
  getQty          Decimal?    @db.Decimal(10, 3)
  /// SET_PRICE: the fixed ₹ unit price eligible lines are marked down to.
  /// discount per unit = max(0, line unit price − setPriceAmt).
  setPriceAmt     Decimal?    @db.Decimal(14, 2)

  // ── Constraints ──
  startsAt         DateTime?
  endsAt           DateTime?
  minBillValue     Decimal?          @db.Decimal(14, 2)
  /// Max ₹ a single redemption can take (independent of percent cap; null = none).
  totalUsageLimit  Int? // N across all customers (null = unlimited)
  perCustomerLimit Int? // per-account cap (null = unlimited)
  isPrivate        Boolean           @default(false) // hidden from every offer list; works only when the code is typed
  eligibility      CouponEligibility @default(ANY)

  // ── Stacking ──
  /// OFF = coupon is exclusive: it drops tier + loyalty on the lines `stackScope`
  /// covers. ON = stacks with tier + loyalty everywhere (still subject to the
  /// global CouponConfig.maxTotalDiscountPct guard).
  stackable  Boolean          @default(false)
  /// Only meaningful when stackable = false. BILL = today's behavior (the whole
  /// bill loses tier + loyalty). LINE = only the lines THIS coupon's own rules
  /// match lose tier + loyalty; other lines in the same bill are unaffected.
  stackScope CouponStackScope @default(BILL)

  // ── Free-grant (FREE_ITEM / BOGO only) ──
  /// INDEPENDENT free-grant coupon: applies ON TOP of the money coupon (it never
  /// drops tier, never blocks loyalty, never counts against the global guard).
  /// Instead of a ₹ discount it GRANTS its item(s) as a zero-price "FREE" line
  /// on the bill (quantity 0 + freeQty, so stock + COGS move but no money) —
  /// the POS shows the FREE badge so the counter operator doesn't forget to
  /// hand the item over. Only effective when the coupon is FULLY free
  /// (freeDiscountPct 100): a partial (not 100%) independent coupon is NOT a
  /// grant — it behaves as a money coupon that waits in the Offers panel and
  /// applies its % discount once its item is added to the cart. False = the
  /// legacy behavior (the item already in the cart is discounted by
  /// freeDiscountPct as a regular coupon charge).
  independent Boolean @default(false)

  // ── Targeting ──
  /// Bind a coupon to one customer account (customer-specific / milestone-issued).
  ownerAccountId      Int?
  ownerAccount        Account?           @relation("CouponOwner", fields: [ownerAccountId], references: [id], onDelete: SetNull)
  /// Set on a LIVE coupon instance auto-issued when a loyalty milestone was crossed.
  issuedByMilestoneId Int?
  issuedByMilestone   LoyaltyMilestone?  @relation("MilestoneIssuedCoupons", fields: [issuedByMilestoneId], references: [id], onDelete: SetNull)
  /// Back-rel: milestones that use THIS coupon as their issue template.
  milestoneTemplates  LoyaltyMilestone[] @relation("MilestoneCouponTemplate")

  isActive    Boolean  @default(true)
  createdById Int
  createdBy   User     @relation("CouponCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules       CouponProductRule[]
  redemptions CouponRedemption[]
  campaigns   Campaign[]

  @@index([applyMode, isActive])
  @@index([channels, isActive])
  @@index([ownerAccountId])
  @@index([issuedByMilestoneId])
}

/// Product / category / group / brand include + exclude lists for a coupon. One
/// table, a `kind` discriminator ("INCLUDE" | "EXCLUDE") — Prisma can't dual-relate
/// the same FK. Queryable (vs JSON) so the admin form reuses SearchableSelect + we
/// can index.
///
/// Matching (see lineMatchesRule in couponMath.ts): the four taxonomy FKs on ONE
/// row are ANDed — a row with brandId=Samsung + categoryId=Phones matches only
/// Samsung phones. Rows of the same `kind` are ORed. A row with all four null
/// matches nothing (the form can't create one).
model CouponProductRule {
  id         Int              @id @default(autoincrement())
  couponId   Int
  coupon     Coupon           @relation(fields: [couponId], references: [id], onDelete: Cascade)
  kind       String // "INCLUDE" | "EXCLUDE"
  productId  Int?
  product    InvProduct?      @relation("CouponRuleProduct", fields: [productId], references: [id], onDelete: Cascade)
  categoryId Int?
  category   InvCategory?     @relation("CouponRuleCategory", fields: [categoryId], references: [id], onDelete: Cascade)
  groupId    Int?
  group      InvProductGroup? @relation("CouponRuleGroup", fields: [groupId], references: [id], onDelete: Cascade)
  brandId    Int?
  brand      InvBrand?        @relation("CouponRuleBrand", fields: [brandId], references: [id], onDelete: Cascade)

  @@index([couponId, kind])
}

/// Immutable log of every coupon redemption — powers usage-limit enforcement and
/// return reversal. A reversed row (reversedAt set) frees the usage slot.
model CouponRedemption {
  id                 Int               @id @default(autoincrement())
  couponId           Int
  coupon             Coupon            @relation(fields: [couponId], references: [id])
  accountId          Int?
  account            Account?          @relation("AccountCouponRedemptions", fields: [accountId], references: [id])
  /// Phase 5 5B: points at the UniversalVoucher spine (the document), not InvVoucher.
  universalVoucherId Int?
  universalVoucher   UniversalVoucher? @relation("SpineCouponRedemptions", fields: [universalVoucherId], references: [id])
  /// ₹ discount actually applied at this redemption.
  amount             Decimal           @db.Decimal(14, 2)
  channel            CouponChannel
  /// Set when reversed on a full return — frees the usage slot for re-use.
  reversedAt         DateTime?
  redeemedAt         DateTime          @default(now())

  // The counter's Postgres replica delta-syncs on "what changed since <ts>?".
  // `redeemedAt` is fixed at redemption, so a reversal on a full return — which
  // frees the coupon's usage slot — would be invisible to the replica, and the
  // counter would keep refusing a coupon the shop has already given back.
  // `@default(now())` backfills on push. See Person.updatedAt.
  updatedAt DateTime @default(now()) @updatedAt

  @@index([couponId])
  @@index([accountId])
  @@index([universalVoucherId])
  @@index([updatedAt])
}

/// Prepaid gift card / store credit. Lifecycle: DRAFT (generated in the UI, no
/// GL) → ACTIVE (sold — Cr "Gift Card Liability" against cash) → REDEEMED (drawn
/// down at POS, Dr Liability) or EXPIRED (breakage — Dr Liability / Cr income).
/// Balance is the source of truth; GiftCardTxn is the audit log.
model GiftCard {
  id             Int            @id @default(autoincrement())
  code           String         @unique
  initialValue   Decimal        @db.Decimal(14, 2)
  balance        Decimal        @db.Decimal(14, 2)
  status         GiftCardStatus @default(DRAFT)
  /// Manual on/off restriction — NO GL effect. A disabled card can't be redeemed
  /// at POS but keeps its liability + lifecycle; it simply waits until it expires.
  enabled        Boolean        @default(true)
  expiresAt      DateTime?
  /// Set when the card moves DRAFT → ACTIVE (the moment it was sold + posted).
  issuedAt       DateTime?
  /// Optional named holder (a customer account).
  ownerAccountId Int?
  ownerAccount   Account?       @relation("AccountGiftCards", fields: [ownerAccountId], references: [id], onDelete: SetNull)
  createdById    Int
  createdBy      User           @relation("GiftCardCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  txns GiftCardTxn[]

  @@index([status])
  @@index([ownerAccountId])
}

model GiftCardTxn {
  id                 Int               @id @default(autoincrement())
  giftCardId         Int
  giftCard           GiftCard          @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  type               GiftCardTxnType
  /// Signed against balance: +ISSUE/+REFUND, −REDEEM.
  amount             Decimal           @db.Decimal(14, 2)
  /// The POS sale that redeemed (or the return that refunded), for audit.
  /// Phase 5 5B: points at the UniversalVoucher spine (the document), not InvVoucher.
  universalVoucherId Int?
  universalVoucher   UniversalVoucher? @relation("SpineGiftCardTxns", fields: [universalVoucherId], references: [id])
  balanceAfter       Decimal           @db.Decimal(14, 2)
  createdById        Int
  createdBy          User              @relation("GiftCardTxnCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime          @default(now())

  @@index([giftCardId])
  @@index([universalVoucherId])
}

/// Singleton (id=1) — global stacking guard + dedicated GL ledger wiring.
/// Mirrors LoyaltyConfig; survives hard-clean.
model CouponConfig {
  id                         Int      @id @default(1)
  /// Max total discount as % of the bill across coupon + tier + loyalty combined
  /// (null = no global guard). Enforced in two places: the stacked spend-tier % is
  /// capped at this in the POS account snapshot (tier and the cap are both a % of the
  /// same goods value, so capping the % caps the rupees), then the coupon portion is
  /// clamped last against whatever tier + loyalty left (applyGlobalDiscountGuard).
  /// Editable from Coupons AND Spend Tiers — it is one shared ceiling, not per-page.
  maxTotalDiscountPct        Decimal? @db.Decimal(5, 2)
  /// Own cap for the coupon on a bill, % of goods (null = none). Applied before the
  /// combined guard above (finalizeCouponAmount).
  maxCouponDiscountPct       Decimal? @db.Decimal(5, 2)
  /// Own cap for the stacked spend-tier %, (null = none). The tier % is capped at
  /// the lower of this and maxTotalDiscountPct (resolveTierForAccount).
  maxTierDiscountPct         Decimal? @db.Decimal(5, 2)
  /// Dedicated expense ledger coupon discounts post to (Dr on a sale).
  couponExpenseAccountId     Int?
  couponExpenseAccount       Account? @relation("CouponExpenseLedger", fields: [couponExpenseAccountId], references: [id])
  /// Liability ledger gift cards draw down (Phase 4).
  giftCardLiabilityAccountId Int?
  giftCardLiabilityAccount   Account? @relation("GiftCardLiabilityLedger", fields: [giftCardLiabilityAccountId], references: [id])
  /// Income ledger unredeemed value posts to when a gift card expires (breakage).
  giftCardBreakageAccountId  Int?
  giftCardBreakageAccount    Account? @relation("GiftCardBreakageLedger", fields: [giftCardBreakageAccountId], references: [id])
  updatedAt                  DateTime @updatedAt
}
