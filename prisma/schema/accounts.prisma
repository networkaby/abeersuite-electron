// ── AccountGroup (Tally-style group hierarchy) ────────────────────────────────
//
// Groups are organisational containers (Primary → Sub-group).
// Every Account (ledger) optionally belongs to one group via groupId.

model AccountGroup {
  id        Int       @id @default(autoincrement())
  name      String
  type      GroupType
  parentId  Int?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)

  parent   AccountGroup?  @relation("GroupHierarchy", fields: [parentId], references: [id])
  children AccountGroup[] @relation("GroupHierarchy")
  accounts Account[]

  // Pricing-strategy additional-cost pool (OrgDefaults.shippingPoolGroupId).
  orgShippingPoolDefaults OrgDefaults[] @relation("OrgShippingPoolGroup")

  @@index([parentId, sortOrder])
  @@index([type])
}

// ── Account (unified chart-of-accounts + identity ledger) ────────────────────
//
// Every row is a proper ledger account. Person/company accounts have
// personId / companyId set and are created automatically on signup.
// Pure GL accounts (Cash, Revenue, etc.) leave those fields null.

model Account {
  id            Int            @id @default(autoincrement())
  name          String
  normalBalance NormalBalance?
  description   String?
  isActive      Boolean        @default(true)
  balance       Decimal        @default(0) @db.Decimal(14, 2)
  parentId      Int?
  groupId       Int?
  // Identity linkage — set only for person / company accounts
  personId      Int?           @unique
  companyId     Int?           @unique
  createdAt     DateTime       @default(now())
  // Lets the Day Book's local cache delta-sync party NAMES. Only GL vouchers
  // read a live Account.name — inventory vouchers freeze the party into
  // partyJson at creation, so those legitimately never drift. See Branch.updatedAt.
  updatedAt     DateTime       @default(now()) @updatedAt

  // Per-customer credit limit (future use; null = no limit). Lives on Account
  // because every Person and every Company gets exactly one Account row.
  creditLimit Decimal? @db.Decimal(14, 2)

  // Bank-ledger details — set only on ledgers under the "Bank Accounts" /
  // "Bank OD A/c" groups; printed on the Contra deposit slip so each bank
  // account carries its own particulars. Shape mirrors Organisation.bankJson:
  // { bankName, branch, accountNumber, ifsc, beneficiary, limit, fundTier }
  // `limit` (Bank OD A/c only) is the sanctioned overdraft ceiling — optional,
  // purely informational, and drives the "Available" hint (see facilityLimit.ts).
  // `fundTier` ("" | "INSTANT" | "OTHER", Bank OD A/c only) overrides which
  // Usable Fund section this ledger counts toward — "" defaults to INSTANT.
  // See fundTierOf() in facilityLimit.ts.
  bankJson Json?

  // Loan-ledger details — set only on ledgers under "Loans (Liability)" /
  // "Secured Loans" / "Unsecured Loans". Shape: { lender, loanAccountNumber,
  // principalAmount, interestRate, tenureMonths, emiAmount }
  loanJson Json?

  // Credit-card-ledger details — set only on ledgers under the "Credit Card"
  // group. Shape: { bankName, cardNetwork, cardNumber, billingDay, dueDay,
  // limit, fundTier, convertibility, feePct }. `limit` drives the "Available"
  // hint like the OD limit above. `fundTier` ("" | "INSTANT" | "OTHER") defaults
  // to OTHER; `convertibility` ("" | "CONVERTIBLE" | "RESTRICTED" | "UNAVAILABLE")
  // defaults to CONVERTIBLE; `feePct` is the processing fee applied when
  // CONVERTIBLE. See fundTierOf() / netFundValue() in facilityLimit.ts.
  creditCardJson Json?

  // BNPL-ledger details — set only on ledgers under the "BNPL A/c" group.
  // Shape: { provider, limit, fundTier, convertibility, feePct }. `limit`
  // drives the "Available" hint like the OD/Credit Card limits above.
  // `fundTier` defaults to OTHER; `convertibility` defaults to RESTRICTED
  // (a BNPL facility is normally purchase-only, no cash-out route) — see
  // fundTierOf() / netFundValue() in facilityLimit.ts.
  bnplJson Json?

  // Wallet-ledger details — set only on ledgers under the "Wallets" group.
  // Shape: { provider, fundTier, convertibility, feePct }. No `limit` — a
  // wallet is a prepaid balance, not a credit facility. `fundTier` defaults
  // to OTHER; `convertibility` defaults to CONVERTIBLE. See fundTierOf() /
  // netFundValue() in facilityLimit.ts.
  walletJson Json?

  // Payment-gateway-ledger details — set only on ledgers under the
  // "Payment Gateway" group (already live as a real-config group before
  // this column existed — see personal.local.json). Shape: { provider,
  // fundTier, convertibility, feePct }. No `limit` — same reasoning as
  // Wallets. `fundTier` defaults to OTHER; `convertibility` defaults to
  // CONVERTIBLE. See fundTierOf() / netFundValue() in facilityLimit.ts.
  gatewayJson Json?

  // Tally-style opening balance — entered on the master, dated at booksBeginningFrom.
  // Imbalance across all accounts auto-parks to the seeded "Difference in Opening Balances" suspense ledger.
  openingBalance     Decimal?   @db.Decimal(14, 2)
  openingBalanceType EntryType?
  openingBalanceDate DateTime?  @db.Date

  // Reconciliation watermark — this ledger has been matched against its outside
  // statement up to AND INCLUDING `reconciledThrough` (a business date; null =
  // never reconciled). `reconciledAt` is the wall-clock instant a human actually
  // performed that check, which is normally much LATER than the watermark — you
  // sit down on 27-Dec and confirm the statement through 15-Oct.
  //
  // That gap is where a backdated post can land: a voucher dated 13-Oct entered
  // on 29-Dec silently changes a balance already certified through 15-Oct. So the
  // single GL writer (engineGlArm) RETREATS the watermark to the day before any
  // such entry — 13-Oct dirty → watermark drops to 12-Oct — rather than leaving a
  // flag that quietly lies. `reconciledAt` is NOT touched by a retreat: it records
  // when a human last reconciled, and nobody reconciled on 29-Dec.
  // Same retreat fires on voucher hard-delete. See retreatReconciliation().
  reconciledThrough DateTime? @db.Date
  reconciledAt      DateTime?
  reconciledById    Int?

  parent                   Account?                   @relation("AccountHierarchy", fields: [parentId], references: [id])
  children                 Account[]                  @relation("AccountHierarchy")
  group                    AccountGroup?              @relation(fields: [groupId], references: [id])
  person                   Person?                    @relation(fields: [personId], references: [id])
  company                  Company?                   @relation(fields: [companyId], references: [id])
  devices                  Device[]
  tickets                  Ticket[]                   @relation("TicketAccount")
  taskRecurrences          TaskRecurrence[]           @relation("TaskRecurrenceAccount")
  // Phase 5 5D-4: InvVoucher.accountId dropped — the party lives on the spine
  // (UniversalVoucher.partyAccountId), so no InvVoucher back-relation here.
  // HR & People — a staff member's own ledger under "Salary Payable", and the
  // ONE salary expense ledger a payroll run debits (hr.prisma). The expense is
  // an org-wide cost, never a per-person account: 300 staff would otherwise mean
  // 300 lines in the P&L.
  staffLedgerOf            StaffProfile?              @relation("StaffLedger")
  payrollExpenseOf         PayrollRun[]               @relation("PayrollExpense")
  // POS reverse rels
  branchVaults             Branch[]                   @relation("BranchVaultAccount")
  counterTills             PosCounter[]               @relation("CounterTill")
  // Counter non-cash payment accounts (UPI/Card/gateway…) that settle to this ledger.
  posPaymentAccounts       PosCounterPaymentAccount[] @relation("PosPayAccountLedger")
  // POS service catalogue rows (Settings → POS Services) whose income posts here.
  posServices              PosService[]               @relation("PosServiceLedger")
  // Loyalty reverse rels
  loyalty                  LoyaltyAccount?            @relation("AccountLoyalty")
  loyaltyRedeemConfig      LoyaltyConfig[]            @relation("LoyaltyRedeemLedger")
  loyaltyMilestoneAwards   LoyaltyMilestoneAward[]    @relation("AccountLoyaltyMilestoneAwards")
  // Coupon reverse rels
  couponsOwned             Coupon[]                   @relation("CouponOwner")
  couponRedemptions        CouponRedemption[]         @relation("AccountCouponRedemptions")
  couponExpenseConfigs     CouponConfig[]             @relation("CouponExpenseLedger")
  giftCardLiabilityConfigs CouponConfig[]             @relation("GiftCardLiabilityLedger")
  giftCardBreakageConfigs  CouponConfig[]             @relation("GiftCardBreakageLedger")
  giftCards                GiftCard[]                 @relation("AccountGiftCards")
  reconciledBy             User?                      @relation("AccountReconciledBy", fields: [reconciledById], references: [id])
  // Tally-style alternate names / keywords — search/pick only, never printed, not unique. See AccountAlias.
  aliases                  AccountAlias[]

  @@index([isActive])
  @@index([personId])
  @@index([companyId])
  @@index([groupId])
  // Day Book refs delta: "any party renamed since <ts>?". Every customer has an
  // Account, so this is the one of the three name tables big enough to need it
  // (Branch and User are small enough to ship whole).
  @@index([updatedAt])
}

// ── AccountAlias ─────────────────────────────────────────────────────────────
//
// Tally-style alternate names / search keywords for a ledger. A ledger may
// carry many ("SBI", "State Bank" both find "State Bank of India — Current
// A/c"), so this is a child table rather than a column. In practice these
// behave more like tags than strict aliases — the same keyword may usefully
// sit on more than one ledger — so aliasKey is NOT unique across the chart
// of accounts.
//
// `alias` keeps the case the user typed (that is what the picker shows);
// `aliasKey` is its lowercased form, so "SBI" and "sbi" collide the way a
// human expects and are never stored twice on the same ledger. Both are
// written together — see aliasRows() in modules/accountancy/lib/accountAlias.ts.
//
// Search / selection only. The printed name of a ledger is always Account.name.
model AccountAlias {
  id        Int      @id @default(autoincrement())
  accountId Int
  alias     String   @db.VarChar(200)
  /// Lowercased `alias` — used for case-insensitive matching. Never displayed.
  aliasKey  String   @db.VarChar(200)
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([aliasKey])
}

// ── BiGstPlanningMonth ───────────────────────────────────────────────────────
//
// Monthly GST purchase planning — one row per calendar month (yearMonth =
// "YYYY-MM"). Every figure has a computed source (purchase = GST-party purchase
// vouchers, sale = sale vouchers, deposit = DEBIT legs on the selected bank / OD
// ledgers). The three *Override columns are the manual hand: null = use the
// computed value, a number = that number wins.

model BiGstPlanningMonth {
  yearMonth        String   @id // "2026-08"
  purchaseOverride Decimal? @db.Decimal(14, 2)
  saleOverride     Decimal? @db.Decimal(14, 2)
  depositOverride  Decimal? @db.Decimal(14, 2)
  updatedAt        DateTime @updatedAt
}

// ── BiGstPlanningFy ──────────────────────────────────────────────────────────
//
// One row per financial year (April–March), keyed by the starting year —
// 2026 = FY 2026-27.
//
// Purchase cannot be controlled, only forecast. Sale and bank deposit can. So
// the year is steered by ONE figure: allowedDiff, the targeted gap between
// purchase and sale. FY sale target = FY purchase + allowedDiff (negative =
// deliberately selling below purchase, banking input credit). The deposit
// ceiling then falls out of the sale target via the configured gap %.
//
// Both allowances are yearly, never monthly — an overshoot in an early month is
// corrected by the run rate left for the remaining months.

model BiGstPlanningFy {
  fyStartYear Int      @id // 2026 = FY 2026-27
  /// Signed target gap between FY purchase and FY sale. Negative = sale below purchase.
  allowedDiff Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt   DateTime @updatedAt
}

// ── BiGstPlanningConfig (singleton, id=1) ────────────────────────────────────
//
// Rates for the planning maths. taxRatePercent turns monthly value addition
// into GST cost; depositGapPercent keeps bank deposit that far below sale;
// presumptiveRatePercent is the slice of bank deposit the government deems
// income (presumptive taxation), and incomeTaxFreeLimit is the income below
// which no income tax falls due. Every figure is editable — none is hard-coded.

model BiGstPlanningConfig {
  id                    Int      @id @default(1)
  taxRatePercent        Decimal  @default(18) @db.Decimal(5, 2)
  depositGapPercent     Decimal  @default(10) @db.Decimal(5, 2)
  presumptiveRatePercent Decimal @default(8) @db.Decimal(5, 2)
  incomeTaxFreeLimit    Decimal  @default(1200000) @db.Decimal(14, 2)
  /// Bank + Bank OD ledger ids whose deposits count, e.g. [12, 45, 67]. Picked
  /// once and used for every month of every year.
  bankAccountIds        Json     @default("[]")
  updatedAt             DateTime @updatedAt
}

// ── CreditLimitConfig (singleton, id=1) ──────────────────────────────────────
//
// Global auto credit-limit calculator. The per-customer manual limit still lives
// on Account.creditLimit; this row only controls the AUTO floor layered on top.
//
// Auto limit for a customer = pctOfSales% of that customer's POSTED sales in the
// last windowDays. The EFFECTIVE limit enforced at the register is the HIGHER of
// the manual limit and the auto limit (see resolveEffectiveCreditLimit). When
// autoEnabled is false nothing auto-grants and behaviour is exactly the old
// deny-by-default: manual limit only, null/0 = cash-only.
model CreditLimitConfig {
  id           Int      @id @default(1) // singleton — always row id=1
  /// Master switch. false = manual-only (legacy deny-by-default). true = every
  /// customer also gets an auto limit sized from their own recent sales.
  autoEnabled  Boolean  @default(false)
  /// X — look back this many days of posted sales to size the auto limit.
  windowDays   Int      @default(90)
  /// Y — the auto limit is this percent of the windowed sales total.
  pctOfSales   Decimal  @default(10) @db.Decimal(6, 2)
  /// Optional hard ceiling on the computed auto number (null = no ceiling).
  maxAutoLimit Decimal? @db.Decimal(14, 2)
  /// Round the auto number to the nearest step (0 = no rounding).
  roundToStep  Int      @default(0)
  updatedAt    DateTime @updatedAt
}

/// A period customers are ranked in — the title ("Best of the month") plus the BRACKET
/// of history it counts spend over. Each period owns its OWN set of levels, so a
/// customer can hold several titles at once (Gold of the month AND Silver of the quarter).
///
/// The bracket is a slice of the past measured in days-ago: a sale counts when its age
/// is `fromDay <= age < toDay`. Brackets are rolling (relative to today), NOT lifetime,
/// so a customer who stops buying falls out of the recent ones. Tiling the brackets
/// (0-30, 30-90, 90-180 …) partitions spend, so each sale feeds exactly one period and
/// titles stop cascading. Overlapping brackets are ALLOWED — the same sale then counts
/// towards both titles, and since titles stack that money is discounted twice; it is the
/// admin's job to pick days that don't overlap unless they mean to.
///
/// Admin-managed at /office/customer-retention/customer-tiers. Survives hard-clean.
/// Who the bill on the counter counts for, on a period that counts it at all.
enum TierCurrentSaleScope {
  /// Posted history only — the bill earns nothing for itself.
  NONE
  /// Only customers with no posted bill yet, so a first purchase can earn its own level.
  NEW
  /// Only customers who have bought before.
  RETURNING
  /// Everyone. One rule for strangers and regulars alike.
  ALL
}

model CustomerTierPeriod {
  id               Int                  @id @default(autoincrement())
  /// The title awarded in this period, e.g. "Best of the month" / "Best of the quarter".
  name             String
  /// Whether the bill on the counter (before discount) is added on top of this period's
  /// posted spend, and for whom. Needs fromDay = 0 (the current sale is today, and a
  /// bracket starting further back does not contain it) UNLESS currentSaleOnly is set,
  /// which drops the bracket altogether.
  ///
  /// The bill's value only exists in the POS, so the account snapshot scores history alone
  /// and the POS re-resolves it live as the cart changes.
  currentSaleScope TierCurrentSaleScope @default(NONE)
  /// Ignore posted history entirely — this period scores ONLY the bill on the counter, and
  /// fromDay/toDay stop applying.
  ///
  /// This is what makes a "fresh customers only" ladder airtight. Scoping the current sale
  /// to NEW is not enough on its own: the bracket is ungated, so a returning customer with
  /// posted spend in that day range would still collect the title. With no bracket there is
  /// nothing to leak — a customer the scope excludes scores 0 and earns nothing.
  currentSaleOnly  Boolean              @default(false)
  /// Start of the bracket in days-ago, inclusive. 0 = today. Ignored when currentSaleOnly.
  fromDay          Int                  @default(0)
  /// End of the bracket in days-ago, exclusive. Must be greater than fromDay.
  /// e.g. fromDay 30 + toDay 90 = "the 30-to-90-days-ago slice".
  toDay            Int                  @default(180)
  enabled          Boolean              @default(true)
  sortOrder        Int                  @default(0)
  levels           CustomerTier[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([enabled])
}

/// One level inside a period ("Gold" of "Best of the month") — a spend threshold and
/// the auto-discount % it earns. NOT loyalty-points related (it posts to "Discount
/// Allowed"). Fully admin-managed: rename, add/remove, enable/disable, edit threshold + %.
model CustomerTier {
  id          Int                 @id @default(autoincrement())
  name        String // display name + POS badge label (e.g. Bronze / Gold / VIP)
  /// Spend (₹) inside the parent period's bracket required to reach this level.
  minSpend    Decimal             @db.Decimal(14, 2)
  /// Automatic discount % applied on pre-GST goods at this level. Periods apply
  /// INDEPENDENTLY: a customer holding titles in several periods gets the SUM of their
  /// percentages (clamped to 100). Brackets are what keep that honest — tile them and
  /// each rupee is counted once.
  discountPct Decimal             @db.Decimal(5, 2)
  enabled     Boolean             @default(true)
  sortOrder   Int                 @default(0)
  /// TODO(bridge): nullable only so the existing production level rows survive the
  /// `db push` that introduces periods. bootstrap-seed backfills orphans onto the
  /// default period; tighten to required once production is backfilled. A level with
  /// no period is inert — the POS snapshot only reads levels through their period.
  periodId    Int?
  period      CustomerTierPeriod? @relation(fields: [periodId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([enabled])
  @@index([periodId])
}
