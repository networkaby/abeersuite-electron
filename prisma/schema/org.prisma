// ── Org structure — Branch, Department & Position ─────────────────────────────

model Branch {
  id   String @id
  name String

  // Legacy free-form single-line address. Kept for back-compat with older
  // list / display surfaces. New structured fields below are the canonical
  // identity for invoice letterheads — the renderer prefers them and only
  // falls back to `address` when all structured fields are blank.
  address String?
  phone   String?

  // Structured address (Indian-business convention). Each branch in a
  // different GST state legally needs its own GSTIN — invoices issued from
  // that branch must carry the branch's address + GSTIN.
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pinCode      String?
  country      String? @default("India")

  // Branch contact + tax
  email        String?
  gstin        String? // 15-char Indian GSTIN; may differ from org.gstin
  gstStateCode String? // first 2 chars of GSTIN — denormalised for place-of-supply

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  departments Department[]
  positions   Position[]

  // Multi-branch inventory back-relations
  invVouchers       InvVoucher[]       @relation("InvVoucherBranch")
  invVouchersAsDest InvVoucher[]       @relation("InvVoucherDestBranch")
  invStockLedger    InvStockLedger[]   @relation("InvStockLedgerBranch")
  invProductStock   InvProductBranch[]

  // POS — per-branch vault account where end-of-day surplus lands
  vaultAccountId Int?
  vaultAccount   Account?     @relation("BranchVaultAccount", fields: [vaultAccountId], references: [id])
  posCounters    PosCounter[] @relation("BranchCounters")
  posShifts      PosShift[]   @relation("PosShiftBranch")

  // GL branch-tag back-relation — each JournalLine optionally stamps a branch
  // so branch reports can filter org-wide accounts (Sales, COGS, GST, etc.)
  journalLines JournalLine[] @relation("JournalLineBranch")
}

model Department {
  id          String   @id
  name        String
  description String?
  branchId    String?
  createdAt   DateTime @default(now())
  branch      Branch?  @relation(fields: [branchId], references: [id])
  positions   Position[]
}

// ── Position (org-chart hierarchy) ────────────────────────────────────────────
// A Position is a role/seat in the org. It can be scoped to a branch,
// a department, or left org-wide (Executive Council level).
// Multiple users can hold the same position (job-sharing / dual in-charge).

model Position {
  id               String   @id
  title            String
  branchId         String?
  departmentId     String?
  parentPositionId String?
  roleTemplateId   String?
  createdAt        DateTime @default(now())

  branch       Branch?        @relation(fields: [branchId], references: [id])
  department   Department?    @relation(fields: [departmentId], references: [id])
  parent       Position?      @relation("PositionHierarchy", fields: [parentPositionId], references: [id])
  children     Position[]     @relation("PositionHierarchy")
  roleTemplate Role?          @relation(fields: [roleTemplateId], references: [id])
  holders      UserPosition[]
}

model UserPosition {
  userId     Int
  positionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@id([userId, positionId])
}

// ── Org-wide defaults — singleton row (id=1) ──────────────────────────────────
// Holds pre-fill values used when creating new products, sale vouchers, and
// purchase vouchers. Follows the BooksConfig singleton pattern: row is
// auto-upserted on first GET, so no bootstrap seeding is required.
// All business-defaults are optional — admin fills them in via the UI.
model OrgDefaults {
  id Int @id @default(1) // singleton — always row id=1

  // Product defaults — final fallback in the GST/HSN cascade
  // (product → group → parent group → … → here).
  defaultUnitId     Int?
  defaultUnit       InvUnit?    @relation(fields: [defaultUnitId], references: [id], onDelete: SetNull)
  defaultGstRateId  Int?
  defaultGstRate    GstRate?    @relation("OrgDefaultsGst", fields: [defaultGstRateId], references: [id], onDelete: SetNull)
  defaultHsnCode    String?
  defaultTaxability Taxability?

  // Voucher defaults
  defaultSaleCreditPeriod     Int?
  defaultPurchaseCreditPeriod Int?

  // Currency display (free-form: ₹ / INR / Rs. / $ / USD — no conversion)
  defaultCurrencySymbol String @default("₹")

  updatedAt DateTime @updatedAt
}

// ── Organisation — singleton row (id=1) ───────────────────────────────────────
// Your own business / legal entity. Used as the source of truth for:
//   • Invoice / voucher print headers (GSTIN, address, brand name, phone)
//   • Letterhead and signature blocks
// Voucher print templates (VoucherPrintTemplate.headerLine1 / gstinLine /
// addressBlock / phoneLine / logoUrl) act as PER-KIND OVERRIDES — when those
// fields are blank the renderer falls back to this row.
//
// Bootstrap seed copies initial values from src/utils/constants-company-details.ts
// and is create-only on re-run, so admin edits survive `pnpm prisma db seed`.
// Edited via /office/settings/organisation.
//
// Storefront-only fields (SEO keywords, theme colour, social handles, return
// policy text, etc.) stay in constants-company-details.ts on purpose — they
// change with marketing copy, not business identity.
model Organisation {
  id Int @id @default(1) // singleton — always row id=1

  // Identity
  brandName String @default("") // customer-facing name (storefront, receipts)
  legalName String @default("") // legal entity name (invoices, contracts)
  tagline   String @default("")
  logoUrl   String @default("") // optional public URL; no upload UI yet

  // Address (one place; matches invoice convention)
  addressLine1 String @default("")
  addressLine2 String @default("")
  city         String @default("")
  state        String @default("")
  pinCode      String @default("")
  country      String @default("India")

  // Tax IDs
  gstin        String @default("") // 15-char Indian GSTIN
  pan          String @default("") // 10-char PAN
  gstStateCode String @default("") // first two chars of GSTIN — denormalised for place-of-supply

  // Contact
  email        String @default("")
  supportEmail String @default("")
  phone        String @default("")
  whatsapp     String @default("")
  siteUrl      String @default("")
  hours        String @default("")

  // Audit
  updatedAt   DateTime @updatedAt
  updatedById Int? // optional, mirror VoucherPrintTemplate.updatedById — no FK
}
