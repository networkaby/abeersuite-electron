// ── Org structure — Branch, Department & Position ─────────────────────────────

model Branch {
  id     String @id
  number Int    @unique
  name   String

  // Legacy free-form single-line address. Kept for back-compat with older
  // list / display surfaces. New structured fields below are the canonical
  // identity for invoice letterheads — the renderer prefers them and only
  // falls back to `address` when all structured fields are blank.
  address String?
  phone   String?

  // Structured address (Indian-business convention). Each branch in a
  // different GST state legally needs its own GSTIN — invoices issued from
  // that branch must carry the branch's address + GSTIN.
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pinCode      String?
  country      String? @default("India")

  // Branch contact + tax
  email        String?
  gstin        String? // 15-char Indian GSTIN; may differ from org.gstin
  gstStateCode String? // first 2 chars of GSTIN — denormalised for place-of-supply

  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  // Lets the Day Book's local cache delta-sync branch NAMES. Renaming a branch
  // touches no voucher, so without this the cached copy would show the old name
  // forever and the only cure would be discarding the whole copy on a timer.
  updatedAt   DateTime     @default(now()) @updatedAt
  departments Department[]
  positions   Position[]

  // Multi-branch inventory back-relations
  // Phase 5 5D-12: the primary voucher branch is on the spine now (UvBranch);
  // InvVoucher keeps only destinationBranch (branch-transfer detail).
  universalVouchers UniversalVoucher[] @relation("UvBranch")
  invVouchersAsDest VoucherDetail[]    @relation("InvVoucherDestBranch")
  invStockLedger    InvStockLedger[]   @relation("InvStockLedgerBranch")
  invProductStock   InvProductBranch[]

  // POS — per-branch vault account where end-of-day surplus lands
  vaultAccountId Int?
  vaultAccount   Account?     @relation("BranchVaultAccount", fields: [vaultAccountId], references: [id])
  posCounters    PosCounter[] @relation("BranchCounters")
  posShifts      PosShift[]   @relation("PosShiftBranch")
}

model Department {
  id             String                 @id
  name           String
  description    String?
  branchId       String?
  // All-access flag — when true, this department's permission pool is "every
  // permission" (computed live, no DepartmentPermission rows). Home for
  // cross-cutting roles (R1 Admin). Exactly one department should set this.
  isAllAccess    Boolean                @default(false)
  createdAt      DateTime               @default(now())
  branch         Branch?                @relation(fields: [branchId], references: [id])
  positions      Position[]
  // Roles homed in this department (their authoring lens = this dept's pool).
  roles          Role[]
  // The curated permission pool surfaced when authoring those roles.
  permissionPool DepartmentPermission[]
}

// ── Position (org-chart hierarchy) ────────────────────────────────────────────
// A Position is a role/seat in the org. It can be scoped to a branch,
// a department, or left org-wide (Executive Council level).
// Multiple users can hold the same position (job-sharing / dual in-charge).

model Position {
  id               String   @id
  title            String
  branchId         String?
  departmentId     String?
  parentPositionId String?
  createdAt        DateTime @default(now())

  branch          Branch?          @relation(fields: [branchId], references: [id])
  department      Department?      @relation(fields: [departmentId], references: [id])
  parent          Position?        @relation("PositionHierarchy", fields: [parentPositionId], references: [id])
  children        Position[]       @relation("PositionHierarchy")
  roleTemplates   PositionRole[]
  holders         UserPosition[]
  // Tickets (tasks / deals / …) assigned to this seat, resolved live to the holder.
  assignedTickets Ticket[]         @relation("TicketAssignedPosition")
  taskRecurrences TaskRecurrence[] @relation("TaskRecurrenceAssignedPosition")
  // Contacts (CRM) owned by this seat
  ownedPersons    Person[]         @relation("PersonOwnerPosition")
  ownedCompanies  Company[]        @relation("CompanyOwnerPosition")
}

model UserPosition {
  userId     Int
  positionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@id([userId, positionId])
}

// ── Position ↔ Role (M2M) ─────────────────────────────────────────────────────
// A position may carry one or more role templates. Holders inherit the union of
// their positions' role grants. `Position.departmentId` is derived from the
// attached roles (see resolvePositionDepartmentId).
model PositionRole {
  positionId String
  roleId     String
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([positionId, roleId])
  @@index([roleId])
}

// ── Org-wide defaults — singleton row (id=1) ──────────────────────────────────
// Holds pre-fill values used when creating new products, sale vouchers, and
// purchase vouchers. Follows the BooksConfig singleton pattern: row is
// auto-upserted on first GET, so no bootstrap seeding is required.
// All business-defaults are optional — admin fills them in via the UI.
model OrgDefaults {
  id Int @id @default(1) // singleton — always row id=1

  // Product defaults — final fallback in the GST/HSN cascade
  // (product → group → parent group → … → here).
  defaultUnitId     Int?
  defaultUnit       InvUnit?    @relation(fields: [defaultUnitId], references: [id], onDelete: SetNull)
  defaultGstRateId  Int?
  defaultGstRate    GstRate?    @relation("OrgDefaultsGst", fields: [defaultGstRateId], references: [id], onDelete: SetNull)
  defaultHsnCode    String?
  defaultTaxability Taxability?

  // Stock valuation default — drives BS closing stock, stock-summary, and the
  // pricing-strategy fallback when product.costMethod and strategy.costMethod
  // are both null. UI dropdowns (BS, stock-summary, pricing-strategy items)
  // initialise from this value and can preview other methods per-session.
  valuationMethod CostMethod @default(WEIGHTED_AVG)

  // Voucher defaults
  defaultSaleCreditPeriod     Int?
  defaultPurchaseCreditPeriod Int?

  /// Fallback supplier lead time (days) for the reorder-point check when a
  /// product has no leadTimeDays of its own.
  /// reorderLevel = avg daily usage (trailing window) × lead time, floored by
  /// the product's lowStockThreshold.
  defaultLeadTimeDays Int @default(7)

  // ── Movement classification bands (universal fallback) ─────────────────────
  // Days-since-last-sale boundaries for the movement classes that drive the
  // Reorder page + BI Stock Health: Regular ≤ slow < Slow ≤ nonMoving <
  // Non-moving ≤ dead < Dead. Overridable per ProductGroup (walks the parent
  // chain) and per Category — CCTV project cycles and ink/paper consumables
  // don't share one calendar. Resolution: group chain → category → here.
  reorderSlowAfterDays      Int @default(30)
  reorderNonMovingAfterDays Int @default(90)
  reorderDeadAfterDays      Int @default(180)
  /// A never-sold product younger than this is "New" (floor-only benefit of
  /// the doubt); older never-sold stock classifies as Dead.
  reorderNewItemDays        Int @default(60)

  /// Clearance detector: a sale line whose realized pre-tax unit price is at
  /// or below cost × (1 + this%) counts as CLEARANCE — stock leaving, never
  /// demand. Excluded from usage averages and from the revival ladder, so
  /// dumping dead stock at discount can never resurrect its buy signal.
  clearanceMarginCutoffPct Decimal @default(1) @db.Decimal(5, 2)

  // Currency display (free-form: ₹ / INR / Rs. / $ / USD — no conversion)
  defaultCurrencySymbol String @default("₹")

  // Barcode price bands for the Update & Print Labels page — a band-based buffer
  // added onto the Sale Price to leave headroom on the printed barcode, plus a
  // "hint" units digit telling staff which band applied. Shape: [{max,add,hint}].
  // Seeded create-only so admin edits survive reseed.
  barcodeBandsJson Json @default("[]")

  // Cash note/coin denominations for the POS shift-close counter, high → low.
  // Country-specific (some denominations don't exist everywhere) — admin edits
  // them in Settings. Seeded create-only so edits survive reseed. Shape:
  // number[] e.g. [2000, 500, 200, 100, 50, 20, 10, 5, 2, 1].
  cashDenominationsJson Json @default("[2000, 500, 200, 100, 50, 20, 10, 5, 2, 1]")

  // ── Additional-cost (shipping/courier) allocation pool ───────────────────
  // The AccountGroup whose every POSTED debit feeds the pricing-strategy
  // "waiting" pool on the Costing page. Admin nominates it (and creates a
  // ledger per courier/counter under it). Decision-support only — the layer
  // never posts to the GL. null = feature unconfigured. Admin-chosen, so
  // bootstrap-seed leaves it untouched (defaults null, survives reseed).
  shippingPoolGroupId Int?
  shippingPoolGroup   AccountGroup? @relation("OrgShippingPoolGroup", fields: [shippingPoolGroupId], references: [id], onDelete: SetNull)

  // Shop publish rules — which product fields are mandatory before a product can
  // be listed in /shop. Owner-configurable (Products → Publish rules). null =
  // the default gate (image + description + price). Shape: { image, description,
  // price, category, mrp: boolean }. Admin-chosen, so bootstrap-seed leaves it
  // untouched (survives reseed).
  shopPublishRulesJson Json?

  // What the storefront does with a tracked product at zero stock (Settings →
  // E-Commerce). Per-product `InvProduct.allowBackorder` can override to BACKORDER.
  shopOutOfStockPolicy ShopOutOfStockPolicy @default(NOTIFY)

  // POS Estimate print — which discount lines are SHOWN on the customer-facing
  // estimate printout/display. Price-privacy: the cashier's screen always shows
  // discounts (to negotiate), but the customer copy hides them by default so they
  // see only the tag/list price. null = all hidden. Shape: { tier, loyalty,
  // coupon, manual: boolean }. Admin-chosen, so bootstrap-seed leaves it untouched.
  posEstimateShowDiscountsJson Json?

  // Storefront home page layout — which sections show and in what order
  // (Ecommerce → Customize Home). null = the code default instances. Shape:
  // HomeSectionInstance[] (id, type, label, sectionNo, priority, enabled,
  // startAt?, endAt?, content) — see src/shared/lib/shop/homeLayout.ts.
  // Admin-chosen, so bootstrap-seed leaves it untouched (survives reseed).
  storefrontHomeJson Json?

  // Barcode-label template (Pricing Strategy → Print labels, settings bar above
  // the search box). Barcode labels are the documented EXCEPTION to the voucher
  // print-template surface — they are designed and saved here, not there. null =
  // the code defaults. Shape: LabelTemplate (presetId, header, which fields show,
  // secret-code placement, salePriceLabel) — see orgDefaultsSchemas.ts.
  // Admin-chosen, so bootstrap-seed leaves it untouched (survives reseed).
  labelTemplateJson Json?

  updatedAt DateTime @updatedAt
}

/// Scheduled-backup settings, edited from Settings → Backup & Restore.
///
/// Why a table rather than the cron in the workflow file: a cron can only be changed
/// by committing and pushing. This row is read by the hourly tick in
/// backup-scheduled.yml, so the shop can change when backups happen without touching
/// the repo.
///
/// Everything is stored in IST, the timezone the shop thinks in. The tick converts
/// once, when it compares. Storing UTC would mean every read and every edit had to
/// remember to shift, and "Sunday" would sometimes mean Saturday.
model BackupConfig {
  id      Int     @id @default(1) // singleton — always row id=1
  /// Master switch. false = the tick fires and does nothing.
  enabled Boolean @default(true)

  /// Which days, 0 = Sunday .. 6 = Saturday. All seven = daily; one = weekly.
  /// Empty = never, which the API rejects: an empty list is indistinguishable from
  /// a mis-save, and it silently stops backups.
  weekdays Int[] @default([0, 1, 2, 3, 4, 5, 6])

  /// Which hours of those days, 0-23. The tick is hourly, so hours are the finest
  /// granularity that can be honoured — a minute field would be a promise the
  /// schedule cannot keep.
  hours Int[] @default([22])

  /// Set after a dispatch. The tick refuses to fire twice in the same hour, so a
  /// GitHub retry cannot produce a second dump.
  lastRunAt DateTime?

  updatedAt DateTime @updatedAt
}

/// What a counter is allowed to write while it is cut off from Supabase, edited from
/// Settings → Offline Policies. One row, org-wide: an offline rule that differed per
/// machine would be no rule at all — two counters could each spend the same cash.
///
/// Why one Json column and not ~40 booleans: the shape is owned by the code
/// (`DEFAULT_OFFLINE_POLICIES` in `offlineVoucherSafety.ts`), which is also what fills
/// the gaps when this row is older than the build reading it. Adding a toggle is then
/// a code change, not a migration, and an unknown key from a newer build is ignored
/// rather than crashing an older counter.
///
/// The counter READS this (it syncs down like any other table) but never writes it:
/// `OfflinePolicy` is on NEVER_PUSH_MODELS and the replica guard refuses it outright.
/// The machine being restrained does not get to loosen its own restraints, and doing
/// it offline could not be reviewed by anyone until after the damage.
model OfflinePolicy {
  id Int @id @default(1) // singleton — always row id=1

  /// Partial `OfflinePolicies` — only the keys an admin has actually decided.
  /// Merged over `DEFAULT_OFFLINE_POLICIES` on read, so a missing key means
  /// "whatever the build considers safe", never `false`.
  policies Json @default("{}")

  updatedAt DateTime @updatedAt
}
