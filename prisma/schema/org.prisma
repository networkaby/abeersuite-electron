// ── Org structure — Branch, Department & Position ─────────────────────────────

model Branch {
  id          String       @id
  name        String
  address     String?
  phone       String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  departments Department[]
  positions   Position[]

  // Multi-branch inventory back-relations
  invVouchers       InvVoucher[]       @relation("InvVoucherBranch")
  invVouchersAsDest InvVoucher[]       @relation("InvVoucherDestBranch")
  invStockLedger    InvStockLedger[]   @relation("InvStockLedgerBranch")
  invProductStock   InvProductBranch[]

  // POS — per-branch vault account where end-of-day surplus lands
  vaultAccountId Int?
  vaultAccount   Account?     @relation("BranchVaultAccount", fields: [vaultAccountId], references: [id])
  posCounters    PosCounter[] @relation("BranchCounters")
  posShifts      PosShift[]   @relation("PosShiftBranch")

  // GL branch-tag back-relation — each JournalLine optionally stamps a branch
  // so branch reports can filter org-wide accounts (Sales, COGS, GST, etc.)
  journalLines JournalLine[] @relation("JournalLineBranch")
}

model Department {
  id          String   @id
  name        String
  description String?
  branchId    String?
  createdAt   DateTime @default(now())
  branch      Branch?  @relation(fields: [branchId], references: [id])
  positions   Position[]
}

// ── Position (org-chart hierarchy) ────────────────────────────────────────────
// A Position is a role/seat in the org. It can be scoped to a branch,
// a department, or left org-wide (Executive Council level).
// Multiple users can hold the same position (job-sharing / dual in-charge).

model Position {
  id               String   @id
  title            String
  branchId         String?
  departmentId     String?
  parentPositionId String?
  roleTemplateId   String?
  createdAt        DateTime @default(now())

  branch       Branch?        @relation(fields: [branchId], references: [id])
  department   Department?    @relation(fields: [departmentId], references: [id])
  parent       Position?      @relation("PositionHierarchy", fields: [parentPositionId], references: [id])
  children     Position[]     @relation("PositionHierarchy")
  roleTemplate Role?          @relation(fields: [roleTemplateId], references: [id])
  holders      UserPosition[]
}

model UserPosition {
  userId     Int
  positionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@id([userId, positionId])
}

// ── Org-wide defaults — singleton row (id=1) ──────────────────────────────────
// Holds pre-fill values used when creating new products, sale vouchers, and
// purchase vouchers. Follows the BooksConfig singleton pattern: row is
// auto-upserted on first GET, so no bootstrap seeding is required.
// All business-defaults are optional — admin fills them in via the UI.
model OrgDefaults {
  id Int @id @default(1) // singleton — always row id=1

  // Product defaults — final fallback in the GST/HSN cascade
  // (product → group → parent group → … → here).
  defaultUnitId     Int?
  defaultUnit       InvUnit?    @relation(fields: [defaultUnitId], references: [id], onDelete: SetNull)
  defaultGstRateId  Int?
  defaultGstRate    GstRate?    @relation("OrgDefaultsGst", fields: [defaultGstRateId], references: [id], onDelete: SetNull)
  defaultHsnCode    String?
  defaultTaxability Taxability?

  // Voucher defaults
  defaultSaleCreditPeriod     Int?
  defaultPurchaseCreditPeriod Int?

  // Currency display (free-form: ₹ / INR / Rs. / $ / USD — no conversion)
  defaultCurrencySymbol String @default("₹")

  updatedAt DateTime @updatedAt
}
