// ── Inventory masters + stock vouchers ───────────────────────────────────────

model InvUnit {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  label     String
  decimals  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products      InvProduct[]
  orgDefaultFor OrgDefaults[]
}

model GstRate {
  id          Int     @id @default(autoincrement())
  /// GST rate percentage, e.g. 18.00 for 18%
  rate        Decimal @db.Decimal(5, 2)
  label       String  @unique
  description String?
  isActive    Boolean @default(true)

  // Back-relations for cascading GST lookup (product → group → org-default).
  products      InvProduct[]      @relation("InvProductGst")
  productGroups InvProductGroup[] @relation("InvProductGroupGst")
  orgDefaults   OrgDefaults[]     @relation("OrgDefaultsGst")
}

model InvCategory {
  id        Int           @id @default(autoincrement())
  name      String
  slug      String?       @unique
  parentId  Int?
  parent    InvCategory?  @relation("InvCategoryHierarchy", fields: [parentId], references: [id])
  children  InvCategory[] @relation("InvCategoryHierarchy")
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  products         InvProduct[]
  attributeMasters InvAttributeMaster[]
  loyaltyEarnRules LoyaltyEarnRule[]    @relation("InvCategoryLoyaltyRules")
  couponRules      CouponProductRule[]  @relation("CouponRuleCategory")

  @@index([parentId])
}

model InvProductGroup {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Hierarchy ──────────────────────────────────────────────────────────────
  // Self-referential parent chain drives the GST / HSN / Taxability cascade
  // on InvProduct: product → group → parent group → … → OrgDefaults.
  parentId Int?
  parent   InvProductGroup?  @relation("InvProductGroupHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children InvProductGroup[] @relation("InvProductGroupHierarchy")

  // ── GST / HSN classification (optional — inherited from parent when null) ──
  gstRateId  Int?
  gstRate    GstRate?    @relation("InvProductGroupGst", fields: [gstRateId], references: [id], onDelete: SetNull)
  hsnCode    String?
  taxability Taxability?

  products         InvProduct[]
  loyaltyEarnRules LoyaltyEarnRule[] @relation("InvProductGroupLoyaltyRules")

  @@unique([name])
  @@index([parentId])
}

model InvBrand {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products InvProduct[]

  @@unique([name])
}

model InvWarrantyTerm {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  /// Coverage duration in days. 0 / null = no fixed duration (e.g. "lifetime" or
  /// "testing only"). Days chosen over months so terms can express short DOA /
  /// RMA windows (e.g. 7-day replacement) and long manufacturer warranties
  /// (e.g. 1825 = 5 years) in the same unit. See memory todo_warranty_redesign
  /// for the planned full redesign (provider / coverage / service-mode enums).
  durationDays Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products InvProduct[]
}

/// Category-specific attribute definitions — drives the "attr" token in naming
/// convention and the key dropdown on the product form. Attributes can be global
/// (categoryId = null) or restricted to a single category.
model InvAttributeMaster {
  id         Int          @id @default(autoincrement())
  /// Machine key stored in InvProduct.attrsJson (e.g. "ram", "storage", "os").
  key        String
  /// Human-readable label shown on forms (e.g. "RAM", "Storage", "OS").
  name       String
  /// null = applies to all categories; non-null = restricted to one category.
  categoryId Int?
  category   InvCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sortOrder  Int          @default(0)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([key, categoryId])
  @@index([categoryId])
}

/// Singleton config — drives auto-fill of InvProduct.name (offline),
/// InvProduct.shopSubheading (online display name), and InvProduct.slug
/// from the master selects on the product form. Three independent token
/// lists (offline / online / slug) share one fallback chain.
///
/// Token shape (per entry in *Fields JSON arrays):
///   { kind: "brand"|"category"|"group"|"modelNo"|"warranty"|"unit"|"literal",
///     enabled: boolean,
///     defaultValue?: string | null,
///     literal?: string }   // only when kind === "literal"
model InvNamingConfig {
  id Int @id @default(autoincrement())

  /// Offline (staff / voucher / POS) name token list.
  nameFields Json   @default("[]")
  /// Joiner for offline name. Default " ".
  separator  String @default(" ")

  /// Online (storefront display) name token list. Same shape as nameFields.
  onlineNameFields Json   @default("[]")
  /// Joiner for online name. Default " ".
  onlineSeparator  String @default(" ")

  /// URL slug token list. Same shape; output is slugified (lowercased,
  /// non-alphanumeric replaced with slugSeparator).
  slugFields Json @default("[]")

  /// Shared per-kind fallback chain across all three outputs.
  /// Shape: { group: ["category","brand"], category: ["group","brand"], … }
  fallbackFields Json @default("{}")

  /// Master switch — when false, slug auto-fill is disabled.
  slugEnabled   Boolean @default(true)
  /// Slug separator. Default "-".
  slugSeparator String  @default("-")
  /// Hard cap on generated slug length. 0 = uncapped.
  slugMaxLength Int     @default(80)

  updatedAt DateTime @updatedAt
}

model InvProduct {
  id   Int    @id @default(autoincrement())
  sku  String @unique
  name String

  /// Free-text user portion that survives name regeneration. Rendered
  /// wherever the InvNamingConfig places the `userPart` token. Lets the
  /// operator curate values like "1.5M Special", "Compatible", "m100"
  /// once and have the regenerate button rebuild the full name around
  /// it instead of clobbering it. null = nothing.
  namePart       String?
  unitId         Int
  categoryId     Int?
  groupId        Int?
  brandId        Int?
  warrantyTermId Int?
  modelNo        String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ── Ecommerce / storefront fields (null = not listed in shop) ──────────────
  /// URL-safe handle for /shop/product/[handle]
  slug                    String? @unique
  shopSubheading          String?
  shopDescription         String?
  /// Display category label for storefront (falls back to InvCategory.name)
  shopCategory            String?
  /// Materialized "effective sale price" (paise, GST-inclusive). The single value
  /// every sale transaction (POS + Sale voucher) charges. Rewritten from the chosen
  /// `effectiveSalePriceSource` by the recompute trigger after each transaction and
  /// immediately on Freeze. null = not priced / not listed in shop.
  effectiveSalePricePaise Int?
  mrpPaise                Int?
  shopBadge               String?
  imageUrl                String?
  /// JSON array of image URLs for gallery
  galleryJson             Json?
  /// JSON object of label → value for specs tab
  specsJson               Json?
  /// Free-form custom attributes — flat { key: value } pairs used for SEO-rich
  /// naming convention tokens and additional product info (colour, storage, OS, …).
  attrsJson               Json?
  /// Cached running stock balance — updated atomically on every voucher post/cancel
  /// (mirrors Account.balance pattern from GL module). null = stock not tracked.
  stock                   Int?
  /// O2C reservation: units HELD by confirmed-but-not-yet-fulfilled orders.
  /// available-to-sell = stock − reserved. Incremented when an order is Confirmed,
  /// decremented on Cancel/Return; converted to a real stock-out at Fulfil.
  reserved                Int     @default(0)
  lowStockThreshold       Int     @default(5)
  isListedInShop          Boolean @default(false)
  /// Per-product override of the org out-of-stock policy: when true the shop
  /// accepts orders for this product even at zero stock (backorder / procure later).
  allowBackorder          Boolean @default(false)

  // ── Pricing strategy (cost basis + per-item overrides) ─────────────────────
  /// Per-item cost-basis method consumed by the pricing-strategy resolver +
  /// BS valuation. See `enum CostMethod`. Null = inherit from the matched
  /// strategy (which itself may inherit to OrgDefaults.valuationMethod).
  /// Resolution: product.costMethod ?? strategy.costMethod ?? OrgDefaults.valuationMethod.
  costMethod      CostMethod?
  /// Per-item margin override in percent (e.g. 18.50 = +18.5%). null = walk the
  /// PricingStrategy chain (BRAND → GROUP → CATEGORY → ORG).
  marginPercent   Decimal?    @db.Decimal(6, 2)
  /// True when a user has manually set effectiveSalePricePaise — bulk recompute skips this row.
  priceOverridden Boolean     @default(false)

  // ── Saved "Sale Price" (the human sale price — barcode source) ──────────────
  /// Which source materializes effectiveSalePricePaise. SAVED = the frozen
  /// savedSalePricePaise below; STRATEGY/COMPUTED = the live engine. Set on the
  /// Update & Print Labels page AND by Edit Product / Item Import.
  effectiveSalePriceSource EffectiveSalePriceSource @default(STRATEGY)
  /// The saved, human-entered sale price (paise). null = not set. The pricing
  /// engine NEVER overwrites this (unlike effectiveSalePricePaise). MRP-capped at
  /// save time. Single source of truth for the printed barcode, and the value that
  /// materializes into effectiveSalePricePaise when effectiveSalePriceSource = SAVED.
  /// Written by Edit Product, Item Import, and the Update & Print Labels "Sale Price" column.
  savedSalePricePaise      Int?
  /// When savedSalePricePaise was last frozen — drives the printed barcode date code.
  salePriceFrozenAt        DateTime?
  /// After-tax profit (paise) decided at freeze time — basis for the drift /
  /// profit-gap filter on the labels page (current profit vs this snapshot).
  savedProfitPaise         Int?

  // ── Tally-style opening stock — entered on the master, dated at booksBeginningFrom.
  // Mismatch between Σ(openingValue) and the "Stock-in-Hand" line on the
  // opening journal auto-parks to "Difference in Opening Balances".
  openingStock     Decimal?  @db.Decimal(10, 3)
  openingRate      Decimal?  @db.Decimal(14, 2)
  openingValue     Decimal?  @db.Decimal(14, 2)
  openingStockDate DateTime? @db.Date

  // ── GST classification (optional — inherited from group/parent group when null) ──
  /// HSN (goods) or SAC (services) code — drives the rate-wise summary.
  /// null → resolver walks group ancestors, then OrgDefaults.defaultHsnCode.
  hsnCode    String?
  /// FK to the GstRate master. null → resolver walks group ancestors, then
  /// OrgDefaults.defaultGstRateId. Each voucher line snapshots the resolved
  /// rate at entry time so past invoices stay immutable.
  gstRateId  Int?
  gstRate    GstRate?    @relation("InvProductGst", fields: [gstRateId], references: [id], onDelete: SetNull)
  taxability Taxability?

  unit         InvUnit          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  category     InvCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  group        InvProductGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  brand        InvBrand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  warrantyTerm InvWarrantyTerm? @relation(fields: [warrantyTermId], references: [id], onDelete: SetNull)

  codes                     InvProductCode[]
  orderLines                ShopOrderLine[]
  voucherLines              VoucherInventoryLine[]
  stockEntries              InvStockLedger[]
  branchStocks              InvProductBranch[]
  reservations              StockReservation[]
  bomOutputs                InvBom[]                   @relation("BomOutput")
  bomConsume                InvBomLine[]               @relation("BomConsume")
  loyaltyEarnRules          LoyaltyEarnRule[]          @relation("InvProductLoyaltyRules")
  couponFreeProducts        Coupon[]                   @relation("CouponFreeProduct")
  couponBuyProducts         Coupon[]                   @relation("CouponBuyProduct")
  couponRules               CouponProductRule[]        @relation("CouponRuleProduct")
  additionalCostAllocations AdditionalCostAllocation[]

  @@index([unitId])
  @@index([categoryId])
  @@index([groupId])
  @@index([brandId])
  @@index([warrantyTermId])
  @@index([gstRateId])
  @@index([isListedInShop])
}

/// Scannable product code — one row per barcode / EAN / UPC. Replaces the old
/// repeating barcode1-3 / ean1-3 / upc1-3 columns on InvProduct (1NF fix). A
/// product carries any number of codes; `value` is globally unique so a scanned
/// string resolves to exactly one product (the scan-lookup hot path is a single
/// indexed equality instead of a 9-column OR). `sortOrder` preserves entry order;
/// the first BARCODE-kind row is treated as the "primary" code for label/display.
model InvProductCode {
  id        Int                @id @default(autoincrement())
  productId Int
  product   InvProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      InvProductCodeKind
  value     String             @unique
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())

  @@index([productId])
  @@map("inv_product_codes")
}

/// Per-branch stock balance — replaces global InvProduct.stock for multi-branch
/// inventory. One row per (productId, branchId). `stock` is updated atomically
/// on voucher post/cancel, mirroring the cached-balance pattern.
model InvProductBranch {
  productId Int
  branchId  String
  stock     Int      @default(0)
  updatedAt DateTime @updatedAt

  product InvProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([productId, branchId])
  @@index([branchId])
  @@map("inv_product_branches")
}

/// O2C stock reservation (Phase 2). One row per order line whose stock is HELD
/// against a confirmed-but-not-yet-fulfilled order. Org-wide for now (branch-level
/// reservation is a refinement). The order is polymorphic, so it's keyed by
/// (orderSource, orderId) — "inv" = order-type InvVoucher, "shop" = ShopOrder.
/// HELD = blocking available; EXECUTED = converted to a real stock-out at Fulfil;
/// RELEASED = order cancelled/returned. InvProduct.reserved = Σ HELD qty.
model StockReservation {
  id          Int      @id @default(autoincrement())
  orderSource String // "inv" | "shop"
  orderId     Int
  productId   Int
  quantity    Int
  status      String   @default("HELD") // HELD | EXECUTED | RELEASED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product InvProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderSource, orderId])
  @@index([productId, status])
  @@map("stock_reservations")
}

/// O2C redemption hold (Phase 2b). Mirrors StockReservation but for *reward value*
/// rather than stock: when an ORDER is placed with a loyalty / coupon / gift-card
/// redemption, the value is HELD (not yet burned) so it can't be double-spent
/// before the order is invoiced. EXECUTED when the order is fulfilled (the sale
/// burns the reward for real); RELEASED when the order is cancelled/returned.
/// Polymorphic order key (orderSource, orderId) like StockReservation. GL-silent —
/// the actual ledger/wallet effect happens on the Sale at Fulfil, not here.
model RedemptionHold {
  id          Int      @id @default(autoincrement())
  orderSource String // "inv" | "shop"
  orderId     Int
  rewardType  String // LOYALTY | COUPON | GIFT_CARD
  rewardRef   String? // coupon code / gift-card code (null for loyalty)
  rewardId    Int? // Coupon.id / GiftCard.id (null for loyalty wallet)
  accountId   Int? // customer ledger account the reward belongs to
  points      Int? // loyalty points held (null for coupon/gift-card)
  amount      Decimal  @default(0) @db.Decimal(14, 2) // rupee value held
  meta        Json? // reward-specific plan (e.g. loyalty FIFO lot consumption)
  status      String   @default("HELD") // HELD | EXECUTED | RELEASED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderSource, orderId])
  @@index([rewardType, status])
  @@map("redemption_holds")
}

// ── Stock Vouchers (Purchase / Sale) ─────────────────────────────────────────

model InvVoucher {
  id                  Int                    @id @default(autoincrement())
  // Phase 5 5D-11: `type` dropped — lives on the spine (UniversalVoucher.type, a
  // String spanning every voucher kind). Readers reach it via `universalVoucher.type`.
  // Phase 5 5D-6: `reference` (the user-facing SV-/PV- number) dropped — it lives
  // on the spine as `voucherNo` (the Voucher No); the spine's own `reference` is
  // the Universal Voucher No (UVNo).
  // Phase 5 5D-12: `branchId`/`branch` dropped — the primary branch lives on the
  // spine now (UniversalVoucher.branchId). Readers reach it via universalVoucher.branch.
  // `destinationBranchId` (branch-transfer partner) stays here as a trade detail.
  // Phase 5 5D-10: `date` dropped — lives on the spine (UniversalVoucher.date).
  // Readers reach it via `universalVoucher.date` (order/filter via the relation).
  // Phase 5 5D-5: `description` dropped — lives on the spine (UniversalVoucher.description).
  // Phase 5 5D-8: `status` dropped — lives on the spine (UniversalVoucher.status).
  // Phase 5 5D-4: `accountId`/`account` dropped — the LIVE party ledger link
  // lives on the spine (UniversalVoucher.partyAccountId). The frozen partyJson
  // snapshot below + the legacy partyType/partyId routing keys stay on the detail.
  /// Frozen party snapshot — { name, phone, address } as-of the transaction
  /// (immutable on a tax invoice). Replaced the partyName / partyPhone /
  /// partyAddress scalar columns (2026-06-10). `accountId` above is the canonical
  /// LIVE party link; this is the display snapshot. See src/shared/lib/accountancy/partySnapshot.ts.
  partyJson           Json?
  /// Legacy routing keys (still used by outstandings / bill-wise link + linkable
  /// to resolve/match the party for rows where accountId isn't relied on). Slated
  /// to be dropped once accountId is the sole link — see task "Full-normalize
  /// InvVoucher party".
  partyType           String? // "supplier" | "customer" | "account"
  partyId             Int?
  /// Supplier-issued bill number on a PURCHASE (we don't generate it — the
  /// supplier does). Also reused as the "original invoice / bill number"
  /// on SALE_RETURN / PURCHASE_RETURN to back-reference the source voucher.
  refNumber           String?
  refDate             DateTime?              @db.Date
  /// Optional FK back to the source InvVoucher being returned against —
  /// lets a SALE_RETURN link to the original SALE (and PURCHASE_RETURN to
  /// the original PURCHASE) so the detail page can show the relationship.
  refVoucherId        Int?
  refVoucher          InvVoucher?            @relation("InvVoucherRef", fields: [refVoucherId], references: [id])
  refReturns          InvVoucher[]           @relation("InvVoucherRef")
  /// Number of days from voucher date until payment is due. Only for CREDIT mode.
  creditPeriodDays    Int?
  /// State code where the supply happens — drives intra/inter-state GST split.
  /// Defaults to the company's state code when unset.
  placeOfSupply       String?
  /// Counter pickup vs delivery — drives the place-of-supply resolution.
  /// COUNTER (default): customer picks up at the counter; place of supply
  /// is the branch state per §10(1)(c) regardless of the customer's address.
  /// SHIPPED: goods are couriered/dispatched, place of supply is the
  /// customer's shippingStateCode (or GSTIN state for B2B).
  /// POS sales are always COUNTER (hardcoded in /api/pos/sale).
  deliveryMode        InvVoucherDeliveryMode @default(COUNTER)
  discountPct         Decimal?               @db.Decimal(5, 2)
  discountAmt         Decimal?               @db.Decimal(14, 2)
  shippingAmt         Decimal                @default(0) @db.Decimal(14, 2)
  roundOff            Decimal                @default(0) @db.Decimal(14, 2)
  subtotal            Decimal                @db.Decimal(14, 2)
  taxAmount           Decimal                @default(0) @db.Decimal(14, 2)
  totalAmount         Decimal                @db.Decimal(14, 2)
  /// Phase 5 5D-1: vestigial `journalEntryId` dropped — since G5 it always equalled
  /// `universalVoucherId` (the spine self-refs). Use `universalVoucherId` as the link.
  /// Phase 4 G4d: direct link to the universal-voucher spine (set on post).
  universalVoucherId  Int?                   @unique
  universalVoucher    UniversalVoucher?      @relation("InvVoucherSpine", fields: [universalVoucherId], references: [id])
  // Phase 5 5D-5: `postedAt` dropped — lives on the spine (UniversalVoucher.postedAt).
  // Toggle on Challan vouchers — when false, printed challan hides rate/amount columns.
  showPrices          Boolean                @default(true)
  /// Optional FK to InvBom — only set for MANUFACTURING_JOURNAL vouchers
  /// generated from a recipe (stamped for audit / reporting).
  bomId               Int?
  bom                 InvBom?                @relation(fields: [bomId], references: [id])
  /// Destination branch — only set for BRANCH_TRANSFER. The source branch
  /// is the standard `branchId` field; this column carries the partner
  /// branch the stock is moving into. Two `InvStockLedger` rows are written
  /// per transfer line at post time (one OUT on source, one IN on dest).
  destinationBranchId String?
  destinationBranch   Branch?                @relation("InvVoucherDestBranch", fields: [destinationBranchId], references: [id])

  /// Back-link to an ecommerce order this voucher was raised against.
  /// Unique because one shop order produces at most one sale voucher.
  /// Replaces Invoice.shopOrderId during the Invoice→InvVoucher consolidation.
  shopOrderId Int?       @unique
  shopOrder   ShopOrder? @relation("OrderInvVoucher", fields: [shopOrderId], references: [id], onDelete: SetNull)

  /// Back-link to a repair ticket this voucher was raised against.
  /// Soft FK — one ticket can have multiple vouchers (estimate + final, etc.).
  /// Replaces Invoice.ticketId during the Invoice→InvVoucher consolidation.
  ticketId Int?
  ticket   Ticket? @relation("TicketInvVouchers", fields: [ticketId], references: [id], onDelete: SetNull)

  /// Soft link to a CRM Deal this voucher captured — set when a POS Estimate
  /// captures a sales lead (Order-to-Cash "any signal → Deal"). One Deal can
  /// have many vouchers (estimate → order → sale). SetNull on Deal delete.
  dealId Int?
  deal   Deal? @relation("DealInvVouchers", fields: [dealId], references: [id], onDelete: SetNull)

  /// O2C order pipeline (P7) for order-type vouchers (POS_ORDER / SALES_ORDER).
  /// Lets a counter/office order ride the same Orders board as ShopOrder. Null
  /// for every other voucher type. `orderStatusId` is the current P7 stage.
  orderPipelineId String?
  orderPipeline   Pipeline?     @relation("OrderVoucherPipeline", fields: [orderPipelineId], references: [id])
  orderStatusId   String?
  orderStatus     TicketStatus? @relation("OrderVoucherStatus", fields: [orderStatusId], references: [id])

  // ── Lifecycle (Phase 5 5D-8) ────────────────────────────────────────────
  // `status` + `deletedAt` now live ENTIRELY on the spine (UniversalVoucher).
  // Readers reach lifecycle state via `universalVoucher.status` / `.deletedAt`;
  // full metadata (cancelledAt/By/Reason + deletedById/deleteReason) is there too.
  // Phase 5 5D-2: createdBy also lives on the spine.
  // Phase 5 5C: goods lines (VoucherInventoryLine) + stock rows (InvStockLedger)
  // hang off the SPINE now, not InvVoucher — reach them via universalVoucher.
  // Phase 4 G4b: tender + charge INPUT (re-rendered for edit, never aggregated —
  // money/reporting read the posted spine's role=TENDER/CHARGE VoucherGlLine).
  // Shape: { tenders: [{accountId, amount, method?, reference?}],
  //          charges: [{accountId, amount, description?}] }. Replaced the
  // InvVoucherTender / InvVoucherCharge tables (folded into the spine on POST).
  settlementJson            Json?
  // Phase 5 5B: loyalty / coupon / gift-card / cost-pool back-relations moved to
  // the UniversalVoucher spine (the document) — InvVoucher no longer anchors them.
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([ticketId])
  @@index([dealId])
  @@index([orderStatusId])
}

// Phase 4 G4c: renamed InvVoucherLine → VoucherInventoryLine (vocabulary.md — the
// "goods" line face). Table kept via @@map so the rename is code-only, no migration.
model VoucherInventoryLine {
  id                  Int        @id @default(autoincrement())
  // Phase 5 5C: goods lines hang off the spine (UniversalVoucher) — voucherId
  // (→ InvVoucher) dropped. The inventory voucher reaches them via its spine.
  universalVoucherId  Int
  universalVoucher    UniversalVoucher @relation("SpineInventoryLines", fields: [universalVoucherId], references: [id], onDelete: Cascade)
  productId           Int
  product             InvProduct @relation(fields: [productId], references: [id])
  description         String?
  /// "CONSUME" | "PRODUCE" for MANUFACTURING_JOURNAL lines; null for every
  /// other voucher type. Drives the stock IN/OUT direction on post.
  direction           String?
  quantity            Decimal    @db.Decimal(10, 3)
  /// Free / complimentary quantity — flows out of stock alongside `quantity`
  /// but contributes ₹ 0 to revenue (line.amount). Used for "buy 2 get 1 free"
  /// style schemes. Optional; defaults to 0 at the application layer.
  freeQty             Decimal?   @db.Decimal(10, 3)
  rate                Decimal    @db.Decimal(14, 2)
  /// MRP (Maximum Retail Price) at the time of the transaction — paise.
  /// Populated on PURCHASE voucher lines by the form; used to update
  /// InvProduct.mrpPaise on POST so the product catalog stays current.
  /// Also snapshotted on POS/SALE lines at sale time so the customer-facing
  /// "Today's discount" price ladder can show MRP on a reprint.
  mrpPaise            Int?
  /// Printed barcode TAG price at the time of the sale — paise. This is the
  /// public, on-the-label price DERIVED from the product's saved sale price + MRP
  /// via the org barcode bands (see src/shared/lib/pricing/barcodePrice.ts), NOT
  /// the raw saved price. Snapshotted on POS/SALE lines so the computed customer
  /// bill shows the barcode line + the "Counter discount" (barcode − effective)
  /// without re-reading the product or re-deriving the tag (prices/bands drift).
  savedSalePricePaise Int?
  discountPct         Decimal    @default(0) @db.Decimal(5, 2)
  discountAmt         Decimal    @default(0) @db.Decimal(14, 2)
  taxRate             Decimal    @default(0) @db.Decimal(5, 2)
  taxAmount           Decimal    @default(0) @db.Decimal(14, 2)
  /// (qty × rate) − discountAmt + taxAmount
  amount              Decimal    @db.Decimal(14, 2)

  @@index([universalVoucherId])
  @@index([productId])
  @@map("InvVoucherLine")
}

/// Immutable audit trail — one row per product per voucher line posted.
/// inQty > 0 for PURCHASE/GRN; outQty > 0 for SALE/CHALLAN.
model InvStockLedger {
  id        Int        @id @default(autoincrement())
  productId Int
  product   InvProduct @relation(fields: [productId], references: [id])
  // Phase 5 5C: stock rows hang off the spine — voucherId (→ InvVoucher) dropped.
  universalVoucherId Int
  universalVoucher   UniversalVoucher @relation("SpineStockLedger", fields: [universalVoucherId], references: [id], onDelete: Cascade)
  /// Branch where this stock movement happened — stamped at post time from
  /// the parent voucher's branchId. Required for per-branch ledger queries.
  branchId  String
  branch    Branch     @relation("InvStockLedgerBranch", fields: [branchId], references: [id])
  date      DateTime   @db.Date
  inQty     Decimal    @default(0) @db.Decimal(10, 3)
  outQty    Decimal    @default(0) @db.Decimal(10, 3)
  rate      Decimal    @db.Decimal(14, 2)
  amount    Decimal    @db.Decimal(14, 2)

  @@index([productId, date])
  @@index([universalVoucherId])
  @@index([productId, branchId, date])
}

// ── Bill of Materials (recipes for Manufacturing Journal) ────────────────────
//
// Each InvBom defines: "to produce <outputQty> of <outputProduct>, consume
// these line items." When the Manufacturing Journal form picks a BOM and
// sets a target output qty, consumption + production lines are auto-populated
// (consumption is scaled proportionally). The voucher remembers which BOM
// drove it via InvVoucher.bomId for audit / reporting.

model InvBom {
  id              Int          @id @default(autoincrement())
  name            String
  outputProductId Int
  outputProduct   InvProduct   @relation("BomOutput", fields: [outputProductId], references: [id])
  /// Reference output qty for the recipe (e.g. "5 kg flour produces 10 loaves" → outputQty = 10).
  outputQty       Decimal      @db.Decimal(10, 3)
  description     String?
  isActive        Boolean      @default(true)
  lines           InvBomLine[]
  vouchers        InvVoucher[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([outputProductId])
  @@index([isActive])
}

model InvBomLine {
  id        Int        @id @default(autoincrement())
  bomId     Int
  bom       InvBom     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  productId Int
  product   InvProduct @relation("BomConsume", fields: [productId], references: [id])
  /// Qty consumed per the BOM's reference outputQty. Scaled proportionally
  /// when the journal's target output qty differs from the BOM's default.
  qty       Decimal    @db.Decimal(10, 3)

  @@index([bomId])
  @@index([productId])
}

// Phase 4 G4b (2026-06-27): `InvVoucherCharge` + `InvVoucherTender` were RETIRED —
// folded into the universal-voucher spine. Their INPUT now lives in
// `InvVoucher.settlementJson` (re-rendered for edit); on POST the GL builder
// emits role=TENDER / role=CHARGE/SHIPPING/DISCOUNT/ROUNDOFF `VoucherGlLine`
// rows, which every money/reporting reader uses. Tender method/reference live on
// the role=TENDER GL line.

// ── Strategy points (additive-margin model — the single pricing engine) ──────
//
// A single org-wide additive-margin configuration. Every dimension value gets a
// points number, and a product's margin% is the SUM of the points of the values
// it falls under: base + brand + category + group [+ stock/age/movement band].
//   price = cost × (1 + margin/100)        (margin on cost; MRP ignored)
// One row per (dimension, refKey):
//   • BASE                      → refKey "" (single baseline row)
//   • BRAND / CATEGORY / GROUP  → refKey = the master id as a string ("3")
//   • STOCK_BAND/AGE_BAND/MOVE_BAND → refKey = the band key ("stock-out", …)
// Singleton config — no name/priority (only one points set for now). Zero-point
// values are simply absent (a missing row means 0).
model StrategyPoint {
  id        Int                    @id @default(autoincrement())
  dimension StrategyPointDimension
  refKey    String                 @default("")
  points    Decimal                @default(0) @db.Decimal(8, 2)
  updatedAt DateTime               @updatedAt

  @@unique([dimension, refKey])
  @@map("strategy_points")
}

// ── Additional cost allocation (pricing-strategy decision-support layer) ──────
// Attributes already-booked shipping/courier expense to products for PRICING and
// sale-margin display — WITHOUT ever posting to the GL. Each row draws a slice
// from one specific POSTED debit (`sourceJournalLine`, a leaf ledger under
// OrgDefaults.shippingPoolGroup). A single courier bill is split into:
//   • ALLOCATION rows → a per-unit surcharge added to a product's pricing cost.
//   • DISMISSAL rows  → written off as office expense (leaves the waiting list).
// Per source entry: Σ(amountPaise) consumed; remaining = lineAmount − Σ.
// Current per-product additional cost is DERIVED (latest-inward ALLOCATION's
// perUnitPaise) — see getCurrentAdditionalCostByProduct in costPool.ts.
// amountPaise / perUnitPaise are integer paise (GST-EXCLUSIVE), matching the
// effectiveSalePricePaise / mrpPaise convention.
model AdditionalCostAllocation {
  id                  Int                          @id @default(autoincrement())
  kind                AdditionalCostAllocationKind
  // Phase 4 G2: the specific POSTED debit this row consumes — now the spine
  // `VoucherGlLine` (re-homed off the legacy `JournalLine`). Cascades if the line
  // is ever hard-deleted; soft-cancelled entries are filtered out at read time.
  sourceVoucherGlLineId Int?
  sourceVoucherGlLine   VoucherGlLine?             @relation(fields: [sourceVoucherGlLineId], references: [id], onDelete: Cascade)
  amountPaise         Int
  // ALLOCATION-only fields (null on DISMISSAL):
  productId           Int?
  product             InvProduct?                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  perUnitPaise        Int?
  quantity            Decimal?                     @db.Decimal(14, 3)
  // The PURCHASE/GRN voucher this allocation was spread from (the "source
  // document"). Lets the history list group rows into a voucher-like document.
  // Null for dismissals / ad-hoc rows. Phase 5 5B: points at the UniversalVoucher
  // spine (the document), not InvVoucher.
  sourceUniversalVoucherId Int?
  sourceUniversalVoucher   UniversalVoucher?       @relation("SpineAdditionalCostAllocations", fields: [sourceUniversalVoucherId], references: [id], onDelete: SetNull)
  note                String?
  date                DateTime                     @db.Date
  createdById         Int
  createdBy           User                         @relation("AdditionalCostAllocationCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime                     @default(now())

  @@index([sourceVoucherGlLineId])
  @@index([productId, createdAt])
  @@index([sourceUniversalVoucherId])
  @@index([kind])
  @@map("additional_cost_allocations")
}
