// ── Bill / receipt messages to the customer (WhatsApp + app push) ─────────────
//
// WhatsAppTemplate is the WhatsApp twin of VoucherPrintTemplate: one row per
// message kind, edited at /office/settings/whatsapp-templates. Unlike a print
// template the wording cannot be used until Meta approves it, so the row keeps
// the draft AND the last approved copy — bills keep going out on the approved
// one while an edit waits. See src/shared/lib/whatsapp/billTemplates.ts.
//
// BillNotification is one row per bill/receipt we told the customer about:
// whether the app notification was sent (and shown — PushMessage.shownAt) and
// whether the WhatsApp went. Owner's call 2026-10-06: BOTH go every time for
// now; the shown/not-shown numbers decide later whether WhatsApp can be skipped.

/// One WhatsApp message kind ("SALE" | "RECEIPT"). `body` uses friendly fields
/// ({customer}, {billNo}, …) which billTemplates.ts turns into Meta's {{1}} slots.
model WhatsAppTemplate {
  kind          String    @id
  /// Staff's own name for a custom template (kind CUSTOM_<id>); null = built-in.
  name          String?
  enabled       Boolean   @default(false)
  /// Send by itself when the document is saved. Off = only staff's "Send on
  /// WhatsApp" (3-dot menu). Estimates start off (billTemplates WA_AUTO_SEND_DEFAULT).
  autoSend      Boolean   @default(true)
  body          String
  /// Text of the "View bill" URL button; null = no button.
  viewButton    String?
  /// Text of the "Get our app" URL button; null = no button.
  appButton     String?
  /// DRAFT (edited, not sent) | PENDING (with Meta) | APPROVED | REJECTED
  status        String    @default("DRAFT")
  /// Name of the copy last sent to Meta — `<kind>_bill_v<version>`.
  metaName      String?
  metaId        String?
  rejectReason  String?
  version       Int       @default(0)
  submittedAt   DateTime?
  /// The last copy Meta approved — what bills are actually sent with.
  approvedName  String?
  approvedBody  String?
  approvedView  String?
  approvedApp   String?
  approvedAt    DateTime?
  updatedAt     DateTime  @default(now()) @updatedAt
}

/// One document announced to its customer — once per (kind, refId). `refId` is
/// the UniversalVoucher id, or the Ticket id for the REPAIR_* kinds.
model BillNotification {
  id             Int       @id @default(autoincrement())
  kind           String
  refId          Int
  personId       Int?
  mobile         String?
  /// sent | no-subscription | failed | not-configured | no-person
  pushStatus     String
  pushMessageId  String?
  /// sent | failed | not-configured | disabled | no-mobile
  waStatus       String
  waMessageId    String?
  waError        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@unique([kind, refId])
  @@index([personId, createdAt])
}

// ── Bill / receipt emails to the customer ─────────────────────────────────────
//
// EmailTemplate is the email twin of WhatsAppTemplate: one row per document kind,
// edited at /office/settings/email-templates. No approval step — the saved copy
// is the one sent. Same friendly fields ({customer}, {billNo}, …) as WhatsApp.
// EmailNotification is one row per (kind, refId) emailed — claimed before
// sending so a customer never gets two; a failed row is retried on the next
// try. refId = UniversalVoucher id, Ticket id (repair, payment pending),
// DueReminderLog id, ShopCart id, or Person id (welcome).
// See src/shared/lib/email/notifyEmail.ts.

/// One email kind ("SALE" | "CART_ABANDONED" | …). A missing row = the code default, off.
model EmailTemplate {
  kind      String   @id
  /// Staff's own name for a custom template (kind CUSTOM_<id>); null = built-in.
  name      String?
  enabled   Boolean  @default(false)
  /// Send by itself when the document is posted. Off = only staff's "Send email".
  autoSend  Boolean  @default(true)
  subject   String
  body      String
  updatedAt DateTime @default(now()) @updatedAt
}

/// One email sent — once per (kind, refId); see the note above for what refId is.
model EmailNotification {
  id        Int      @id @default(autoincrement())
  kind      String
  refId     Int
  email     String?
  /// pending | sent | failed | not-configured | no-email
  status    String
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([kind, refId])
}

/// A signed-in customer's shop / app cart, copied up from their device so the
/// hourly job can see an abandoned one (the device keeps its own copy). Deleted
/// when the cart is emptied — checkout empties it — so a new cart is a new row
/// (new id) and gets its own one reminder (EmailNotification refId = id).
model ShopCart {
  id        Int      @id @default(autoincrement())
  personId  Int      @unique
  /// [{ productId, quantity }] — as the device holds it.
  lines     Json
  createdAt DateTime @default(now())
  /// Moves only when the lines change, never on a same-cart page load.
  updatedAt DateTime @default(now()) @updatedAt

  @@index([updatedAt])
}

/// An email address that unsubscribed from marketing emails (abandoned cart,
/// welcome). Bills, receipts, repairs and dues still go.
model EmailOptOut {
  email     String   @id
  createdAt DateTime @default(now())
}

// ── Due reminders ────────────────────────────────────────────────────────────
//
// A party's whole balance due, sent by hand (Receivables → Send), to many at once
// (Send to all) or by the daily job when a rule matches. Edited at
// /office/campaigns/due-reminders; wording is the DUE_SOFT / DUE_FIRM templates.
// See src/shared/lib/whatsapp/dueReminders.ts.

/// Singleton (id = 1). The automation switch and its limits.
model DueReminderSettings {
  id          Int      @id @default(1)
  /// The daily job sends nothing while this is off.
  enabled     Boolean  @default(false)
  /// "HH:MM" India time — the job sends on its first run at or after this.
  sendTime    String   @default("10:00")
  /// Weekdays not to send on, 0 = Sunday … 6 = Saturday.
  skipDays    Int[]    @default([5])
  /// Most automatic reminders in one day.
  dailyCap    Int      @default(50)
  /// Skip a party whose balance is below this (rupees).
  minBalance  Decimal  @default(100) @db.Decimal(14, 2)
  /// Skip a party owing less than this % of its auto credit limit (0 = off).
  minPctAutoLimit   Int @default(0)
  /// Skip a party owing less than this % of its manual credit limit (0 = off).
  minPctCreditLimit Int @default(0)
  /// Account ids never reminded — automation and Send to all skip them.
  excludedAccountIds Int[] @default([])
  /// India date ("YYYY-MM-DD") the job last ran — once a day.
  lastRunDate String?
  updatedAt   DateTime @default(now()) @updatedAt
}

/// One automation rule: oldest unpaid bill ≥ minDays AND balance ≥ minAmount.
/// The strongest matching rule (highest minDays) wins for a party.
model DueReminderRule {
  id          Int      @id @default(autoincrement())
  name        String
  minDays     Int
  minAmount   Decimal  @db.Decimal(14, 2)
  /// 0 = once per rule until the balance clears; N = again every N days.
  repeatDays  Int      @default(0)
  /// SOFT | FIRM | CALL_LIST (no message — on the owner's call list).
  action      String
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

/// One reminder sent (or put on the call list) to one party.
model DueReminderLog {
  id            Int      @id @default(autoincrement())
  accountId     Int
  partyName     String
  personId      Int?
  amount        Decimal  @db.Decimal(14, 2)
  /// SOFT | FIRM | CALL_LIST
  action        String
  /// MANUAL | ALL | AUTO
  mode          String
  ruleId        Int?
  mobile        String?
  /// Same words as BillNotification.
  pushStatus    String
  waStatus      String
  waMessageId   String?
  waError       String?
  /// Staff who pressed Send; null for the daily job.
  sentById      Int?
  createdAt     DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([createdAt])
}
