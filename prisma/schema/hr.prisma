// ── HR & People ───────────────────────────────────────────────────────────────
// Staff = User + HR rows (decided 2026-09-18). There is no separate employee
// entity: the person who signs in, holds a seat and opens a shift IS the person
// HR keeps a record of. A helper who never logs in still gets a User row.
//
//   StaffProfile — the HR side of a User: employment dates, personal / KYC,
//                  bank, and the two ledger links. One row per User, created the
//                  first time HR saves anything about them.
//   StaffSalary  — dated salary revisions. The structure in force on a date is
//                  the latest row with effectiveFrom <= date, so a later payroll
//                  run can compute any past month exactly.
//
// Both replicate to every counter like every other table (owner, 2026-09-20:
// no extra restriction — the app is to be secured as a whole later). The one
// sync note: StaffProfile is pinned to `watermark` in prisma/sync-tables.json,
// because its only cascade parent is User and a child would be pulled only when
// the User row moved — an edit to `leftOn` never touches User.updatedAt, and a
// counter must refuse a left person promptly, line down or not.

model StaffProfile {
  userId Int  @id
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Free text ("EMP-001"); unique when set. No series — a staff id is typed once.
  staffCode      String?   @unique
  joinedOn       DateTime? @db.Date
  /// No sign-in from this date (inclusive). Null = current staff. Set through the
  /// HR profile's "Mark as left", which also vacates the seats and signs out every
  /// open session; the User row itself is never deleted by HR.
  leftOn         DateTime? @db.Date
  leftReason     String?
  /// FULL_TIME | PART_TIME | HELPER | CONTRACT — a plain string, validated by zod.
  /// Not an enum: a new kind would need its own migration file (ADD VALUE cannot
  /// be used in the transaction that adds it).
  employmentType String    @default("FULL_TIME")
  /// 0 = Sunday … 6 = Saturday, the BackupConfig.weekdays convention. The
  /// attendance phase reads it; nothing in phase 1 does.
  weeklyOff      Int[]     @default([0])
  /// A full day's duty for THIS person, in minutes. Null = the org default
  /// (shared/lib/hr/dutyTime.ts). A part-timer on a four-hour duty who works all
  /// four has done a full day, which a fixed hour rule would call a half.
  dutyMinutes    Int?
  /// Office hours for THIS person, "HH:MM" in shop time. They say who is late,
  /// and their length IS the duty day unless dutyMinutes above overrides it (for
  /// an unpaid break). Null = the shop's default, shared/lib/hr/dutyTime.ts.
  dutyStart      String? @db.VarChar(5)
  dutyEnd        String? @db.VarChar(5)
  /// Minutes away from the app before this person is signed out — and before the
  /// gap stops counting as duty. Null = the default (45). A counter manager needs
  /// a short one, a technician a long one; one number cannot serve both. Capped
  /// at the session backstop, shared/lib/hr/dutyTime.ts.
  idleLimitMinutes Int?

  // Personal / KYC — edited on the person's own profile page (self or admin).
  fatherName     String?
  address        String?
  bloodGroup     String?
  emergencyName  String?
  emergencyPhone String?
  /// Only the last four digits are ever stored.
  aadhaarLast4   String? @db.VarChar(4)
  panNumber      String? @db.VarChar(10)
  uanNumber      String? @db.VarChar(12)
  esiNumber      String? @db.VarChar(17)
  /// The same six-field bag as Person.bankJson — how WE pay THEM. Shape in
  /// src/shared/lib/parties/partyBank.ts.
  bankJson       Json?
  notes          String?

  // Books. One ledger per person, and it is a LIABILITY: their own account under
  // "Salary Payable" (under Current Liabilities). Salary accrues INTO it, every
  // advance and payment goes OUT of it, so its balance always reads "owed to
  // them" (Cr) or "advance outstanding" (Dr). Created with the profile, on the
  // first save.
  //
  // There is deliberately NO per-person expense account (owner, 2026-09-20:
  // "exp account is common to all"). The Dr side of a payroll journal is one
  // org-wide salary expense ledger, held on PayrollRun, because "what did labour
  // cost the business" is a P&L question and 300 staff must not become 300 lines
  // in it.
  ledgerAccountId  Int?     @unique
  ledgerAccount    Account? @relation("StaffLedger", fields: [ledgerAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
  salaries  StaffSalary[]
  commissionOverrides CommissionOverride[]

  @@index([leftOn])
  @@index([updatedAt])
  @@map("staff_profiles")
}

// One salary revision. Money is paise (Int), exact in JSON — the GL is rupees
// and the conversion happens once, when a payroll run posts.
model StaffSalary {
  id      Int          @id @default(autoincrement())
  userId  Int
  profile StaffProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  /// First day this structure applies. Two revisions cannot start on the same day.
  effectiveFrom DateTime @db.Date
  /// How many days a month this salary buys — the government's 26, editable per
  /// revision because a contract may say otherwise. ONE DAY = pay head / payDays,
  /// and the month pays for its own working days (weekly offs excluded), so a
  /// 27-working-day January pays more than a 24-day February on the same
  /// structure. It is also the divisor behind the hourly rate that prices
  /// overtime: (gross / payDays) / duty hours. Frozen onto a payroll run when it
  /// generates, like every other figure there.
  payDays       Int      @default(26)
  /// [{ name, kind: "EARNING" | "DEDUCTION", amountPaise }] — read whole, never queried.
  linesJson     Json
  /// Sum of EARNING lines, denormalised so the directory never parses JSON.
  grossPaise    Int
  /// gross − DEDUCTION lines.
  netPaise      Int
  note          String?
  /// Scalar snapshot, no FK — like UniversalVoucher.createdById.
  createdById   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([userId, effectiveFrom])
  @@index([updatedAt])
  @@map("staff_salaries")
}

// ── Payroll ───────────────────────────────────────────────────────────────────
// A run covers a DATE RANGE, not a calendar month (owner, 2026-09-20: "the total
// from last payroll to till day"). The next run starts the day after the last
// one ended, so the periods form an unbroken chain and no day is ever paid
// twice — the overlap check in payrollServer.ts is what enforces that, since a
// range cannot be made unique by the database the way a month could.
//
// Amounts are proportioned by WORKING DAYS: a monthly structure is worth
// amount / StaffSalary.payDays (26 by default, the government month) for each
// working day the person was employed inside the period — their weekly offs are
// not counted, being already paid for inside the 26. That needs only dates and
// the weekly-off pattern, no attendance. Creating a run FREEZES the result, so a
// salary revised later can never change what was already paid.
//
// Posting turns the run into ONE journal voucher: a credit to each person's own
// ledger (their net), and debits to the salary expense ledgers, grouped — the
// P&L should read "Salary & Wages 12,40,000", not three hundred lines.

model PayrollRun {
  id Int @id @default(autoincrement())

  /// First day this run pays for — the day after the previous run ended.
  periodFrom DateTime @db.Date
  /// Last day this run pays for, inclusive. "Till day" — usually today.
  periodTo   DateTime @db.Date
  /// The date the journal carries. `periodTo` unless changed.
  postingDate DateTime @db.Date

  /// The ONE ledger this run's salary is booked against — the Dr side of the
  /// whole journal. Resolved when the run is generated and frozen with it, so a
  /// later change of the org's salary ledger cannot rewrite what was posted.
  expenseAccountId Int?
  expenseAccount   Account? @relation("PayrollExpense", fields: [expenseAccountId], references: [id], onDelete: SetNull)
  /// DRAFT | POSTED | CANCELLED. A plain string for the same reason as
  /// StaffProfile.employmentType — a new state must not need an enum migration.
  status      String   @default("DRAFT")

  /// The journal voucher this run posted.
  ///
  /// A real relation, but `onDelete: SetNull` — never Cascade. Deleting the
  /// journal must not take the payroll history with it; it only breaks the
  /// pointer. `voucherRef` is a plain string and is deliberately NOT cleared
  /// with it, so a run whose voucher is gone still says which one it was:
  /// `voucherId` null + `voucherRef` set IS the "voucher removed" state the
  /// screens warn about. The relation exists so the list can read the
  /// voucher's own status in the same query — a posted run must never look
  /// clean when its journal has been cancelled or deleted.
  voucherId  Int?
  voucher    UniversalVoucher? @relation("PayrollVoucher", fields: [voucherId], references: [id], onDelete: SetNull)
  voucherRef String?

  note String?

  // Denormalised totals of the INCLUDED lines, in paise.
  grossPaise      Int @default(0)
  deductionsPaise Int @default(0)
  netPaise        Int @default(0)
  /// How many people the run actually pays (included lines).
  headcount       Int @default(0)

  createdById Int
  postedById  Int?
  postedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  lines PayrollRunLine[]

  @@index([status])
  @@index([expenseAccountId])
  @@index([voucherId])
  @@index([periodFrom])
  @@index([periodTo])
  @@index([updatedAt])
  @@map("payroll_runs")
}

// One person's salary for one month, as it stood when the run was generated.
model PayrollRunLine {
  id    Int        @id @default(autoincrement())
  runId Int
  run   PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  userId Int
  /// The name at the time of the run — a person can be renamed afterwards.
  staffName String

  /// The revision the amounts came from. Scalar snapshot, no FK: deleting a
  /// revision must never rewrite a posted month.
  salaryId      Int?
  effectiveFrom DateTime? @db.Date
  /// The salary lines, copied whole — the payslip reads from here, not from
  /// StaffSalary, so it prints the same thing in ten years.
  linesJson     Json

  grossPaise      Int @default(0)
  deductionsPaise Int @default(0)
  netPaise        Int @default(0)

  /// How the proportion was arrived at, kept so the sheet and a payslip can
  /// show "18 of 26 days" without recomputing it from dates that may have moved.
  /// `paidDays` counts WORKING days only — a weekly off is not a paid day of its
  /// own any more, it is already inside the 26. `payDays` is the divisor the
  /// revision carried at generation time.
  paidDays   Int @default(0)
  periodDays Int @default(0)
  payDays    Int @default(26)

  /// The person's own liability ledger, as resolved at generation time. Null
  /// only on a line that is not included — having no ledger is exactly why it
  /// cannot be. The expense side is not here: it is one ledger for the whole
  /// run, on PayrollRun.
  ledgerAccountId Int?

  /// Commission earned in this period, frozen like every other figure here.
  ///
  /// Owner, 2026-09-22: *"make room for commission in hr module, commission
  /// calculation will be in commission page where verity of commission may be
  /// created."* So this is ROOM, not a rule. HR does not decide who earns
  /// commission or how much — a Commission page, not yet built, will answer
  /// that, and `modules/hr/lib/commission.ts` is the one door it comes through.
  ///
  /// It is NOT a separate amount to be added on: when it is non-zero the
  /// generator ALSO writes a "Commission" EARNING into `linesJson`, so
  /// `grossPaise` and `netPaise` already contain it and the payslip, the print
  /// template and the journal need no special case for any of it. This column
  /// exists only so a sheet can show the commission part without parsing the
  /// JSON — the same reason `grossPaise` is denormalised beside the lines.
  commissionPaise Int @default(0)

  /// The month's attendance, accounted day by day and frozen with the pay —
  /// `PayslipAttendanceData`. The slip prints it under the pay heads so its
  /// Overtime and Hours owed figures explain themselves. Null on a line
  /// generated before this existed; such a slip simply prints without it.
  attendanceJson Json?

  /// The commission, head by head, frozen with the pay — `PayslipCommissionData`
  /// (shared/components/print/PayslipBody.tsx). The slip prints it under the pay
  /// heads so its "Commission" earning explains itself. Null when the period
  /// earned none, or on a line from before this existed.
  commissionJson Json?

  /// Only included lines reach the journal. Untick a person to hold their
  /// salary back; `skipReason` is set by the generator when it cannot pay them.
  included   Boolean @default(true)
  skipReason String?

  @@unique([runId, userId])
  @@index([userId])
  @@map("payroll_run_lines")
}

// ── Targets & Commission ──────────────────────────────────────────────────────
// Owner, 2026-09-22/23: *"earnings, commission, target, etc. need a page to
// set/edit. user need to see it to get motivated."* — *"in set commission page
// is like coupon page here we create different commission or target head its
// not user specific"* — *"user kind applicable"* — *"user wise override %, per
// commission head. user see only applicable to him and globally on."*
//
//   CommissionHead     — the catalogue: one named way of earning (a share of
//                        every sale, a share above a target, slabs, a bonus at
//                        a target), globally on or off, for every role or a
//                        few. Not tied to a person.
//   CommissionOverride — one person's say over one head: their own rate or
//                        bonus in place of the head's, or the head off for them.
//
// A person is judged by the heads that are ON, reach their role, and are not
// off for them — with their override applied. That resolution lives once, in
// modules/hr/lib/commissionServer.ts, and the arithmetic once, in
// shared/lib/hr/commissionScheme.ts, so the board, My Info and payroll agree.
// Payroll freezes the answer, head by head, onto PayrollRunLine.commissionJson
// (and the total on commissionPaise + a "Commission" earning) — editing a head
// later never rewrites a month already paid.
model CommissionHead {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  /// PERCENT | ABOVE_TARGET | SLABS | BONUS — a plain string, validated by zod
  /// (CommissionKind); not an enum, so a new kind needs no ADD VALUE migration.
  kind        String
  /// ABOVE_TARGET / BONUS: the monthly line, paise. 0 elsewhere.
  targetPaise Int     @default(0)
  /// PERCENT / ABOVE_TARGET: basis points, 100 = 1%.
  rateBp      Int     @default(0)
  /// SLABS: [{ fromPaise, rateBp }] ascending. Read whole, never queried.
  slabsJson   Json?
  /// BONUS: the flat amount, paise.
  bonusPaise  Int     @default(0)
  /// Globally on. An off head reaches nobody, whatever the overrides say.
  active      Boolean @default(true)
  /// Role labels (UserRole.label) this head is for. Empty = everyone.
  appliesTo   String[] @default([])
  sortOrder   Int     @default(0)
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  overrides CommissionOverride[]

  @@index([active])
  @@index([updatedAt])
  @@map("commission_heads")
}

model CommissionOverride {
  id      Int            @id @default(autoincrement())
  userId  Int
  profile StaffProfile   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  headId  Int
  head    CommissionHead @relation(fields: [headId], references: [id], onDelete: Cascade)

  /// This person's own rate (share heads), null = the head's.
  rateBp     Int?
  /// This person's own bonus (bonus heads), null = the head's.
  bonusPaise Int?
  /// The head is switched off for this person.
  off        Boolean @default(false)
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([userId, headId])
  @@index([headId])
  @@map("commission_overrides")
}
