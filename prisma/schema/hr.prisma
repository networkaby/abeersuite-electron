// ── HR & People ───────────────────────────────────────────────────────────────
// Staff = User + HR rows (decided 2026-09-18). There is no separate employee
// entity: the person who signs in, holds a seat and opens a shift IS the person
// HR keeps a record of. A helper who never logs in still gets a User row.
//
//   StaffProfile — the HR side of a User: employment dates, personal / KYC,
//                  bank, and the two ledger links. One row per User, created the
//                  first time HR saves anything about them.
//   StaffSalary  — dated salary revisions. The structure in force on a date is
//                  the latest row with effectiveFrom <= date, so a later payroll
//                  run can compute any past month exactly.
//
// Both replicate to every counter like every other table (owner, 2026-09-20:
// no extra restriction — the app is to be secured as a whole later). The one
// sync note: StaffProfile is pinned to `watermark` in prisma/sync-tables.json,
// because its only cascade parent is User and a child would be pulled only when
// the User row moved — an edit to `leftOn` never touches User.updatedAt, and a
// counter must refuse a left person promptly, line down or not.

model StaffProfile {
  userId Int  @id
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Free text ("EMP-001"); unique when set. No series — a staff id is typed once.
  staffCode      String?   @unique
  joinedOn       DateTime? @db.Date
  /// No sign-in from this date (inclusive). Null = current staff. Set through the
  /// HR profile's "Mark as left", which also vacates the seats and signs out every
  /// open session; the User row itself is never deleted by HR.
  leftOn         DateTime? @db.Date
  leftReason     String?
  /// FULL_TIME | PART_TIME | HELPER | CONTRACT — a plain string, validated by zod.
  /// Not an enum: a new kind would need its own migration file (ADD VALUE cannot
  /// be used in the transaction that adds it).
  employmentType String    @default("FULL_TIME")
  /// 0 = Sunday … 6 = Saturday, the BackupConfig.weekdays convention. The
  /// attendance phase reads it; nothing in phase 1 does.
  weeklyOff      Int[]     @default([0])

  // Personal / KYC — edited on the person's own profile page (self or admin).
  fatherName     String?
  address        String?
  bloodGroup     String?
  emergencyName  String?
  emergencyPhone String?
  /// Only the last four digits are ever stored.
  aadhaarLast4   String? @db.VarChar(4)
  panNumber      String? @db.VarChar(10)
  uanNumber      String? @db.VarChar(12)
  esiNumber      String? @db.VarChar(17)
  /// The same six-field bag as Person.bankJson — how WE pay THEM. Shape in
  /// src/shared/lib/parties/partyBank.ts.
  bankJson       Json?
  notes          String?

  // Books. `ledgerAccount` is this person's own ledger under "Salary Payable"
  // (LIABILITY, under Current Liabilities): the Cr side of a future payroll
  // journal, and the account every advance and salary payment goes through, so
  // its balance always reads "owed to them" (Cr) or "advance outstanding" (Dr).
  // Created with the profile, on the first save. `expenseAccount` is the Dr side
  // of that journal; null means the org's "Salary & Wages" ledger, and the four
  // people who already have a "<Name> Salary" expense ledger simply pick it here.
  ledgerAccountId  Int?     @unique
  ledgerAccount    Account? @relation("StaffLedger", fields: [ledgerAccountId], references: [id], onDelete: SetNull)
  expenseAccountId Int?
  expenseAccount   Account? @relation("StaffSalaryExpense", fields: [expenseAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
  salaries  StaffSalary[]

  @@index([leftOn])
  @@index([expenseAccountId])
  @@index([updatedAt])
  @@map("staff_profiles")
}

// One salary revision. Money is paise (Int), exact in JSON — the GL is rupees
// and the conversion happens once, when a payroll run posts.
model StaffSalary {
  id      Int          @id @default(autoincrement())
  userId  Int
  profile StaffProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  /// First day this structure applies. Two revisions cannot start on the same day.
  effectiveFrom DateTime @db.Date
  /// [{ name, kind: "EARNING" | "DEDUCTION", amountPaise }] — read whole, never queried.
  linesJson     Json
  /// Sum of EARNING lines, denormalised so the directory never parses JSON.
  grossPaise    Int
  /// gross − DEDUCTION lines.
  netPaise      Int
  note          String?
  /// Scalar snapshot, no FK — like UniversalVoucher.createdById.
  createdById   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([userId, effectiveFrom])
  @@index([updatedAt])
  @@map("staff_salaries")
}

// ── Payroll ───────────────────────────────────────────────────────────────────
// A run covers a DATE RANGE, not a calendar month (owner, 2026-09-20: "the total
// from last payroll to till day"). The next run starts the day after the last
// one ended, so the periods form an unbroken chain and no day is ever paid
// twice — the overlap check in payrollServer.ts is what enforces that, since a
// range cannot be made unique by the database the way a month could.
//
// Amounts are proportioned by DAYS: a monthly structure is worth
// amount / days-in-that-month for each day the person was employed inside the
// period. That needs only dates, no attendance. Creating a run FREEZES the
// result, so a salary revised later can never change what was already paid.
//
// Posting turns the run into ONE journal voucher: a credit to each person's own
// ledger (their net), and debits to the salary expense ledgers, grouped — the
// P&L should read "Salary & Wages 12,40,000", not three hundred lines.

model PayrollRun {
  id Int @id @default(autoincrement())

  /// First day this run pays for — the day after the previous run ended.
  periodFrom DateTime @db.Date
  /// Last day this run pays for, inclusive. "Till day" — usually today.
  periodTo   DateTime @db.Date
  /// The date the journal carries. `periodTo` unless changed.
  postingDate DateTime @db.Date
  /// DRAFT | POSTED | CANCELLED. A plain string for the same reason as
  /// StaffProfile.employmentType — a new state must not need an enum migration.
  status      String   @default("DRAFT")

  /// The journal voucher this run posted. Scalar snapshot, no FK (like
  /// StaffSalary.createdById): cancelling the voucher must not cascade to the
  /// run's history. `voucherRef` is the JV-… number, so the list needs no join.
  voucherId  Int?
  voucherRef String?

  note String?

  // Denormalised totals of the INCLUDED lines, in paise.
  grossPaise      Int @default(0)
  deductionsPaise Int @default(0)
  netPaise        Int @default(0)
  /// How many people the run actually pays (included lines).
  headcount       Int @default(0)

  createdById Int
  postedById  Int?
  postedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  lines PayrollRunLine[]

  @@index([status])
  @@index([periodFrom])
  @@index([periodTo])
  @@index([updatedAt])
  @@map("payroll_runs")
}

// One person's salary for one month, as it stood when the run was generated.
model PayrollRunLine {
  id    Int        @id @default(autoincrement())
  runId Int
  run   PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  userId Int
  /// The name at the time of the run — a person can be renamed afterwards.
  staffName String

  /// The revision the amounts came from. Scalar snapshot, no FK: deleting a
  /// revision must never rewrite a posted month.
  salaryId      Int?
  effectiveFrom DateTime? @db.Date
  /// The salary lines, copied whole — the payslip reads from here, not from
  /// StaffSalary, so it prints the same thing in ten years.
  linesJson     Json

  grossPaise      Int @default(0)
  deductionsPaise Int @default(0)
  netPaise        Int @default(0)

  /// How the proportion was arrived at, kept so the sheet and a payslip can
  /// show "18 of 30 days" without recomputing it from dates that may have moved.
  paidDays   Int @default(0)
  periodDays Int @default(0)

  /// The two ledgers as resolved at generation time. Null only on a line that
  /// is not included (no ledger is exactly why it cannot be).
  ledgerAccountId  Int?
  expenseAccountId Int?

  /// Only included lines reach the journal. Untick a person to hold their
  /// salary back; `skipReason` is set by the generator when it cannot pay them.
  included   Boolean @default(true)
  skipReason String?

  @@unique([runId, userId])
  @@index([userId])
  @@map("payroll_run_lines")
}
