// ── HR & People — attendance, holidays, leave ────────────────────────────────
// Owner, 2026-09-18: attendance is AUTO from the counter sign-in, plus an office
// register for everyone else and for corrections. So a day is written by two
// hands: the till (first sign-in of the business day = PRESENT with the in
// time; the shift close stamps the out time) and HR (the register, click to
// mark). A stored row is the truth for that day; a day with no row is READ off
// the calendar — weekly off (StaffProfile.weeklyOff), a Holiday, an approved
// leave, or simply unmarked.
//
// All three tables replicate like everything else. AttendanceDay is written ON
// the till at sign-in, so it has to ride the outbox up — it does, by default.

model AttendanceDay {
  id     Int @id @default(autoincrement())
  userId Int
  user   User @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  /// The business day (shop calendar), never the server's UTC day.
  date DateTime @db.Date
  /// PRESENT | HALF_DAY | ABSENT | LEAVE | WEEKLY_OFF | HOLIDAY — a plain string,
  /// validated by zod. Stored only when someone or something marked it; the
  /// calendar answers for the rest.
  status String
  /// COUNTER — the till wrote it at sign-in. OFFICE — the register or a leave approval.
  source String @default("OFFICE")
  /// First sign-in on a counter that day; last shift close. Informational.
  firstInAt DateTime?
  lastOutAt DateTime?
  /// The last sign of life on that day — a real click or keypress, not a poll.
  /// The accumulator below measures against it; see shared/lib/hr/dutyTime.ts.
  lastSeenAt DateTime?
  /// Minutes ACTUALLY worked, added up span by span. Idle stretches longer than
  /// the logout limit contribute nothing, so a forgotten sign-out costs nothing
  /// and is not paid either. Drives the full / half grade and payroll's 0.5.
  workedMinutes Int @default(0)
  counterId Int?
  note      String?
  /// Who marked it from the office; null when the till did.
  markedById Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([updatedAt])
  @@map("attendance_days")
}

// A shop holiday. `branchId` null = every branch.
model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  name      String
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([date, name])
  @@index([date])
  @@index([updatedAt])
  @@map("holidays")
}

// A leave request. Approval writes LEAVE onto every day in the range (the
// register then shows it); rejection or cancellation clears those days again.
model LeaveRequest {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation("LeaveUser", fields: [userId], references: [id], onDelete: Cascade)
  fromDate DateTime @db.Date
  toDate   DateTime @db.Date
  /// CASUAL | SICK | EARNED | UNPAID — plain string, validated by zod.
  kind   String @default("CASUAL")
  reason String?
  /// PENDING | APPROVED | REJECTED | CANCELLED
  status      String    @default("PENDING")
  decidedById Int?
  decidedAt   DateTime?
  decisionNote String?
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([userId, fromDate])
  @@index([status])
  @@index([updatedAt])
  @@map("leave_requests")
}

// A kind of leave, and how much of it a person gets in a leave year.
//
// Owner, 2026-09-22, asked "how many leave each type, where to set?" — until now
// the four kinds were a hardcoded list with no limit on any of them, so CASUAL and
// EARNED differed only by the word printed in the Kind column. This table is the
// answer: the kinds become master data, each carrying its own yearly quota.
//
// `code` is what LeaveRequest.kind stores, so the existing rows keep working — the
// four are seeded with exactly the codes already in use. A NULL `yearlyQuota` means
// "no limit", which is what EARNED and UNPAID carry for now (the owner parked the
// earned-leave policy). Going over a quota never blocks: the apply box warns and
// HR still decides, and the days beyond the quota are treated as unpaid.
//
// The balance is NOT stored. It is counted from the approved requests inside the
// leave year, the same rule the chart of accounts follows — a stored balance is one
// more thing that can drift from the rows it claims to summarise.
model LeaveType {
  id   Int    @id @default(autoincrement())
  /// CASUAL | SICK | EARNED | UNPAID — matches LeaveRequest.kind.
  code String @unique
  name String
  /// Whether a day of this kind is paid. Only UNPAID is false today.
  paid Boolean @default(true)
  /// Days allowed in a leave year. NULL = no limit.
  yearlyQuota Int?
  /// Reserved: unused days rolling into the next year. Off for every type until
  /// the owner settles the policy; `carryCap` is the ceiling when it is switched on.
  carryForward Boolean @default(false)
  carryCap     Int?
  /// Days of notice a request of this kind must carry. NULL = follow the shop rule.
  /// Sick leave carries 0 — you cannot give three days' notice of a fever.
  ///
  /// NOT READ YET. The notice rule currently lives in code, in
  /// shared/lib/schemas/hrAttendanceSchema.ts (LEAVE_NOTICE_DAYS + the exempt
  /// kinds), and that is still the one source. This column is where it should
  /// move so the rule stops being a constant — until it does, nothing on screen
  /// offers to set it, because two boxes for one rule is how they drift apart.
  noticeDays Int?
  sortOrder  Int     @default(0)
  active     Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([updatedAt])
  @@map("leave_types")
}

/// ONE ACTIVE STRETCH of a working day — in at 10:30, gone by 14:00.
///
/// Owner, 2026-09-22: *"we need to know how many time he/she was active, how the
/// day is calculated, hour breakup user wise day wise."* None of that could be
/// answered before, and not for want of a screen: `AttendanceDay.workedMinutes`
/// is a running TOTAL, and a total cannot be taken apart again. 490 minutes says
/// nothing about whether it was one stretch or five, when they were, or which
/// till they were on. So the stretches are stored as they happen.
///
/// The rule is the one already in `creditableMinutes` and not a new one: each
/// sign of life extends the open span, and a gap longer than the person's idle
/// limit means they were NOT here — that span is closed off at its last sign of
/// life and a fresh one begins. The idle gap itself is stored nowhere, because it
/// is not time; it is simply the space between two spans, and the day's breakup
/// reads it as the difference.
///
/// These rows are a LEDGER of the same minutes `AttendanceDay.workedMinutes`
/// carries as a balance, and the two must agree: the spans of a day sum to it.
/// The day row stays the one the register, grading and payroll read, so nothing
/// that works today depends on this table being right — it only ever explains.
model AttendanceSpan {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation("AttendanceSpanUser", fields: [userId], references: [id], onDelete: Cascade)
  /// The business day this stretch belongs to — the same day key as
  /// AttendanceDay, so the two join without any date arithmetic.
  date DateTime @db.Date
  /// The first sign of life in this stretch, and the last. `endedAt` is null
  /// while the stretch is still running — that is the open span the next pulse
  /// extends, and there is at most one per person per day.
  startedAt DateTime
  endedAt   DateTime?
  /// Minutes credited so far, kept in step with the two clocks above rather than
  /// derived at read time: the span's credit is capped by the idle limit in
  /// places, and re-deriving it from the ends would quietly pay for a gap the
  /// stamping already refused.
  minutes Int @default(0)
  /// Where it was worked. Plain Int like AttendanceDay.counterId — no FK, so a
  /// retired till never takes attendance history with it.
  counterId Int?
  /// How the stretch finished, for the breakup's "why it ended" column:
  /// IDLE — the gap to the next sign of life exceeded the idle limit.
  /// SIGNED_OUT — the person signed out themselves.
  /// SHIFT_CLOSED — the till's shift close ended the day.
  /// OPEN — still running; null `endedAt` always carries this.
  endedBy String @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId, date])
  @@index([date])
  @@index([updatedAt])
  @@map("attendance_spans")
}
