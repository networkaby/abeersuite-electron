generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Identity models ───────────────────────────────────────────────────────────
//
// Both `Person` and `Company` are kinds of customer. Phones and emails live in
// shared polymorphic child tables (`Phone`, `Email`) — globally unique values,
// owned by exactly one of Person or Company per row.

model Person {
  id            Int       @id @default(autoincrement())
  name          String
  address       String?
  /// Profile photo (Cloudinary URL) the customer uploads from the portal. One
  /// photo per person — the social profile shows this same picture.
  avatarUrl     String?
  agreedToTerms Boolean   @default(false)
  isActive      Boolean   @default(true)
  agreedAt      DateTime?
  createdAt     DateTime  @default(now())
  // Lets the browser's local party replica delta-sync ("what changed since?").
  // Without it a contact edit is invisible to a timestamp query and the only
  // correct sync is re-pulling every customer. `@default(now())` backfills the
  // existing rows on push. Mirrors Account.updatedAt / Company.updatedAt.
  updatedAt     DateTime  @default(now()) @updatedAt

  // ── CRM (contact lifecycle / ownership / tags) ───────────────────────────
  /// HubSpot-style funnel stage for working a big contact list.
  lifecycleStage  ContactLifecycle @default(LEAD)
  /// Owning seat (Position); current holder resolved live via UserPosition.
  ownerPositionId String?
  /// Lightweight free-form tags for segmentation (filter with has/hasSome).
  tags            String[]         @default([])

  // ── Customer Quality (internal-only; the customer must never see these) ──
  /// "No discount" flag — flagged customer bills at barcode price: ALL
  /// automatic benefits (tier discount, coupons, loyalty earn+redeem) are
  /// suppressed server-side, silently, on POS and shop. Hard-coded all-block
  /// for now; a settings toggle may refine the scope later. Toggle UI gated
  /// by customers:edit (same as credit limit).
  noDiscount      Boolean @default(false)
  /// Append-only staff timeline of rating/comment entries — see
  /// QualityLogEntry in src/modules/customer/lib/customerQuality.ts.
  /// Latest "rating" entry = current rating.
  qualityLog      Json    @default("[]")
  /// Marketing segment (Corporate / School / Lawyer …) for product targeting.
  /// New master — NOT the old CRM tags/lifecycleStage.
  customerGroupId Int?
  customerGroup   CustomerGroup? @relation(fields: [customerGroupId], references: [id])

  // ── GST profile (optional; only meaningful for B2B parties) ──────────────
  /// 15-char GSTIN. Indian format: 2 digits state + 10 PAN + entity + Z + check
  gstin             String?
  /// State code (first two digits of GSTIN, also used for place-of-supply)
  gstStateCode      String?
  gstRegType        GstRegType?
  /// Default destination state for couriered B2C sales (place-of-supply
  /// when the voucher's deliveryMode = SHIPPED and the customer has no
  /// GSTIN). Ignored on COUNTER pickups — those use the branch state per
  /// §10(1)(c). Must be a valid 2-char Indian state code.
  shippingStateCode String?

  // ── The party's OWN bank account — how WE pay THEM ───────────────────────
  /// Supplier payout / customer refund particulars, so staff never hunt for an
  /// A/C number at payment time. NOT our shop's bank (that is COMPANY_DETAILS
  /// .bank, printed on vouchers). Shape mirrors Account.bankJson's naming:
  /// { beneficiary, bankName, branch, accountNumber, ifsc, upiVpa }.
  /// `upiVpa` drives the scan-to-pay QR on the party's Bank tab. Null (or a
  /// fully blank form) = not captured. See partyBank.ts for the parser.
  bankJson Json?

  account             Account? // enforced at app level; FK lives on Account.personId
  companies           PersonCompany[]
  portalCredential    PersonPortalCredential?
  socialProfile       CustomerSocialProfile?  @relation("PersonSocialProfile")
  sentConnections     SocialConnection[]      @relation("ConnectionRequester")
  receivedConnections SocialConnection[]      @relation("ConnectionAddressee")
  dealTickets         TicketDeal[] // deals (Ticket flavour "deal") linked to this person
  orderTickets        TicketOrder[] // orders (Ticket flavour "order") linked to this person
  helpTickets         TicketHelp[] // help/enquiry tickets (Ticket flavour "help") linked to this person
  timelineLogs        TicketLog[] // CRM Reconnect notes/calls logged directly on this person
  owner               Position?               @relation("PersonOwnerPosition", fields: [ownerPositionId], references: [id])
  phones              Phone[]
  emails              Email[]

  // Neither the Person↔Company converter nor the duplicate merge (both at
  // /office/settings/customer-tools) leaves a trace here: the Account, contacts,
  // tickets, CRM notes and bill references move to the surviving row inside one
  // transaction and this row is deleted outright. The ledger history lives on
  // the Account, which is why nothing needs keeping.

  // Delta sync asks "any person touched since <ts>?" on every party-replica
  // open. Without this the common answer (none) costs a full table scan,
  // because proving no row matches means visiting all of them.
  @@index([updatedAt])
}

model Company {
  id         Int      @id @default(autoincrement())
  name       String
  address    String?
  companyReg String?
  taxId      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  /// See Person.updatedAt — same purpose, same backfill.
  updatedAt  DateTime @default(now()) @updatedAt

  // ── CRM (contact lifecycle / ownership / tags) — see Person ──────────────
  lifecycleStage  ContactLifecycle @default(LEAD)
  ownerPositionId String?
  tags            String[]         @default([])

  // ── Customer Quality — mirror of Person, see comments there ──────────────
  noDiscount      Boolean @default(false)
  qualityLog      Json    @default("[]")
  customerGroupId Int?
  customerGroup   CustomerGroup? @relation(fields: [customerGroupId], references: [id])

  // ── GST profile ──────────────────────────────────────────────────────────
  /// 15-char GSTIN
  gstin             String?
  gstStateCode      String?
  gstRegType        GstRegType?
  /// Default destination state for couriered B2C sales — see Person.shippingStateCode.
  shippingStateCode String?

  // ── The party's OWN bank account — see Person.bankJson, same shape ───────
  bankJson Json?

  // Tally-style period anchors (per-company; mid-year migration sets these
  // differently — financial year starts 1 Apr but books begin from cutover date)
  financialYearFrom  DateTime? @db.Date
  booksBeginningFrom DateTime? @db.Date

  account      Account? // enforced at app level; FK lives on Account.companyId
  persons      PersonCompany[]
  dealTickets  TicketDeal[] // deals (Ticket flavour "deal") linked to this company
  helpTickets  TicketHelp[] // help/enquiry tickets (Ticket flavour "help") linked to this company
  timelineLogs TicketLog[] // CRM Reconnect notes/calls logged directly on this company
  owner       Position?       @relation("CompanyOwnerPosition", fields: [ownerPositionId], references: [id])
  phones      Phone[]
  emails      Email[]

  /// See Person's @@index([updatedAt]) — same reason.
  @@index([updatedAt])
}

/// Marketing segment master (Corporate / School / Lawyer …) for product
/// targeting and group pricing — internal-only, managed at
/// /office/pricing-strategy/group-pricing (Pricing Strategy → Group pricing).
/// One group per customer via Person/Company.customerGroupId.
model CustomerGroup {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  /// Bumped by every save, rules included — the counter replica pulls this
  /// table whole when its content changes, and its price rules come along.
  updatedAt DateTime  @default(now()) @updatedAt
  persons   Person[]
  companies Company[]

  // ── Group pricing (Pricing Strategy → Group pricing) — POS only ─────────
  /// Which automatic benefits a customer of this group may get on a POS bill.
  /// The customer's own noDiscount flag still blocks all three regardless.
  allowTierDiscount Boolean @default(true)
  allowCoupons      Boolean @default(true)
  allowLoyalty      Boolean @default(true)
  priceRules        CustomerGroupPriceRule[]
}

/// How a customer group is billed on one product group's items (POS only).
enum GroupPriceType {
  /// Line starts at the item's MRP.
  MRP
  /// Line starts at the printed barcode tag price.
  PRINT_PRICE
  /// `pct`% of the profit still left after every other discount is given back.
  PROFIT_SHARE
  /// `pct`% off the price left after every other discount, never below cost.
  REVENUE_DISCOUNT
}

/// One row of a customer group's price list: "Govt Office → Paper → MRP".
/// A rule on a parent product group covers its whole sub-tree; the nearest
/// group wins. productGroupId null = the group's "All items" catch-all row.
/// See src/shared/lib/pricing/groupPricing.ts.
model CustomerGroupPriceRule {
  id              Int              @id @default(autoincrement())
  customerGroupId Int
  customerGroup   CustomerGroup    @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)
  productGroupId  Int?
  productGroup    InvProductGroup? @relation(fields: [productGroupId], references: [id], onDelete: Cascade)
  priceType       GroupPriceType
  /// % for PROFIT_SHARE / REVENUE_DISCOUNT (0–100); null for MRP / PRINT_PRICE.
  pct             Decimal?         @db.Decimal(5, 2)

  @@unique([customerGroupId, productGroupId])
  @@index([productGroupId])
}

/// Contact funnel stage (HubSpot-style) — shared by Person & Company.
enum ContactLifecycle {
  LEAD
  PROSPECT
  CUSTOMER
  INACTIVE
}

model PersonCompany {
  id         Int       @id @default(autoincrement())
  personId   Int
  companyId  Int
  role       String?
  linkedAt   DateTime  @default(now())
  unlinkedAt DateTime?
  person     Person    @relation(fields: [personId], references: [id])
  company    Company   @relation(fields: [companyId], references: [id])

  // The counter's Postgres replica delta-syncs on "what changed since <ts>?".
  // `linkedAt` never moves, so unlinking someone from a company would not reach
  // the replica and the counter would keep showing a contact as employed there.
  // `@default(now())` backfills existing rows on push. See Person.updatedAt above.
  updatedAt  DateTime  @default(now()) @updatedAt

  @@index([personId])
  @@index([companyId])
  @@index([updatedAt])
}

// ── Shared polymorphic contact tables ─────────────────────────────────────────
//
// Each row is owned by exactly one of Person or Company (XOR enforced by:
//   (a) the write helpers on every path (contactWrite.ts), and
//   (b) Postgres CHECKs Phone_owner_xor / Email_owner_xor
//   (("personId" IS NULL) <> ("companyId" IS NULL)) — added by the seed
//   (prisma/seeds/lib/codeOwnedCatalog.ts), not by a migration; a counter
//   replica does not carry them).
// An unknown caller's number lives in the call log (Call.phone), not here.
//
// Global @unique on the value column means no two parties (person OR company)
// can hold the same phone/email. A company "uses" a related person's phone by
// joining through PersonCompany — it never owns a duplicate row.

model Phone {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  personId  Int?
  companyId Int?
  label     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  /// Load-bearing for the counters, not bookkeeping. Without it the sync
  /// registry files this table as `append` on `createdAt` (see
  /// scripts/gen-sync-registry.ts), so a replica receives NEW phones but never
  /// an edited or deleted one — and the hourly reconcile compares an append
  /// table on keys alone, so a corrected number stays wrong at the till forever.
  /// `@default(now())` backfills existing rows on push. See Person.updatedAt.
  updatedAt DateTime @default(now()) @updatedAt
  /// When ownership was proved. Staff-entered contacts are verified on entry
  /// (they met the customer); a portal OTP sets it too. Null only for a contact
  /// the customer typed into the portal without an OTP — POS search still finds
  /// it, but it cannot be primary, sign in by OTP, or reset the password.
  verifiedAt DateTime?

  person  Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([companyId])
  /// Backs the watermark pull: "anything since <ts>?" must not scan the table
  /// to answer no.
  @@index([updatedAt])
}

model Email {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  personId  Int?
  companyId Int?
  label     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  /// See Phone.updatedAt — same reason, same backfill.
  updatedAt DateTime @default(now()) @updatedAt
  /// When ownership was proved. Staff-entered contacts are verified on entry
  /// (they met the customer); a portal OTP sets it too. Null only for a contact
  /// the customer typed into the portal without an OTP — POS search still finds
  /// it, but it cannot be primary, sign in by OTP, or reset the password.
  verifiedAt DateTime?

  person  Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([companyId])
  /// Backs the watermark pull: "anything since <ts>?" must not scan the table
  /// to answer no.
  @@index([updatedAt])
}
