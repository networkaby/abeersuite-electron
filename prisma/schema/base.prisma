generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Identity models ───────────────────────────────────────────────────────────

model Customer {
  id            Int       @id @default(autoincrement())
  name          String
  phone         String?
  email         String?
  address       String?
  agreedToTerms Boolean   @default(false)
  agreedAt      DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  account          Account?
  companies        CustomerCompany[]
  portalCredential CustomerPortalCredential?
  shopOrders       ShopOrder[]
  crmLeads         CrmLead[]

  @@index([phone])
  @@index([email])
}

model Company {
  id         Int      @id @default(autoincrement())
  name       String
  phone      String?
  email      String?
  address    String?
  companyReg String?
  taxId      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  // Tally-style period anchors (per-company; mid-year migration sets these
  // differently — financial year starts 1 Apr but books begin from cutover date)
  financialYearFrom  DateTime? @db.Date
  booksBeginningFrom DateTime? @db.Date

  account   Account?
  customers CustomerCompany[]
  crmLeads  CrmLead[]

  @@index([phone])
  @@index([email])
}

model CustomerCompany {
  id         Int       @id @default(autoincrement())
  customerId Int
  companyId  Int
  role       String?
  linkedAt   DateTime  @default(now())
  unlinkedAt DateTime?
  customer   Customer  @relation(fields: [customerId], references: [id])
  company    Company   @relation(fields: [companyId], references: [id])

  @@index([customerId])
  @@index([companyId])
}
