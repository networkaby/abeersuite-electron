// Groups are the optional layer; user-to-user DM is the core of the inbox.
// TODO: add BRANCH_GROUP / DEPARTMENT_GROUP (with ChatRoom.branchId /
// .departmentId) to replace the dropped ROLE_GROUP.
enum ChatRoomType {
  SYSTEM_INBOX
  PERSONAL_INBOX
  ORG_GROUP
  DIRECT_MESSAGE
}

enum ChatMessageType {
  SYSTEM
  USER
}

model ChatRoom {
  id          String           @id @default(cuid())
  key         String           @unique
  type        ChatRoomType
  name        String
  ownerUserId Int?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  ownerUser   User?            @relation("OwnedChatRooms", fields: [ownerUserId], references: [id])
  members     ChatRoomMember[]
  messages    ChatMessage[]

  @@index([type])
  @@index([ownerUserId])
}

model ChatRoomMember {
  id         Int       @id @default(autoincrement())
  roomId     String
  userId     Int
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?
  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model ChatMessage {
  id           Int             @id @default(autoincrement())
  roomId       String
  senderUserId Int?
  messageType  ChatMessageType @default(USER)
  title        String?
  body         String
  link         String?
  /// Attached file (Excel, PDF, photo …) — the object key in the private R2
  /// bucket, shown through a short-lived signed link. Null = text only.
  mediaKey     String?
  /// MIME type as the browser gave it.
  mediaType    String?
  /// Original file name.
  fileName     String?
  /// Size in bytes.
  mediaSize    Int?
  createdAt    DateTime        @default(now())
  room         ChatRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderUser   User?           @relation(fields: [senderUserId], references: [id])

  @@index([roomId, createdAt])
  @@index([senderUserId])
}
