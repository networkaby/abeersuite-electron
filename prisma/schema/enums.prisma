// ── Accounting voucher types ────────────────────────────────────────────────
// JOURNAL is the catch-all "any GL adjustment" voucher used by the Tally-style
// JournalVoucherDialog. The other five mirror Tally's classical kinds.

enum VoucherType {
  CONTRA
  PAYMENT
  RECEIPT
  CREDIT_NOTE
  DEBIT_NOTE
  JOURNAL
}

// ── Bill-wise allocation (free-form linking between any two vouchers) ────────

enum AllocationMethod {
  NEW_REF // creates a new bill (used on Sales/Purchase invoices)
  AGAINST_REF // settles an existing bill
  ADVANCE // received/paid before the matching bill exists
  ON_ACCOUNT // unallocated; lump sum
}

enum AllocationTargetType {
  INVOICE
  VOUCHER
  JOURNAL_ENTRY
}

enum AllocationSourceType {
  VOUCHER
  PAYMENT
  INVOICE
  JOURNAL_ENTRY
}

// ── Inventory voucher enums ───────────────────────────────────────────────────

enum InvVoucherType {
  PURCHASE
  SALE
  ESTIMATE
  SALE_RETURN // stock IN — reverses a SALE (customer returns goods, "Credit Note" in accounting)
  PURCHASE_RETURN // stock OUT — reverses a PURCHASE (we return to supplier, "Debit Note" in accounting)
  RECEIPT
  ISSUE
  ADJUSTMENT
  STOCK_JOURNAL // inter-godown / manufacturing
  PHYSICAL_STOCK // physical count adjustment
  GRN // goods-received-note (against PO)
  CHALLAN // delivery challan (against SO)
  REJECTION_IN
  REJECTION_OUT
  SALES_ORDER
  PURCHASE_ORDER
}

// ── GST enums ─────────────────────────────────────────────────────────────────

enum GstRegType {
  REGULAR // standard GST-registered party
  COMPOSITION // composition-scheme dealer (no ITC)
  SEZ // special economic zone (zero-rated)
  UNREGISTERED // no GSTIN
}

enum Taxability {
  TAXABLE // standard rate (0/5/12/18/28)
  EXEMPT // GST-exempt (e.g. unprocessed food)
  NIL_RATED // 0% GST
  NON_GST // outside GST regime entirely (alcohol, fuel)
}

// ── Ecommerce / Order enums ───────────────────────────────────────────────────

enum OrderSource {
  ONLINE
  IN_STORE
  PHONE
  WHATSAPP
  OTHER
}
