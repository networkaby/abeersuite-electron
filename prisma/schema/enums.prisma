// ── Finance enums ─────────────────────────────────────────────────────────────

enum GroupType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum VoucherStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum EntryType {
  DEBIT
  CREDIT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  VOID
