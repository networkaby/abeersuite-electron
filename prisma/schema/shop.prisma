// ── Ecommerce MVP (₹ prices stored as integer paise) ───────────────────────────

enum ShopOrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CANCELLED
}

model ShopProduct {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  pricePaise  Int
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines ShopOrderLine[]
}

model ShopOrder {
  id               Int             @id @default(autoincrement())
  status           ShopOrderStatus @default(DRAFT)
  customerId       Int?
  guestEmail       String?
  guestPhone       String?
  totalPaise       Int             @default(0)
  razorpayOrderId  String?         @unique
  razorpayPaymentId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])
  lines    ShopOrderLine[]

  @@index([customerId])
  @@index([status])
}

model ShopOrderLine {
  id             Int @id @default(autoincrement())
  orderId        Int
  productId      Int
  quantity       Int @default(1)
  unitPricePaise Int

  order   ShopOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product ShopProduct @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
