// ── Ecommerce (₹ prices stored as integer paise) ────────────────────────────
// Products live in InvProduct (inventory.prisma) — ShopOrderLine references them directly.

enum ShopOrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PACKED
  SHIPPED
  DELIVERED
  REFUNDED
  CANCELLED
}

model ShopCoupon {
  id         String    @id @default(cuid())
  code       String    @unique
  percentOff Int?
  flatPaise  Int?
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  orders ShopOrder[]
}

model ShopOrder {
  id                Int             @id @default(autoincrement())
  // Legacy enum status — kept for Razorpay webhook compat; pipeline statusId is source of truth
  status            ShopOrderStatus @default(DRAFT)
  orderSource       OrderSource     @default(ONLINE)
  // Pipeline-based workflow (same pattern as CrmLead)
  pipelineId        String?
  statusId          String?
  // accountId is the primary GL link — all financial activity goes through Account
  accountId         Int?
  // Legacy identity fields — kept for backward compat; prefer accountId
  customerId        Int?
  guestEmail        String?
  guestPhone        String?
  // invoiceId lives on Invoice.shopOrderId (FK is on Invoice side)
  shippingName      String?
  shippingAddress   Json?
  totalPaise        Int             @default(0)
  razorpayOrderId   String?         @unique
  razorpayPaymentId String?
  courier           String?
  trackingNumber    String?
  sourceCouponId    String?
  paidAt            DateTime?
  packedAt          DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  refundedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  account      Account?        @relation(fields: [accountId], references: [id])
  customer     Customer?       @relation(fields: [customerId], references: [id])
  pipeline     Pipeline?       @relation(fields: [pipelineId], references: [id])
  orderStatus  TicketStatus?   @relation(fields: [statusId], references: [id])
  invoice      Invoice?        @relation("OrderInvoice")
  sourceCoupon ShopCoupon?     @relation(fields: [sourceCouponId], references: [id])
  lines        ShopOrderLine[]
  tickets      Ticket[]

  @@index([accountId])
  @@index([customerId])
  @@index([status])
  @@index([pipelineId])
  @@index([statusId])
  @@index([sourceCouponId])
}

model ShopOrderLine {
  id             Int @id @default(autoincrement())
  orderId        Int
  productId      Int
  quantity       Int @default(1)
  unitPricePaise Int

  order   ShopOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product InvProduct @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
