// ── Ecommerce (₹ prices stored as integer paise) ────────────────────────────
// Products live in InvProduct (inventory.prisma) — ShopOrderLine references them directly.

enum ShopOrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PACKED
  SHIPPED
  DELIVERED
  REFUNDED
  CANCELLED
}

model ShopCoupon {
  id         String    @id @default(cuid())
  code       String    @unique
  percentOff Int?
  flatPaise  Int?
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  orders ShopOrder[]
}

model ShopOrder {
  id                Int             @id @default(autoincrement())
  status            ShopOrderStatus @default(DRAFT)
  customerId        Int?
  accountId         Int?
  guestEmail        String?
  guestPhone        String?
  shippingName      String?
  shippingAddress   Json?
  totalPaise        Int             @default(0)
  razorpayOrderId   String?         @unique
  razorpayPaymentId String?
  courier           String?
  trackingNumber    String?
  sourceCouponId    String?
  paidAt            DateTime?
  packedAt          DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  refundedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  customer     Customer?     @relation(fields: [customerId], references: [id])
  account      Account?      @relation(fields: [accountId], references: [id])
  sourceCoupon ShopCoupon?   @relation(fields: [sourceCouponId], references: [id])
  lines        ShopOrderLine[]
  tickets      Ticket[]

  @@index([customerId])
  @@index([accountId])
  @@index([status])
  @@index([sourceCouponId])
}

model ShopOrderLine {
  id             Int @id @default(autoincrement())
  orderId        Int
  productId      Int
  quantity       Int @default(1)
  unitPricePaise Int

  order   ShopOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product InvProduct @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
