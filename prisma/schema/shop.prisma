// ── Ecommerce (₹ prices stored as integer paise) ────────────────────────────
// Products live in InvProduct (inventory.prisma) — TicketOrderLine references them directly.

enum ShopOrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PACKED
  SHIPPED
  DELIVERED
  REFUNDED
  CANCELLED
}

// How the customer pays. COD is the only live method today; ONLINE (Razorpay &
// future gateways) is parked — see TODO(payment-gateway). Defaulted so the column
// is additive (plain `db push`, no reset).
enum ShopPaymentMethod {
  COD
  ONLINE
}

// What the storefront does with a tracked product that has zero stock.
// Org-wide default (OrgDefaults.shopOutOfStockPolicy). A per-product
// `InvProduct.allowBackorder` overrides this to always allow ordering.
//   HIDE      – remove the product from the shop while out of stock.
//   NOTIFY    – show it with an "Out of stock" notice, add-to-cart disabled.
//   BACKORDER – show it and accept orders anyway (procure later).
enum ShopOutOfStockPolicy {
  HIDE
  NOTIFY
  BACKORDER
}

// (Removed legacy `ShopCoupon` model — superseded by the unified `Coupon`
//  model in coupons.prisma, managed under Customer Retention.)
//
// An ecommerce order is now a Ticket on the "order" pipeline — see `TicketOrder` /
// `TicketOrderLine` (tickets.prisma). The `ShopOrderStatus` / `ShopPaymentMethod`
// enums below survive because `TicketOrder` still uses them (Razorpay webhook compat).

// ── Delivery method (courier options offered at checkout) ───────────────────
// Config-only table, same shape as PaymentGateway (pos.prisma). One row per
// courier the storefront offers; the customer picks one at checkout and its rate
// is added to the bill as the shipping charge.
//   kind = "SHIPROCKET" – live rate via the Shiprocket serviceability API
//          (priced by parcel weight + delivery pincode); no stored rate.
//          configJson: { pickupLocation, defaultItemWeightGrams, length, breadth, height }
//   kind = "CUSTOM"     – manually-run courier; admin sets the rate on its own
//          settings page. configJson: { flatPaise, freeAbovePaise? }
//   kind = "OWN_BOY"    – in-house delivery boy; offered only for the listed
//          pincodes. configJson: { pincodes: string[], flatPaise, freeAbovePaise? }
model DeliveryMethod {
  id          Int      @id @default(autoincrement())
  kind        String // "SHIPROCKET" | "CUSTOM" | "OWN_BOY"
  displayName String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  configJson  Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind])
  @@map("delivery_methods")
}
