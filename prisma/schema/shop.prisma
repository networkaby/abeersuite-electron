// ── Ecommerce (₹ prices stored as integer paise) ────────────────────────────
// Products live in InvProduct (inventory.prisma) — ShopOrderLine references them directly.

enum ShopOrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PACKED
  SHIPPED
  DELIVERED
  REFUNDED
  CANCELLED
}

// How the customer pays. COD is the only live method today; ONLINE (Razorpay &
// future gateways) is parked — see TODO(payment-gateway). Defaulted so the column
// is additive (plain `db push`, no reset).
enum ShopPaymentMethod {
  COD
  ONLINE
}

// What the storefront does with a tracked product that has zero stock.
// Org-wide default (OrgDefaults.shopOutOfStockPolicy). A per-product
// `InvProduct.allowBackorder` overrides this to always allow ordering.
//   HIDE      – remove the product from the shop while out of stock.
//   NOTIFY    – show it with an "Out of stock" notice, add-to-cart disabled.
//   BACKORDER – show it and accept orders anyway (procure later).
enum ShopOutOfStockPolicy {
  HIDE
  NOTIFY
  BACKORDER
}

model ShopCoupon {
  id         String    @id @default(cuid())
  code       String    @unique
  percentOff Int?
  flatPaise  Int?
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  orders ShopOrder[]
}

model ShopOrder {
  id                Int             @id @default(autoincrement())
  // Legacy enum status — kept for Razorpay webhook compat; pipeline statusId is source of truth
  status            ShopOrderStatus @default(DRAFT)
  orderSource       OrderSource     @default(ONLINE)
  // Payment method. COD = collect on delivery (the only live method); ONLINE parked.
  paymentMethod     ShopPaymentMethod @default(COD)
  // Pipeline-based workflow (same pattern as CrmLead)
  pipelineId        String?
  statusId          String?
  // accountId is the primary GL link — all financial activity goes through Account
  accountId         Int?
  // Legacy identity fields — kept for backward compat; prefer accountId
  personId          Int?
  guestEmail        String?
  guestPhone        String?
  shippingName      String?
  shippingAddress   Json?
  totalPaise        Int             @default(0)
  razorpayOrderId   String?         @unique
  razorpayPaymentId String?
  courier           String?
  trackingNumber    String?
  sourceCouponId    String?
  paidAt            DateTime?
  packedAt          DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  refundedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  account      Account?        @relation(fields: [accountId], references: [id])
  person       Person?         @relation(fields: [personId], references: [id])
  pipeline     Pipeline?       @relation(fields: [pipelineId], references: [id])
  orderStatus  TicketStatus?   @relation(fields: [statusId], references: [id])
  invVoucher   InvVoucher?     @relation("OrderInvVoucher")
  sourceCoupon ShopCoupon?     @relation(fields: [sourceCouponId], references: [id])
  lines        ShopOrderLine[]
  tickets      Ticket[]

  @@index([accountId])
  @@index([personId])
  @@index([status])
  @@index([pipelineId])
  @@index([statusId])
  @@index([sourceCouponId])
}

model ShopOrderLine {
  id             Int @id @default(autoincrement())
  orderId        Int
  productId      Int
  quantity       Int @default(1)
  unitPricePaise Int

  order   ShopOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product InvProduct @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
