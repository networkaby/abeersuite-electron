// ── Campaigns: messages to many customers at once ─────────────────────────────
//
// The communication place (owner, 2026-10-17): staff write a greeting or offer
// here and, later, send it as an app notification (WhatsApp later still). A
// campaign may carry an existing Retention tool (a coupon) — picked, never made
// or changed here, since coupons are money. Results will reuse PushMessage
// (refType "CAMPAIGN", refId = id), so no per-customer row lives here.
// Syncs to the counters like every table, so the migration carries the till gate.

/// One campaign. `channel` "PUSH" | "WHATSAPP" (WhatsApp not wired yet);
/// `audience` "ALL_PUSH" (every customer with notifications on); `status`
/// "DRAFT" | "READY" | "SCHEDULED" | "SENT" (SCHEDULED = sent by the communications
/// job at the first run on or after `scheduledAt`). Strings, not enums: values will grow, and an enum
/// ADD VALUE needs a migration of its own.
model Campaign {
  id          Int       @id @default(autoincrement())
  name        String
  channel     String    @default("PUSH")
  title       String
  body        String
  /// Page the notification opens, a path on the shop site ("/shop", "/portal/coupons").
  url         String?
  couponId    Int?
  coupon      Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  audience    String    @default("ALL_PUSH")
  status      String    @default("DRAFT")
  sentAt      DateTime?
  scheduledAt DateTime?
  createdById Int?
  createdBy   User?     @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  posts       Post[]

  @@index([status, createdAt])
  @@index([status, scheduledAt])
  @@index([couponId])
}

/// A regular post for everyone (owner, 2026-10-23: "separate … regular post"):
/// written once, put up on several channels — WhatsApp Channel / Status, Google
/// Business Profile, later Facebook / Instagram. A channel with no posting API
/// (WhatsApp always; Google until its API access is approved) is shared by hand
/// from a phone or browser and logged in PostShare. May belong to a campaign.
///
/// `channels` the places it is meant for ("WA_CHANNEL", "WA_STATUS",
/// "GOOGLE_BUSINESS"); `status` "DRAFT" | "SCHEDULED" | "DONE"; Google's own
/// `googleType` "UPDATE" | "OFFER" | "EVENT" and `googleButton` ("SHOP", "CALL",
/// "LEARN_MORE", "ORDER", "BOOK") ride along for when the API posts it.
/// Media: one photo / MP4 in private R2 (chat bucket), key "posts/<id>/...".
model Post {
  id            Int         @id @default(autoincrement())
  caption       String
  /// A shop page the post links to ("/shop/hp-15s"), never another site.
  link          String?
  channels      String[]
  status        String      @default("DRAFT")
  scheduledAt   DateTime?
  /// Last "Post due — share now" staff push; the job waits POST_REMINDER_EVERY_MIN after it.
  lastRemindedAt DateTime?
  googleType    String      @default("UPDATE")
  googleButton  String?
  mediaKey      String?
  mediaType     String?
  mediaName     String?
  mediaSize     Int?
  campaignId    Int?
  campaign      Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdById   Int?
  createdByName String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  shares        PostShare[]

  @@index([status, scheduledAt])
  @@index([campaignId])
}

/// One channel a post was put up on, and by whom. A log line (name snapshot,
/// not a User relation); the same channel can be shared again another day.
model PostShare {
  id           Int      @id @default(autoincrement())
  postId       Int
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  channel      String
  sharedById   Int?
  sharedByName String?
  sharedAt     DateTime @default(now())

  @@index([postId, sharedAt])
}
