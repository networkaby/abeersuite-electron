// ── Campaigns: messages to many customers at once ─────────────────────────────
//
// The communication place (owner, 2026-10-17): staff write a greeting or offer
// here and, later, send it as an app notification (WhatsApp later still). A
// campaign may carry an existing Retention tool (a coupon) — picked, never made
// or changed here, since coupons are money. Results will reuse PushMessage
// (refType "CAMPAIGN", refId = id), so no per-customer row lives here.
// Syncs to the counters like every table, so the migration carries the till gate.

/// One campaign. `channel` "PUSH" | "WHATSAPP" (WhatsApp not wired yet);
/// `audience` "ALL_PUSH" (every customer with notifications on); `status`
/// "DRAFT" | "READY" | "SENT". Strings, not enums: values will grow, and an enum
/// ADD VALUE needs a migration of its own.
model Campaign {
  id          Int       @id @default(autoincrement())
  name        String
  channel     String    @default("PUSH")
  title       String
  body        String
  /// Page the notification opens, a path on the shop site ("/shop", "/portal/coupons").
  url         String?
  couponId    Int?
  coupon      Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  audience    String    @default("ALL_PUSH")
  status      String    @default("DRAFT")
  sentAt      DateTime?
  createdById Int?
  createdBy   User?     @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([couponId])
}
