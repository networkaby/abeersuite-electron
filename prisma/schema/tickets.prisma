// ── Unified pipeline item ("Ticket") ──────────────────────────────────────────
// ONE core table rides every pipeline (repair, deal, order, delivery, refund,
// task). `Pipeline.entityType` selects which optional 1:1 DETAIL table carries the
// domain-specific fields, and which UI renders. Cross-pipeline transfer is just an
// `update { pipelineId, status }` on the core row — the detail row stays attached
// as history, so nothing is lost when e.g. a repair becomes a deal.
//
// Ownership is a single frozen actor snapshot (`createdBy`, "who created") — no User
// FK. Assignment (who is on it now) is a Position seat (`assignedPositionId`), an
// axis distinct from ownership, used by the deal / task boards.

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id         Int      @id @default(autoincrement())
  // ── Pipeline spine ──────────────────────────────────────────────────────────
  pipelineId String?
  status     String   @default("S1")
  workerId   String?
  priority   Priority @default(MEDIUM)

  // ── Generic item fields (shared by every flavour) ───────────────────────────
  title    String?
  notes    String?
  category String? // light tag (task "HR"/"Finance", deal source bucket, …)

  // ── Ownership + assignment ──────────────────────────────────────────────────
  // createdBy = frozen ActorSnapshot (the sole "who created"; no User FK).
  // assignedPositionId = the seat currently responsible (resolved live to its holder).
  createdBy          Json      @default("{}")
  assignedPositionId String?
  assignedPosition   Position? @relation("TicketAssignedPosition", fields: [assignedPositionId], references: [id])
  // The GL bridge — Account is the sanctioned (and only) link into the accountancy
  // core. A relation is fine: the decoupling forbids GL/voucher FKs INTO workflow,
  // not this workflow→Account bridge.
  accountId          Int?
  account            Account?  @relation("TicketAccount", fields: [accountId], references: [id])

  // ── Generic scheduling ──────────────────────────────────────────────────────
  dueAt     DateTime? // task due-date / deal next-follow-up
  closedAt  DateTime? // set on a terminal stage (Won / Lost / Delivered / …)
  sortOrder Int       @default(0) // ordering within a kanban column

  // ── Retry-after-interval (snooze) runtime state (repair "waiting" sub-status) ─
  // While wakeAt > now the item sits in the Work Inbox "Waiting" tab.
  // retryCount / retryKeyId bound distinct waiting loops (calling vs parts).
  wakeAt     DateTime?
  retryCount Int       @default(0)
  retryKeyId String?

  // ── Spawned child sub-pipeline ("5th power") ────────────────────────────────
  // A sub-status with spawnPipelineId creates a CHILD ticket on another pipeline;
  // the child carries parentTicketId back and the parent mirrors it. context = soft
  // unstructured payload (device snapshot, participants, parts, spawnedFrom link).
  parentTicketId Int?
  parentWorkerId String?
  context        Json?

  // ── Recurrence provenance (Administration recurring tasks) ──────────────────
  // Set ONLY on tickets a TaskRecurrence generated. The pair is the IDEMPOTENCY
  // KEY: Postgres treats NULLs as distinct, so ordinary tickets are unaffected,
  // but the same occurrence can never be inserted twice — even when two board
  // loads sweep at the same instant. Deliberately NOT parentTicketId: that column
  // belongs to the spawn-child sub-pipeline concept, and mixing the two would make
  // a generated rent task look like a spawned child to the workflow engine.
  recurrenceId Int?
  occurrenceNo Int?

  // Source counter — the till this ticket was RAISED at. Same column, same rule
  // and same resolver as UniversalVoucher.sourceCounterId (finance.prisma); kept
  // uniform on purpose so one formatter renders both. Plain int, no FK. Null =
  // raised at the office. No branch column here: the counter is unique org-wide,
  // so PosCounter.branchId gives the branch when the label needs it.
  sourceCounterId Int?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // When the ticket entered its CURRENT main status (`status`). Stamped only on a
  // real status change — unlike `updatedAt`, which bumps on any edit — so the
  // status-resolve-time SLA (TicketStatus.resolveTimeHours) is measured honestly.
  // Defaults to now() on create; existing rows backfilled to updatedAt.
  statusEnteredAt DateTime? @default(now())

  // ── Spine relations (local, cheap) ──────────────────────────────────────────
  pipeline     Pipeline?       @relation(fields: [pipelineId], references: [id])
  ticketStatus TicketStatus    @relation(fields: [status], references: [id])
  ticketWorker TicketWorker?   @relation(fields: [workerId], references: [id])
  parent       Ticket?         @relation("TicketChildren", fields: [parentTicketId], references: [id])
  children     Ticket[]        @relation("TicketChildren")
  // SetNull — deleting the recurrence keeps the tasks it already generated as history.
  recurrence   TaskRecurrence? @relation("TicketRecurrence", fields: [recurrenceId], references: [id], onDelete: SetNull)

  logs         TicketLog[]
  participants TicketParticipant[]

  // ── Optional 1:1 detail (exactly one per row, keyed by Pipeline.entityType) ──
  repair   TicketRepair?
  deal     TicketDeal?
  order    TicketOrder?
  delivery TicketDelivery?
  refund   TicketRefund?
  help     TicketHelp?

  @@unique([recurrenceId, occurrenceNo])
  @@index([parentTicketId])
  @@index([status])
  @@index([pipelineId, status])
  @@index([assignedPositionId])
  @@index([accountId])
  @@index([createdAt])
  @@index([sourceCounterId])
  @@index([wakeAt])
  @@index([recurrenceId])
  // Poll-and-skip: the sidebar asks "any ticket touched since <ts>?" on every
  // tick. Without this the common answer (no) costs a full table scan, because
  // proving no row matches means visiting all of them.
  @@index([updatedAt])
}

// ── Detail: Repair (device-based service ticket) ──────────────────────────────
model TicketRepair {
  ticketId Int    @id
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  deviceId Int
  device   Device @relation(fields: [deviceId], references: [id])

  ticketNo       String?
  estimatedCost  Float?
  accessInfo     String?
  accessories    String? // items received with the device (bag, charger, cover …)
  expectedReturn DateTime?
  receivedBackAt DateTime?
  externalRef    String?
  voidReason     String?

  // Escalation
  escalated      Boolean         @default(false)
  escalatedAt    DateTime?
  escalationType EscalationType?

  // Warranty
  isWarranty     Boolean        @default(false)
  warrantyStatus WarrantyStatus @default(NONE)
  warrantyRef    String?
  purchaseDate   DateTime?

  // Optional link when the repair was spawned from an ecommerce return / RMA —
  // points at the order's core Ticket id (id-only, no relation).
  sourceOrderTicketId Int?

  @@index([deviceId])
  @@index([warrantyStatus])
  @@index([sourceOrderTicketId])
}

// ── Detail: Deal (sales opportunity; contact links id-only) ───────────────────
model TicketDeal {
  ticketId Int    @id
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Contact + association (link to an existing customer ledger, HubSpot-style).
  contactName String?
  phone       String?
  email       String?
  companyName String?
  personId    Int?
  companyId   Int?
  person      Person?  @relation(fields: [personId], references: [id])
  company     Company? @relation(fields: [companyId], references: [id])

  valuePaise Int?
  source     String?
  lostReason String?

  @@index([personId])
  @@index([companyId])
}

// ── Detail: Order (ecommerce / storefront order) ──────────────────────────────
model TicketOrder {
  ticketId Int    @id
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Legacy enum status — kept for Razorpay webhook compat; the core `status`
  // (pipeline stage) is the source of truth.
  legacyStatus  ShopOrderStatus   @default(DRAFT)
  orderSource   OrderSource       @default(ONLINE)
  paymentMethod ShopPaymentMethod @default(COD)

  // Identity — Person link (prefer the core Ticket.accountId for the GL link).
  personId        Int?
  person          Person? @relation(fields: [personId], references: [id])
  guestEmail      String?
  guestPhone      String?
  shippingName    String?
  shippingAddress Json?

  totalPaise          Int      @default(0)
  // Shipping charge the customer picked at checkout (paise). The chosen courier
  // is stored in `courier` (kind: SHIPROCKET | SHIPWAY | CUSTOM | OWN_BOY |
  // STORE_PICKUP | FREE_DELIVERY). Grand total on
  // the bill = totalPaise (goods) + shippingChargePaise. GL posting stays manual.
  shippingChargePaise Int      @default(0)
  // Spend-tier discount FROZEN at checkout (same engine as POS: tier% × cost).
  // totalPaise above is already NET of this discount — the gateway charges the
  // discounted amount. tierDiscountPaise = the inclusive (customer-facing) ₹
  // effect; tierDiscountPct = the configured cost-% that produced it; tierLabel
  // = display name ("Gold of FY spend") for the bill row + printed ladder.
  // Per-line pre-tax splits live on TicketOrderLine.tierDiscountPaise.
  tierDiscountPaise   Int      @default(0)
  tierDiscountPct     Decimal? @db.Decimal(5, 2)
  tierLabel           String?
  // Coupon FROZEN at checkout (same engine as POS — selectCouponForCart,
  // channel SHOP; explicit code or best AUTO offer). totalPaise is already NET
  // of couponDiscountPaise. The CouponRedemption row is written AT CHECKOUT
  // (spine null — locks usage limits against double-use across pending
  // orders); the invoice conversion stamps its universalVoucherId when it
  // posts, so full-return reversal keeps working. Non-stackable coupons drop
  // the tier (tierDiscountPaise then freezes as 0).
  couponId            Int?
  couponCode          String?
  couponDiscountPaise Int      @default(0)
  couponRedemptionId  Int?
  // Independent FREE-GRANT coupon (FREE_ITEM / BOGO) FROZEN at checkout — the
  // granted item rides the order as a zero-price TicketOrderLine (freeQty),
  // like the POS counter. No ₹ discount, so couponDiscountPaise stays 0; the
  // redemption row (amount 0) still locks the usage limits and reverses on a
  // full return. Codeless AUTO offers freeze their display name as the code.
  freeCouponId            Int?
  freeCouponCode          String?
  freeCouponRedemptionId  Int?
  // Rule 2 — independent PARTIAL (<100%) FREE_ITEM / BOGO coupon FROZEN at
  // checkout: a ₹ discount ON TOP of the money coupon (never guard-clamped,
  // never drops tier / blocks loyalty). totalPaise is already NET of it; the
  // invoice conversion posts it as a negative coupon charge and stamps the
  // redemption, exactly like the money coupon.
  onTopCouponId           Int?
  onTopCouponCode         String?
  onTopDiscountPaise      Int     @default(0)
  onTopRedemptionId       Int?
  // Loyalty redemption FROZEN at checkout (points + ₹ value; validated against
  // balance / floors / the cart-aware redeem ceiling — same clampRedemption as
  // POS). totalPaise is already NET of loyaltyRedeemPaise. Points are NOT
  // burned here — the invoice conversion burns lots + earns + milestones in
  // its posting tx (applyLoyaltyForSale, POS-parity), guarding that the
  // balance still covers the frozen points (422 otherwise).
  loyaltyRedeemPoints Int      @default(0)
  loyaltyRedeemPaise  Int      @default(0)
  razorpayOrderId     String?  @unique
  razorpayPaymentId   String?
  courier             String?
  trackingNumber      String?

  paidAt      DateTime?
  packedAt    DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  refundedAt  DateTime?

  lines TicketOrderLine[]

  @@index([personId])
}

model TicketOrderLine {
  id                Int @id @default(autoincrement())
  orderTicketId     Int
  productId         Int
  quantity          Int @default(1)
  /// Independent FREE-GRANT line (FREE_ITEM / BOGO coupon): quantity 0 +
  /// freeQty, mirroring the POS invoice line — the item rides the order as a
  /// zero-price line (stock + COGS move at invoice, no money, no tax).
  freeQty           Int @default(0)
  unitPricePaise    Int
  // Whole-line spend-tier discount, PRE-TAX paise, frozen at checkout
  // (tier% × costExcl × qty, clamped to the line's pre-tax value — POS
  // formula). unitPricePaise stays the GROSS tag; the invoice conversion
  // passes this as the line's discountAmt so GST recomputes on the reduced
  // base exactly like a POS sale line. 0 = no discount on this line.
  tierDiscountPaise Int @default(0)

  order   TicketOrder @relation(fields: [orderTicketId], references: [ticketId], onDelete: Cascade)
  product InvProduct  @relation(fields: [productId], references: [id])

  @@index([orderTicketId])
  @@index([productId])
}

// ── Detail: Delivery (O2C dispatch sub-pipeline) ──────────────────────────────
// Polymorphic order ref: orderSource = "inv" (order-type InvVoucher) | "shop"
// (an order Ticket). GL-silent — carrier cost is decision-support only.
model TicketDelivery {
  ticketId Int    @id
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  orderSource String // "inv" | "shop"
  orderId     Int

  carrier               String? // SHIPROCKET | CUSTOM | OWN_BOY | PICKUP
  awb                   String?
  trackingUrl           String?
  addressJson           Json?
  chargeToCustomerPaise Int     @default(0)
  costToCarrierPaise    Int     @default(0)
  // Shiprocket handles, set when the shipment is pushed to Shiprocket. Needed to
  // assign AWB, fetch the label, and schedule pickup. null for CUSTOM / OWN_BOY.
  shiprocketOrderId     String?
  shipmentId            String?

  @@index([orderSource, orderId])
}

// ── Detail: Refund (O2C refund sub-pipeline) ──────────────────────────────────
// GL-silent here; the pay-back Payment voucher is posted by staff on "Refunded".
model TicketRefund {
  ticketId Int    @id
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  orderSource String // "inv" | "shop"
  orderId     Int

  amountPaise     Int     @default(0)
  reason          String?
  sourceVoucherId Int? // the advance Receipt voucher being paid back
  payoutVoucherId Int? // the Payment voucher posted on Refunded (idempotency guard)

  @@index([orderSource, orderId])
}

// ── Detail: Help (front-desk enquiry / triage ticket) ─────────────────────────
// A short-lived FIRST-RESPONSE record. The front desk (counter or office) logs a
// customer's problem or question — price, availability, technical info, warranty
// on a dead device… — the concerned team advises, then it CLOSES with an
// `outcome`. On a "converted" outcome it hands off by creating a fresh, INDEPENDENT
// ticket (a repair / service ticket, or a CRM deal) on that pipeline — no parent/
// child link back: the closed help ticket + its outcome is the whole record. The
// customer is either an existing party (personId / companyId) OR a brand-new
// walk-in captured inline (contactName + phone). GL-silent — a help ticket never
// touches the ledger (estimates / orders / invoices are decoupled vouchers, raised
// independently, never "converted from" a ticket).
model TicketHelp {
  ticketId Int    @id
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Customer — an existing party link, or a new walk-in captured inline.
  personId    Int?
  companyId   Int?
  person      Person?  @relation(fields: [personId], references: [id])
  company     Company? @relation(fields: [companyId], references: [id])
  contactName String?
  phone       String?
  email       String?

  // What they need. `inquiryType` = PRICE | AVAILABILITY | TECH_INFO | WARRANTY |
  // OTHER (a light string, mirrored on the core Ticket.category tag); `subject` is
  // the one-line summary shown on the board card.
  inquiryType String?
  subject     String?

  // Set when the ticket closes — its terminal disposition. A CONVERTED_* outcome
  // records that a downstream ticket was created; there is deliberately no FK to it.
  outcome HelpOutcome?

  @@index([personId])
  @@index([companyId])
  @@index([outcome])
}

// Terminal disposition of a help ticket (the single "ladder" that every enquiry
// type shares — see the three broken-machine / price stories).
enum HelpOutcome {
  NOT_FEASIBLE // we don't service that / it's not available and can't be arranged
  CUSTOMER_DECLINED // customer chose not to proceed
  RESOLVED_INFO // advice / price / info given, nothing more to do
  CONVERTED_TO_SERVICE // handed off into a repair / service ticket
  CONVERTED_TO_SALE // handed off into a sale (deal / estimate / order)
}

// ── Timeline: one log for every flavour (repair status changes, deal activities,
// task comments) — actor is a frozen ActorSnapshot, no User FK. ────────────────
model TicketLog {
  id Int @id @default(autoincrement())

  // ── Owner: exactly one of ticket / person / company (app-enforced) ──────────
  // Normally the timeline of a Ticket (repair/deal notes, status changes). For the
  // CRM "Reconnect" page a note/call hangs directly off a customer (Person or
  // Company) with NO ticket — the customer is their own timeline. Real tickets
  // spun off later (e.g. a Deal on interest) keep using ticketId as before.
  ticketId  Int?
  personId  Int?
  companyId Int?

  author     Json          @default("{}") // ActorSnapshot
  kind       TicketLogKind @default(NOTE)
  note       String?
  status     String? // TicketStatus at the time (repair); null for plain notes
  workerId   String? // sub-status (repair)
  visibility LogVisibility @default(INTERNAL)

  // Deal follow-up tasks (kind = TASK): due / done timestamps.
  dueAt  DateTime?
  doneAt DateTime?

  // Structured work-completion record (dormant — columns kept for a future rebuild).
  outcome String?
  data    Json?

  createdAt DateTime @default(now())

  ticket       Ticket?       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  person       Person?       @relation(fields: [personId], references: [id], onDelete: Cascade)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ticketStatus TicketStatus? @relation(fields: [status], references: [id])
  ticketWorker TicketWorker? @relation(fields: [workerId], references: [id])

  @@index([ticketId])
  @@index([personId, createdAt])
  @@index([companyId, createdAt])
}

// Kind of a TicketLog entry — merges the former TaskCommentKind + DealActivityKind
// with the repair note vocabulary.
enum TicketLogKind {
  NOTE
  COMMENT
  CALL
  MEETING
  TASK
  SYSTEM
}

model TicketParticipant {
  id                Int           @id @default(autoincrement())
  ticketId          Int
  userId            Int
  addedById         Int
  addedForRole      String?
  addedByWorkerId   String?
  removedAt         DateTime?
  removedByWorkerId String?
  createdAt         DateTime      @default(now())
  addedBy           User          @relation("ParticipantAddedBy", fields: [addedById], references: [id])
  addedByWorker     TicketWorker? @relation("ParticipantWorker", fields: [addedByWorkerId], references: [id])
  ticket            Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user              User          @relation("ParticipantUser", fields: [userId], references: [id])

  @@unique([ticketId, userId, addedByWorkerId])
  @@index([ticketId])
  @@index([userId])
}

model Device {
  id        Int            @id @default(autoincrement())
  type      String
  brand     String
  model     String
  problem   String
  accountId Int?
  account   Account?       @relation(fields: [accountId], references: [id])
  repairs   TicketRepair[]

  // The counter's Postgres replica delta-syncs on "what changed since <ts>?".
  // Device had no timestamp at all — not even createdAt — and no cascade parent to
  // be pulled along with, so an edit at repair intake was invisible to every sync
  // strategy and the only correct option was re-copying the table forever.
  // `@default(now())` backfills existing rows on push. See Person.updatedAt.
  updatedAt DateTime       @default(now()) @updatedAt

  @@index([accountId])
  // Without this, "any device touched since <ts>?" scans every row to answer
  // "none" — which is the answer almost every cycle.
  @@index([updatedAt])
}

// ── Recurring task definition (Administration board) ──────────────────────────
// ONE template that generates task Tickets on a schedule. It expresses both shapes
// the shop needs with a single nullable field:
//   • fixed count — 12 monthly EMI instalments  (totalCount = 12 → "#3 of 12")
//   • endless     — rent on the 5th, for ever   (totalCount = null → "Aug 2026")
// The {unit, every} vocabulary is the SAME one TicketWorker.retrySchedule uses, and
// both share the calendar math in src/shared/lib/format/addInterval.ts.
//
// GL-silent by design: amountPaise is decision support only — nothing is ever posted
// to the ledger from here. accountId is the sanctioned workflow→Account bridge, and
// answers "which loan / which landlord", nothing more.
model TaskRecurrence {
  id Int @id @default(autoincrement())

  // ── Template copied onto every generated Ticket ─────────────────────────────
  title              String
  notes              String?
  category           String?
  priority           Priority  @default(MEDIUM)
  pipelineId         String    @default("P4")
  assignedPositionId String?
  assignedPosition   Position? @relation("TaskRecurrenceAssignedPosition", fields: [assignedPositionId], references: [id])

  // ── Schedule ────────────────────────────────────────────────────────────────
  // unit ∈ day | week | month | year (a task never recurs by minute/hour).
  unit             String   @default("month")
  every            Int      @default(1)
  // null = endless (rent). A number = fixed instalment count (EMI).
  totalCount       Int?
  // Due date of occurrence #1 AND the permanent anchor. Every later due date is
  // anchorAt + (n-1)×(every·unit), computed FROM THE ANCHOR — never from the previous
  // occurrence — so a 31st anchor clamps to 30 Jun / 28 Feb and RECOVERS to 31 Jul
  // instead of drifting earlier for ever.
  anchorAt         DateTime
  // Monotonic cursor: the highest occurrence number ever generated. It only advances,
  // so deleting a generated task never makes it come back.
  lastOccurrenceNo Int      @default(0)
  // Create the task this many days BEFORE its due date (0 = on the day).
  leadDays         Int      @default(0)

  // ── Lifecycle ───────────────────────────────────────────────────────────────
  isActive Boolean   @default(true) // pause / resume
  endedAt  DateTime? // stamped when totalCount is reached, or when stopped by hand

  // ── Decision support only (paise, like TicketDeal.valuePaise). NO GL. ───────
  amountPaise Int?
  accountId   Int?
  account     Account? @relation("TaskRecurrenceAccount", fields: [accountId], references: [id])

  createdBy Json     @default("{}") // frozen ActorSnapshot — the honest author
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[] @relation("TicketRecurrence")

  @@index([isActive, endedAt])
  @@index([assignedPositionId])
  @@index([accountId])
}
