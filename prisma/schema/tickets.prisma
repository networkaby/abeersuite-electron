// ── Device / Ticket ───────────────────────────────────────────────────────────

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Device {
  id        Int      @id @default(autoincrement())
  type      String
  brand     String
  model     String
  problem   String
  accountId Int?
  account   Account? @relation(fields: [accountId], references: [id])
  tickets   Ticket[]

  @@index([accountId])
}

model Ticket {
  id                Int             @id @default(autoincrement())
  /// Optional link when ticket was spawned from an ecommerce return / RMA.
  sourceShopOrderId Int?
  pipelineId        String?
  status            String          @default("S1")
  priority          Priority        @default(MEDIUM)
  notes             String?
  accessInfo        String?
  estimatedCost     Float?
  deviceId          Int
  escalated         Boolean         @default(false)
  escalatedAt       DateTime?
  escalationType    EscalationType?
  expectedReturn    DateTime?
  receivedBackAt    DateTime?
  externalRef       String?
  serviceCenterId   Int?
  workerId          String?
  isWarranty        Boolean         @default(false)
  warrantyStatus    WarrantyStatus  @default(NONE)
  warrantyRef       String?
  purchaseDate      DateTime?
  voidReason        String?
  primaryOwnerId    Int?
  billingAccountId  Int?
  // Retry-after-interval (snooze) runtime state. wakeAt = when the deferred work
  // in the current "waiting" sub-status is due again; while wakeAt > now the
  // ticket sits in the Work Inbox "Waiting" tab. retryCount/retryKeyId track how
  // many times this particular waiting sub-status (retryKeyId) has been entered,
  // so distinct loops (calling vs parts) count independently and bound correctly.
  wakeAt            DateTime?
  retryCount        Int             @default(0)
  retryKeyId        String?
  // ── Spawned child sub-pipeline ("5th power") ───────────────────────────────
  // A sub-status with spawnPipelineId creates a CHILD ticket on another pipeline
  // (e.g. inbound parts courier). The child carries parentTicketId back; the
  // parent's sub-status mirrors the child's status and advances when the child
  // hits a terminal. parentWorkerId = which sub-status of the parent is waiting
  // on this child (where to fire success/fail when it resolves). context = soft,
  // unstructured data (device snapshot, participants, ownership, parts) — kept in
  // JSON for now, rewire to columns later if needed.
  parentTicketId    Int?
  parentWorkerId    String?
  context           Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  shopOrder      ShopOrder?          @relation(fields: [sourceShopOrderId], references: [id])
  pipeline       Pipeline?           @relation(fields: [pipelineId], references: [id])
  device         Device              @relation(fields: [deviceId], references: [id])
  primaryOwner   User?               @relation(fields: [primaryOwnerId], references: [id])
  billingAccount Account?            @relation("TicketBillingAccount", fields: [billingAccountId], references: [id])
  serviceCenter  ServiceCenter?      @relation(fields: [serviceCenterId], references: [id])
  ticketStatus   TicketStatus        @relation(fields: [status], references: [id])
  ticketWorker   TicketWorker?       @relation(fields: [workerId], references: [id])
  parent         Ticket?             @relation("TicketChildren", fields: [parentTicketId], references: [id])
  children       Ticket[]            @relation("TicketChildren")
  logs           TicketLog[]
  participants   TicketParticipant[]

  @@index([parentTicketId])
  @@index([status])
  @@index([pipelineId, status])
  @@index([primaryOwnerId])
  @@index([deviceId])
  @@index([warrantyStatus])
  @@index([createdAt])
  @@index([sourceShopOrderId])
  @@index([wakeAt])
}

model TicketParticipant {
  id                Int           @id @default(autoincrement())
  ticketId          Int
  userId            Int
  addedById         Int
  addedForRole      String?
  addedByWorkerId   String?
  removedAt         DateTime?
  removedByWorkerId String?
  createdAt         DateTime      @default(now())
  addedBy           User          @relation("ParticipantAddedBy", fields: [addedById], references: [id])
  addedByWorker     TicketWorker? @relation("ParticipantWorker", fields: [addedByWorkerId], references: [id])
  ticket            Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user              User          @relation("ParticipantUser", fields: [userId], references: [id])

  @@unique([ticketId, userId, addedByWorkerId])
  @@index([ticketId])
  @@index([userId])
}

model TicketLog {
  id           Int           @id @default(autoincrement())
  ticketId     Int
  status       String
  note         String?
  userId       Int
  workerId     String?
  visibility   LogVisibility @default(INTERNAL)
  // Structured work-completion record (currently dormant — feature reverted; columns
  // kept so existing data survives and a future rebuild has them ready).
  outcome      String?
  data         Json?
  createdAt    DateTime      @default(now())
  ticketStatus TicketStatus  @relation(fields: [status], references: [id])
  ticketWorker TicketWorker? @relation(fields: [workerId], references: [id])
  ticket       Ticket        @relation(fields: [ticketId], references: [id])
  changedBy    User          @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId])
}

model ServiceCenter {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  address   String?
  createdAt DateTime @default(now())
  tickets   Ticket[]
}
