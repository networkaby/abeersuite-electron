// ── Pipeline / Status ─────────────────────────────────────────────────────────

model Pipeline {
  id          String   @id
  name        String   @unique
  label       String
  description String?
  color       String   @default("bg-gray-100 text-gray-600")
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  // The FLAVOUR of Ticket this pipeline carries — selects the optional 1:1 detail
  // table + the UI. "repair" | "deal" | "order" | "delivery" | "refund" | "help"
  // (front-desk enquiry → TicketHelp) | "task" (a bare core row, no detail) |
  // "none". A sub-status' spawnPipelineId
  // resolves the target pipeline, then this decides which detail row the spawned
  // child gets (see lib/childEntities.ts registry).
  entityType  String   @default("repair")
  createdAt   DateTime @default(now())

  statuses TicketStatus[]
  workers  TicketWorker[]
  // Every flavour (repair / deal / order / delivery / refund / task) is a Ticket.
  tickets  Ticket[]
}

model TicketStatus {
  id              String             @id
  label           String
  color           String
  order           Int
  isTerminal      Boolean            @default(false)
  isEntryPoint    Boolean            @default(false)
  actionLabel     String?
  warrantyScope   String             @default("any")
  // ── Per-status crossing prompts (Pipeline→Status axis, no Worker involved) ──
  // leavePrompt: a confirmation message shown in the move dialog when a ticket
  // LEAVES this status (null = no prompt). announceOnEntry: when a ticket ENTERS
  // this status, auto-post a PUBLIC timeline message "<label> is started and will
  // take <etaText>" — the customer-facing ETA `Y`; etaText null = drop the tail.
  leavePrompt     String?
  announceOnEntry Boolean            @default(false)
  etaText         String?
  // Customer message when a ticket ENTERS this status (owner, 2026-11-08): a
  // WhatsApp template kind (REPAIR_RECEIVED / REPAIR_READY / CUSTOM_<id>) and an
  // email template kind. Null = nothing. Once per (template, ticket).
  waTemplate      String?
  emailTemplate   String?
  // Resolve-time SLA (hours). A ticket sitting in this status longer than this
  // many hours is "needs attention" — surfaced (overdue-first) in the Work Inbox.
  // null = no SLA on this status. Measured from Ticket.statusEnteredAt.
  resolveTimeHours Int?
  // Fallback WorkGroup tag for the Resolve-time badge, used only when this status's
  // active worker carries no Work (and so no groups) to inherit from.
  resolveGroupId  String?
  resolveGroup    WorkGroup?         @relation(fields: [resolveGroupId], references: [id], onDelete: SetNull)
  workId          String?
  work            Work?              @relation(fields: [workId], references: [id], onDelete: SetNull)
  // The sub-status auto-applied when a ticket ENTERS this status — hand-picked per
  // status (replaces the old global "lowest-order entry-point wins" heuristic). FK
  // SetNull so deleting that sub-status just clears the start, never blocks.
  startWorkerId   String?
  startWorker     TicketWorker?      @relation("StatusStartSub", fields: [startWorkerId], references: [id], onDelete: SetNull)
  workers         TicketWorker[]     @relation("StatusWorkers")
  pipelineId      String?
  pipeline        Pipeline?          @relation(fields: [pipelineId], references: [id])
  fromTransitions StatusTransition[] @relation("FromStatus")
  toTransitions   StatusTransition[] @relation("ToStatus")
  // Workers that jump straight to THIS status on their success / unsuccess outcome.
  successStatusOf TicketWorker[]     @relation("WorkerSuccessStatus")
  failStatusOf    TicketWorker[]     @relation("WorkerFailStatus")
  tickets         Ticket[]
  logs            TicketLog[]
}

model TicketWorker {
  id                 String              @id
  label              String
  // Customer-facing label shown on the portal ("My Repairs"). The internal `label`
  // and staff `actionLabel` stay private. Null = fall back to the parent status name.
  publicLabel        String?
  color              String              @default("bg-gray-100 text-gray-600")
  order              Int
  // Each sub-status belongs to exactly ONE parent status (no sharing). SetNull so
  // deleting a status leaves its sub-statuses as "unassigned" rather than deleting them.
  statusId           String?
  status             TicketStatus?       @relation("StatusWorkers", fields: [statusId], references: [id], onDelete: SetNull)
  triggerMap         Json                @default("{}")
  actionLabel        String?
  autoRevertOnClear  Boolean             @default(true)
  // ── Entry-time popup (on worker change / hand-off INTO this worker) ──────────
  // transitionNote: a fixed note auto-posted to the timeline (PUBLIC, customer-
  //   visible) when a ticket ENTERS this worker — no popup. Blank = none.
  // skipNoteOnEntry: false → the move shows the private/public note popup so the
  //   operator can write something; true → friction-free (transition note still posts).
  // entryQuestion: guidance shown at the top of that popup; the answer goes in the note.
  // entryArgs: dormant (structured ask-on-entry, kept to match the existing column).
  transitionNote     String?
  skipNoteOnEntry    Boolean             @default(false)
  // When the note popup shows (skipNoteOnEntry false), require a non-empty note —
  // the Move is blocked until the operator writes one (forces fresh, relevant context).
  requireNoteOnEntry Boolean             @default(false)
  entryQuestion      String?
  entryArgs          Json                @default("[]")
  warrantyScope      String              @default("any")
  successWorkerId    String?
  successWorker      TicketWorker?       @relation("WorkerSuccess", fields: [successWorkerId], references: [id], onDelete: SetNull)
  failWorkerId       String?
  failWorker         TicketWorker?       @relation("WorkerFail", fields: [failWorkerId], references: [id], onDelete: SetNull)
  successRoutedFrom  TicketWorker[]      @relation("WorkerSuccess")
  failRoutedFrom     TicketWorker[]      @relation("WorkerFail")
  // Direct outcome → STAGE jump. When set, completing this worker with that outcome
  // advances the ticket straight to this status (applying the status' entry worker),
  // instead of routing to a same-stage worker. The modern replacement for the old
  // "shim worker + triggerMap" bridge. Exactly one of successWorker/successStatus is
  // meaningful per outcome (the UI picks one). FK SetNull so deleting a status clears it.
  successStatusId    String?
  successStatus      TicketStatus?       @relation("WorkerSuccessStatus", fields: [successStatusId], references: [id], onDelete: SetNull)
  failStatusId       String?
  failStatus         TicketStatus?       @relation("WorkerFailStatus", fields: [failStatusId], references: [id], onDelete: SetNull)
  // ── Hybrid retry schedule ("attempt channels") ─────────────────────────────
  // A "waiting" sub-status (Unreachable, Awaiting-parts) re-arms its work on a
  // front-loaded schedule. The FIRST attempt is immediate — landing here from
  // elsewhere stays due now. Each Unsuccess that loops back onto this same
  // sub-status schedules the next attempt per the schedule, densest phase first,
  // setting wakeAt and dropping it into the Work Inbox "Waiting" tab until due.
  // retrySchedule is an ordered list of phases: [{ unit, every, times }] where
  // unit ∈ "minute"|"hour"|"day"|"week"|"month"|"year". Total attempts = 1 + Σtimes;
  // [] = no retry. After the last phase's last attempt, route to failWorker
  // (the "On unsuccess → move to" target doubles as the give-up destination).
  retrySchedule      Json                @default("[]")
  // 5th power: entering this sub-status spawns a CHILD ticket on this pipeline
  // (e.g. inbound parts courier). The parent mirrors the child and advances via
  // success/fail when the child terminates. Plain id (no FK) — keep it simple.
  spawnPipelineId    String?
  // Child-side report-back: when a CHILD ticket reaches this sub-status it signals
  // its parent — "success" fires the parent spawning sub-status' Success route,
  // "fail" fires Unsuccess. Parent-agnostic so the child pipeline is reusable.
  // null = no signal. (Future: "checkpoint:<label>" for mid-journey nudges.)
  parentSignal       String?
  // 6th power: an ordered, chainable list of ACTIONS that fire when this worker is
  // COMPLETED, filtered by outcome. Shape: [{ type, on, config }] where `type` is a
  // read-only code HOOK (spawn|move_status|email|retry|… — see actionTypes.ts),
  // `on` ∈ "success"|"fail"|"always", and `config` is that hook's arguments (e.g.
  // move_status → { statusId }). Dispatched in src/modules/repairing/lib/actions.ts.
  // [] = no actions.
  actions            Json                @default("[]")
  workId             String?
  work               Work?               @relation(fields: [workId], references: [id], onDelete: SetNull)
  pipelineId         String?
  pipeline           Pipeline?           @relation(fields: [pipelineId], references: [id])
  fromTransitions    WorkerTransition[]  @relation("FromWorker")
  toTransitions      WorkerTransition[]  @relation("ToWorker")
  startOfStatuses    TicketStatus[]      @relation("StatusStartSub")
  tickets            Ticket[]
  logs               TicketLog[]
  participants       TicketParticipant[] @relation("ParticipantWorker")
}

// A unit of work a status/sub-status represents (calling, parts, qc…). Each
// gated Work mints a permission ("work:<id>") that gates who can set statuses
// /sub-statuses carrying it. Generalizes the former WorkerGroup.
// A WorkGroup tags Works (e.g. "Calling" tags several calling works). A Work can
// carry MULTIPLE tags at once (many-to-many, via WorkGroupWork) — e.g. a "type"
// tag (Calling) AND a "team" tag (Repair) simultaneously, since a single group
// axis can't represent both what the work is AND who owns it. The Work Inbox
// builds its filter chips from whichever tags are visible to the caller, merged
// by LABEL — two different tag rows that happen to share a display name (e.g. a
// separate "Calling" tag per department) collapse into one chip, so a role with
// broad access (e.g. a manager holding every department's permission) sees one
// combined "Calling" chip instead of several identical-looking duplicates.
// A *gated* group (permissionId set) mints a permission ("workgroup:<id>") that
// controls who can SEE the group's tickets in the Work Inbox — distinct from a
// Work's own permissionId, which gates who can ACT on a ticket carrying that Work.
model WorkGroup {
  id           String          @id
  // Internal admin-facing name — tells apart same-labeled rows (e.g. two
  // "Calling" tags scoped to different departments) on the Groups settings
  // page. `label` stays the DISPLAY name shown to users / merge key (see
  // comment above); `name` is never shown outside admin settings.
  name         String          @default("")
  label        String
  color        String          @default("bg-gray-100 text-gray-600")
  order        Int             @default(0)
  permissionId String?
  permission   Permission?     @relation(fields: [permissionId], references: [id])
  createdAt    DateTime        @default(now())
  works        WorkGroupWork[]
  resolveStatuses TicketStatus[]
}

// Work ↔ WorkGroup join (many-to-many). See the WorkGroup comment above for why
// a Work needs more than one tag.
model WorkGroupWork {
  workGroupId String
  workId      String
  workGroup   WorkGroup @relation(fields: [workGroupId], references: [id], onDelete: Cascade)
  work        Work      @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@id([workGroupId, workId])
  @@index([workId])
}

model Work {
  id           String         @id
  label        String
  color        String         @default("bg-gray-100 text-gray-600")
  order        Int            @default(0)
  groups       WorkGroupWork[]
  // Custom outcome-button labels — the Work owns the VOCABULARY (e.g. Tele Calling →
  // "Reachable" / "Unreachable"); the Worker owns the WIRING (success/failWorkerId).
  // null → fall back to generic "Success" / "Unsuccess" on the completion buttons.
  successLabel String?
  failLabel    String?
  // ── Work shape (how the completion UI behaves) ──────────────────────────────
  // prompt: guidance shown at the top of the work's COMPLETION popup (when one opens).
  // startLabel: optional 2-step — a "start" button (claim/lock) shows first, then the
  //   outcome buttons reveal. null/blank = outcomes show directly.
  // successPopup / failPopup: that outcome opens the completion popup (to collect a
  //   note / arg) instead of completing silently.
  // Single-vs-two outcomes is derived from failLabel (blank → single button).
  prompt       String?
  startLabel   String?
  successPopup Boolean        @default(false)
  failPopup    Boolean        @default(false)
  // ── Execution kind ──────────────────────────────────────────────────────────
  // kind: "human" → a person completes it on the Work Inbox (the default Work).
  //       "auto"  → an ACTION: a hardcoded TOOL runs it (no human form). toolType
  //       selects the tool (see actionTools.ts); toolConfig holds its input bindings
  //       + output→context-key map: { bindings:{inKey→{mode:"fixed"|"context",value}},
  //       outputs:{toolOutKey→contextKey} }. Both yield Success/Unsuccess so a worker
  //       routes an Action exactly like a Work. Auto works are never gated.
  kind         String         @default("human")
  toolType     String?
  toolConfig   Json           @default("{}")
  // Arguments the work needs — [{ key, label, source, kind }]. `source` is either a
  // ticket-data path (e.g. "customer.phone", resolved LIVE & shown read-only) or
  // "user" (collected from the operator at completion → saved into Ticket.context).
  // See src/modules/repairing/lib/ticketSources.ts. [] = no arguments.
  args         Json           @default("[]")
  permissionId String?
  permission   Permission?    @relation(fields: [permissionId], references: [id])
  statuses     TicketStatus[]
  workers      TicketWorker[]
}

model WorkerTransition {
  id           Int           @id @default(autoincrement())
  fromWorkerId String?
  toWorkerId   String
  from         TicketWorker? @relation("FromWorker", fields: [fromWorkerId], references: [id], onDelete: Cascade)
  to           TicketWorker  @relation("ToWorker", fields: [toWorkerId], references: [id], onDelete: Cascade)

  @@unique([fromWorkerId, toWorkerId])
}

model StatusTransition {
  id           Int          @id @default(autoincrement())
  fromStatusId String
  toStatusId   String
  from         TicketStatus @relation("FromStatus", fields: [fromStatusId], references: [id], onDelete: Cascade)
  to           TicketStatus @relation("ToStatus", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@unique([fromStatusId, toStatusId])
}
