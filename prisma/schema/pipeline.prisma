// ── Pipeline / Status ─────────────────────────────────────────────────────────

model Pipeline {
  id          String   @id
  name        String   @unique
  label       String
  description String?
  color       String   @default("bg-gray-100 text-gray-600")
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  statuses    TicketStatus[]
  subStatuses TicketSubStatus[]
  tickets     Ticket[]
  deals       Deal[]
  shopOrders  ShopOrder[]
  tasks       Task[]
  // Order-type InvVouchers (POS_ORDER / SALES_ORDER) riding this pipeline (O2C P7).
  orderVouchers InvVoucher[] @relation("OrderVoucherPipeline")
  // Deliveries riding this pipeline (O2C P8).
  deliveries    Delivery[]   @relation("DeliveryPipeline")
  // Refunds riding this pipeline (O2C P9).
  refunds       Refund[]     @relation("RefundPipeline")
}

model TicketStatus {
  id              String             @id
  label           String
  color           String
  order           Int
  isTerminal      Boolean            @default(false)
  isEntryPoint    Boolean            @default(false)
  actionLabel     String?
  warrantyScope   String             @default("any")
  workId          String?
  work            Work?              @relation(fields: [workId], references: [id], onDelete: SetNull)
  pipelineId      String?
  pipeline        Pipeline?          @relation(fields: [pipelineId], references: [id])
  fromTransitions StatusTransition[] @relation("FromStatus")
  toTransitions   StatusTransition[] @relation("ToStatus")
  tickets         Ticket[]
  logs            TicketLog[]
  deals           Deal[]
  shopOrders      ShopOrder[]
  tasks           Task[]
  orderVouchers   InvVoucher[] @relation("OrderVoucherStatus")
  deliveries      Delivery[]   @relation("DeliveryStatus")
  refunds         Refund[]     @relation("RefundStatus")
}

model TicketSubStatus {
  id                  String                @id
  label               String
  color               String                @default("bg-gray-100 text-gray-600")
  order               Int
  applicableStatusIds String[]
  triggerMap          Json                  @default("{}")
  actionLabel         String?
  autoRevertOnClear   Boolean               @default(true)
  warrantyScope       String                @default("any")
  successSubStatusId  String?
  successSubStatus    TicketSubStatus?      @relation("SubStatusSuccess", fields: [successSubStatusId], references: [id], onDelete: SetNull)
  failSubStatusId     String?
  failSubStatus       TicketSubStatus?      @relation("SubStatusFail", fields: [failSubStatusId], references: [id], onDelete: SetNull)
  successRoutedFrom   TicketSubStatus[]     @relation("SubStatusSuccess")
  failRoutedFrom      TicketSubStatus[]     @relation("SubStatusFail")
  workId              String?
  work                Work?                 @relation(fields: [workId], references: [id], onDelete: SetNull)
  pipelineId          String?
  pipeline            Pipeline?             @relation(fields: [pipelineId], references: [id])
  fromTransitions     SubStatusTransition[] @relation("FromSubStatus")
  toTransitions       SubStatusTransition[] @relation("ToSubStatus")
  tickets             Ticket[]
  logs                TicketLog[]
  participants        TicketParticipant[]   @relation("ParticipantSubStatus")
}

// A unit of work a status/sub-status represents (calling, parts, qc…). Each
// gated Work mints a permission ("work:<id>") that gates who can set statuses
// /sub-statuses carrying it. Generalizes the former SubStatusGroup.
model Work {
  id           String            @id
  label        String
  color        String            @default("bg-gray-100 text-gray-600")
  order        Int               @default(0)
  permissionId String?
  permission   Permission?       @relation(fields: [permissionId], references: [id])
  statuses     TicketStatus[]
  subStatuses  TicketSubStatus[]
}

model SubStatusTransition {
  id              Int              @id @default(autoincrement())
  fromSubStatusId String?
  toSubStatusId   String
  from            TicketSubStatus? @relation("FromSubStatus", fields: [fromSubStatusId], references: [id], onDelete: Cascade)
  to              TicketSubStatus  @relation("ToSubStatus", fields: [toSubStatusId], references: [id], onDelete: Cascade)

  @@unique([fromSubStatusId, toSubStatusId])
}

model StatusTransition {
  id           Int          @id @default(autoincrement())
  fromStatusId String
  toStatusId   String
  from         TicketStatus @relation("FromStatus", fields: [fromStatusId], references: [id], onDelete: Cascade)
  to           TicketStatus @relation("ToStatus", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@unique([fromStatusId, toStatusId])
}
