// ── CRM (leads / deals — device-less; stages = TicketStatus on the P6 pipeline) ─
// HubSpot-style deal pipeline. Like the Administration work board, a lead is
// owned by a Position (seat) — the current holder is resolved live via
// UserPosition, so deals transfer automatically on staff change — and the actor
// of an action is a frozen JSON snapshot (ActorSnapshot), not a User FK.

model CrmLead {
  id          Int      @id @default(autoincrement())
  pipelineId  String // P6 "crm-leads"
  status      String // TicketStatus stage (S35 Lead … S41 Lost)
  title       String

  // Contact + association (link to an existing customer ledger, HubSpot-style)
  contactName String?
  phone       String?
  email       String?
  companyName String?
  personId    Int?
  companyId   Int?

  // Deal
  valuePaise     Int?
  source         String?
  priority       Priority  @default(MEDIUM) // enum from tickets.prisma
  nextFollowUpAt DateTime? // card follow-up; overdue highlighted
  closedAt       DateTime? // set on a terminal stage (Won / Lost)
  lostReason     String?
  order          Int       @default(0) // ordering within a kanban column

  // Ownership = seat, not user; actor = frozen JSON snapshot
  assignedPositionId String?
  createdBy          Json   @default("{}") // ActorSnapshot

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pipeline         Pipeline          @relation(fields: [pipelineId], references: [id])
  ticketStatus     TicketStatus      @relation(fields: [status], references: [id])
  person           Person?           @relation(fields: [personId], references: [id])
  company          Company?          @relation(fields: [companyId], references: [id])
  assignedPosition Position?         @relation("CrmLeadPosition", fields: [assignedPositionId], references: [id])
  activities       CrmLeadActivity[]

  @@index([pipelineId, status])
  @@index([assignedPositionId])
  @@index([createdAt])
}

// HubSpot-style record timeline: notes, logged calls/meetings, follow-up tasks,
// and auto SYSTEM entries (stage / owner change).
model CrmLeadActivity {
  id        Int             @id @default(autoincrement())
  leadId    Int
  author    Json            @default("{}") // ActorSnapshot
  kind      CrmActivityKind @default(NOTE)
  body      String
  dueAt     DateTime? // TASK follow-ups
  doneAt    DateTime? // TASK completed
  createdAt DateTime        @default(now())

  lead CrmLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

enum CrmActivityKind {
  NOTE
  CALL
  MEETING
  TASK
  SYSTEM
}
