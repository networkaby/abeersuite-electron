// ── CRM (leads — device-less; stages = TicketStatus on CRM pipeline) ─────────

model CrmLead {
  id          Int      @id @default(autoincrement())
  pipelineId  String
  status      String
  title       String
  contactName String?
  phone       String?
  email       String?
  companyName String?
  valuePaise  Int?
  source      String?
  notes       String?  @db.Text
  personId    Int?
  companyId   Int?
  ownerUserId Int?
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id])
  ticketStatus TicketStatus @relation(fields: [status], references: [id])
  person       Person?      @relation(fields: [personId], references: [id])
  company      Company?     @relation(fields: [companyId], references: [id])
  owner        User?        @relation("CrmLeadOwner", fields: [ownerUserId], references: [id])
  createdBy    User         @relation("CrmLeadCreatedBy", fields: [createdById], references: [id])

  @@index([pipelineId, status])
  @@index([ownerUserId])
  @@index([createdAt])
}
