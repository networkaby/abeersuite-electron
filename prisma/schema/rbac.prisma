// ── RBAC ──────────────────────────────────────────────────────────────────────

model Role {
  id                 String           @id
  label              String
  color              String
  rank               Int              @default(0)
  isSystem           Boolean          @default(false)
  // Home department — every role belongs to exactly one department. This is an
  // AUTHORING lens: the Role Matrix UI only offers the permissions in this
  // department's pool (see DepartmentPermission). It does NOT scope data access
  // (that comes from the holder's Position + User.scope). Cross-cutting roles
  // (e.g. R1 Admin) live in the all-access department (Department.isAllAccess).
  departmentId       String
  department         Department       @relation(fields: [departmentId], references: [id])
  users              User[]
  templatedPositions Position[]
  permissions        RolePermission[]
  chatRooms          ChatRoom[]
}

model Permission {
  id             String                 @id
  label          String
  description    String?
  module         String                 @default("core")
  systemOnly     Boolean                @default(false)
  roleGrants     RolePermission[]
  userOverrides  UserPermission[]
  departmentPool DepartmentPermission[]
  works          Work[]
}

model UserPermission {
  id           Int          @id @default(autoincrement())
  userId       Int
  permissionId String
  type         OverrideType
  reason       String?
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ── DepartmentPermission — a department's curated permission "pool" ────────────
// The menu of permissions surfaced in the Role Matrix when authoring a role
// homed in this department. Picked once, at department creation, from the full
// permission list. A permission may sit in several departments' pools (e.g.
// finance:invoice in both Sales and Accounts). The all-access department
// (Department.isAllAccess) carries NO rows — its pool is "every permission",
// computed on the fly, so new permissions are auto-included. Authoring filter
// only — never consulted at runtime permission checks.
model DepartmentPermission {
  departmentId String
  permissionId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([departmentId, permissionId])
}
