# next.js
/.next/
/out/

# production
# `build/` is also electron-builder's buildResources directory. The app icon and the
# installer's own scripts must be committed, or an installer built on any other machine
# falls back to the default Electron icon and silently loses the install-time setup.
# Everything else in build/ stays ignored.
/build/*
!/build/icon.png
# The Windows icon is COMMITTED rather than converted from icon.png at build time.
# electron-builder's PNG->ICO step is a WebAssembly tool that dies with "Fatal process
# out of memory" on a machine that has just run `next build` with an 8 GB heap, and it
# re-runs on every build even though its own output is already cached. These are those
# exact bytes (7 sizes, 16x16 to 256x256, generated by electron-builder itself), so the
# shipped icon is unchanged — the converter simply never has to run.
# Regenerate with: pnpm icon:build, or copy dist-app/.icon-ico/icon.ico back here.
!/build/icon.ico
!/build/installer.nsh
!/build/counter-setup.ps1
!/build/counter-teardown.ps1

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Counter-PC template. Tracked on purpose: electron/main.ts points operators at this
# file by name, so a fresh clone must have it. Contains dummy values only — never
# paste a real credential into it.
!.env.example

# Local env templates with real credentials — keep on disk only
experiment.env.example
demo.env.example

# Generated at build time by scripts/generate-counter-env.ts — the live credentials
# baked into a counter installer. Listed explicitly because `.env*` above does NOT
# match it: that pattern needs the basename to start with `.env`, and this file is
# named `counter.env` precisely so it does not collide with the packaging gate's
# "no .env anywhere in the package" check.
resources/counter.env

# Embedded PostgreSQL bundled into the desktop installer. ~80 MB of third-party
# binaries — fetched reproducibly by `pnpm pg:fetch` (pinned version + checksum),
# never committed. See scripts/fetch-pg.ts.
resources/pgsql/
.pg-download-cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.pnpm-store

# Sentry Config File
.env.sentry-build-plugin

# Personal config snapshot (prisma/seeds/data/personal.local.json) is COMMITTED
# on purpose — it is scrubbed of secrets (no password hashes; see
# personalSnapshot.ts) and carries your real config for `pnpm seed:personal`.

# Thermal relay local config (contains printer IP)
tools/thermal-relay/config.json
tools/thermal-relay/node_modules/
block.env.local
.block.env.local
.block.env
.block.experimant.env
.block.office.env.local

# Database dumps pulled down from Dropbox for local restore testing. These are
# full production dumps (real customer + ledger data) — never commit them.
*.dump

src/generated/

# Local scratch / debug scripts and restore dumps — personal tooling, not app
# code. Never commit these.
scratch/
_tmp_t.ts
_tmp_*.ts
dbrows.local.ts
backup.sql
backup-*.sql
restore-*.sql
.freebuff/preview-0c473ed9-f97d-47aa-8ada-12ce817c5194.log.err
.freebuff


