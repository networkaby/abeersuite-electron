######################################################################################################################
# AbeerSuite environment template
#
# Copy to `.env` and fill in. `.env` is the ONE file the desktop build reads
# (scripts/electron-build.ts) — `.env.local` is deliberately NOT loaded there, so a dev
# override can never be baked into a counter installer. Use `.env.local` for dev-server
# overrides only.
#
# Markers below say where each key actually ends up:
#   [counter]  copied into resources/counter.env on EVERY desktop build
#   [office]   copied only when APP_MODE=office (backup/restore keys)
#   [build]    used by the build/release scripts on this machine only — never shipped
#   [web]      Vercel / dev server only — never reaches a counter
#   (no mark)  server-side web feature, not used by the desktop app
#
# The allowlist is scripts/counterEnv.ts and scripts/verify-package.ts FAILS the build if
# anything outside it reaches the installer. That gate exists because the 0.1.0 build
# shipped this whole file — payment salts included — onto every counter by accident.
# Never widen it casually.
#
# NEVER commit real values here. This file is tracked (.gitignore negates it); `.env` is
# not. A previous template shipped a live Supabase credential behind a comment claiming
# its values were examples.
######################################################################################################################

######################################################################################################################
#---------Deployement Wise Variable -----------------
######################################################################################################################

# App & Auth
NEXTAUTH_URL=http://localhost:3000
# Web deployment: required. Desktop: baked into counter.env (counterEnv.ts) — a v_live till
# must carry the SAME secret as the office it relays to, so set it to the office's value
# before building; absent, each machine generates its own on first run (ensureAuthSecret).
# Generate: openssl rand -base64 36
AUTH_SECRET=replace-me-with-a-generated-secret
# Written as a constant by the build (counterEnv.ts COUNTER_ENV_CONSTANTS), so the
# desktop app does not need it here. Set it for the web deployment.
AUTH_TRUST_HOST=true

# [counter] office | counter | full | public — decides the desktop variant
APP_MODE=office
# [counter] path only, validated at load — see appModeCore.ts resolveLandingPage()
LANDING_PAGE=/staff/login

# Counter & Replica Mode
COUNTER_PC=false
# [counter] live | shadow | local — where reads are served from
READ_MODE=live
# [counter] live | local | v_live — where writes land. v_live = live, but every non-GET
# /api/* call is relayed to the office deployment below as one round trip.
WRITE_MODE=live
# [counter] v_live only — the office origin the till relays writes to (no path)
# WRITE_API_URL=https://office.example.com

#-----------------------------------------------------------------------------------------------------------------------
# Database (Supabase)
# [counter] pooled connection — everything the app reads or writes goes through this
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# Direct 5432 connection. Seeds and maintenance scripts only — deliberately NOT shipped.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# [counter] the three below are read at runtime by the server half for realtime nudges
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

#----------------------------------------------------------------------------------------------------------------------

# GitHub (Workflow)
# [office] backup/restore is triggered through a GitHub Actions workflow
GITHUB_DISPATCH_TOKEN=github_pat_your_dispatch_token
GITHUB_REPO=your-org/your-repo
GITHUB_WORKFLOW_REF=your-org/your-repo/.github/workflows/backup.yml@refs/heads/main

# [office]
DROPBOX_FOLDER=/AbeerSuiteBackups
#----------------------------------------------------------------------------------------------------------------------
# App Only
# [build] release targets — release-electron.ts publishes to each GITHUB_UPDATE_REPO_N /
# GH_TOKEN_N pair in turn. Numbered from 1; add _2, _3 as needed.
GITHUB_UPDATE_REPO_1=your-org/your-release-repo
GH_TOKEN_1=github_pat_your_release_upload_token

# GITHUB_UPDATE_REPO_2=your-org/your-second-release-repo
# GH_TOKEN_2=github_pat_your_second_release_token

# Auto Updater (download)
# [counter] a SEPARATE private release-artifacts-only repo, never the source repo.
# The PAT must be fine-grained, "Contents: Read-only", scoped to that repo alone — it
# ships inside every installer, so treat it as public. Both optional: absent, the app
# logs and skips update checks rather than failing to boot.
GITHUB_DOWNLOAD_UPDATE_REPO=your-org/your-release-repo
GITHUB_DOWNLOAD_UPDATE_PAT_TOKEN=github_pat_your_readonly_release_token

# [build] dev downloader — build-downloader-dev.ts builds a second web setup exe
# pointed at GITHUB_UPDATE_REPO_2 (the test/prerelease channel), so test builds can
# be fetched without touching the real customer-facing downloader. Same read-only
# scoping rule as above: fine-grained, "Contents: Read-only", scoped to that repo alone.
GITHUB_DOWNLOAD_UPDATE_PAT_TOKEN_2=github_pat_your_readonly_test_repo_token


######################################################################################################################
# -------------------------- constent ----------------------------
######################################################################################################################

# App & Auth
# [counter] REQUIRED. Absent, the staff domain allowlist fails closed and every sign-in is
# refused with "Invalid email or password" before the password is even checked.
INTERNAL_STAFF_EMAIL_DOMAINS=yourcompany.com,yourcompany.in
# Database-free way back into a broken machine. Deliberately NOT shipped to counters.
SUPER_ADMIN_EMAIL=admin@yourcompany.com
SUPER_ADMIN_PASSWORD=set-a-strong-password

# Cloudinary & Media
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Backups (Dropbox)
# [office] absent, backupAvailability() turns the whole feature off with an in-app message
DROPBOX_APP_KEY=your-dropbox-app-key
DROPBOX_APP_SECRET=your-dropbox-app-secret
DROPBOX_REFRESH_TOKEN=your-dropbox-refresh-token

# Payment Gateways
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

PAYU_MERCHANT_KEY=your-payu-key
PAYU_MERCHANT_SALT=your-payu-salt

CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key

# Shipping & Hardware
SHIPROCKET_EMAIL=you@yourcompany.com
SHIPROCKET_PASSWORD=your-shiprocket-password
SHIPROCKET_WEBHOOK_TOKEN=your-webhook-token

SHIPWAY_USERNAME=you@yourcompany.com
SHIPWAY_LICENSE=your-shipway-license-key

######################################################################################################################
# ----------------------------- web only ---------------------------
######################################################################################################################

# [web] ePBX call-log bridge -> /api/calls shared secret
CALLS_API_KEY=your-calls-api-shared-secret

# [web] Canonical site URL for dev/preview
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# [web] local Postgres for dev/compare scripts
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/abeersuite

# Error Tracking & Monitoring (Sentry - Optional)
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXX.ingest.sentry.io/XXXXXXX
SENTRY_AUTH_TOKEN=your-sentry-auth-token


# SMS & WhatsApp Notifications / OTP (Optional)
# Full walkthrough: docs/portal-passwordless-setup.md
FAST2SMS_API_KEY=your-fast2sms-api-key
# "q" (default) = no DLT, no template, ~Rs 5/SMS. "otp" = dashboard template, far cheaper.
FAST2SMS_ROUTE=q
# Only when FAST2SMS_ROUTE=otp
FAST2SMS_OTP_TEMPLATE_ID=
# WhatsApp passthrough (Option B) — only when not going direct to Meta
FAST2SMS_WA_PHONE_NUMBER_ID=
FAST2SMS_WA_OTP_TEMPLATE=

# WhatsApp direct to Meta (Option A, cheapest — ~Rs 0.115 per code, no markup)
META_WA_ACCESS_TOKEN=your-meta-whatsapp-access-token
META_WA_PHONE_NUMBER_ID=your-phone-number-id
# The approved AUTHENTICATION template's NAME, not its id
WA_OTP_TEMPLATE=your_otp_template_name
# The template's language code EXACTLY as approved — usually en_US, not en.
# A mismatch makes Meta reject every send and we fall back to Rs 5 SMS.
WA_OTP_LANG=en_US
# "copy_code" if the template has Meta's "Copy code" button (the wizard adds it
# by default), "one_tap" for an Android app template, unset for body-only.
# Wrong value here = every WhatsApp send fails, silently, into the SMS fallback.
WA_OTP_BUTTON=copy_code

# Customer Portal Passwordless Auth (Firebase & Resend - Optional)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=AbeerSuite <no-reply@yourcompany.com>

# Staff mail forwarding (Cloudflare Email Routing) — office/Vercel only.
# Lets each staff member point name@networkservice.in at their own inbox from
# My Profile -> Security, so staff "Forgot password" mail reaches them.
# Token: Zone > Email Routing Rules > Edit, Account > Email Routing Addresses > Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Service-account JSON. Keep it on ONE line, single-quoted, with \n inside the private
# key — a multi-line value breaks dotenv and every tool that scans this file.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}'

# Shared password for the cron endpoints (/api/cron/backup, /api/cron/backup-due).
# Without it those routes skip their auth check entirely and anyone who knows the
# URL can trigger -- or suppress -- a backup. Must match the Vercel env var and the
# GitHub Actions secret of the same name.
CRON_SECRET=your-long-random-cron-secret
