# ── AbeerSuite Counter Machine Environment ──────────────────────────────────
# Copy this file to the counter's app-data folder as `.env`:
#
#     %APPDATA%\abeersuite-electron\.env
#
# The folder name comes from Electron's app.getName(), which reads package.json
# "name" — NOT the "AbeerSuite" product name. If AbeerSuite cannot find the file it
# shows an error dialog naming the exact path it looked in; trust that path over
# this comment.
#
# The Electron main process loads this file at startup (see electron/main.ts) and
# passes it on to the Next.js server it launches, so this one file configures the
# whole app.
#
# The installer deliberately ships NO .env of its own — a bundled copy would put
# production credentials on every shop PC in plaintext.
#
# EVERY VALUE BELOW IS A DUMMY. Replace each one. This file is committed to the
# repository, so never paste a real credential into it.

# ── Database (Supabase — source of truth) ────────────────────────────────────
# REQUIRED. From Supabase → Project Settings → Database → Connection string.
# Use the pooler (port 6543) for DATABASE_URL and the direct port (5432) for DIRECT_URL.
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED. Signs the session JWTs. Generate a fresh one per deployment with:
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Do not ship the value below. Anyone who knows the secret can forge a staff
# session cookie for this install.
AUTH_SECRET=replace-me-with-a-generated-secret

AUTH_TRUST_HOST=true

# REQUIRED for staff login. Comma-separated list of email domains allowed to sign
# in at /staff/login. The check FAILS CLOSED: if this is unset (and COMPANY_DOMAIN
# is too), the allowed list is empty and EVERY staff login is refused with
# "Invalid email or password" — before the password is even checked. See
# src/shared/lib/auth/staffEmailAllowlist.ts.
INTERNAL_STAFF_EMAIL_DOMAINS=yourcompany.in,yourothercompany.in

# Optional escape hatch. These two are checked BEFORE the domain allowlist and
# before any database query, so this account can still sign in when the database
# is unreachable or empty. Leave either blank to disable it entirely.
# Set a strong password — it is a full-authority login held in plaintext on the PC.
# SUPER_ADMIN_EMAIL=admin@yourcompany.in
# SUPER_ADMIN_PASSWORD=

# ── Counter mode ─────────────────────────────────────────────────────────────
# v1 runs in LIVE mode: the counter reads and writes straight to Supabase and there
# is no local replica. Leave COUNTER_PC unset for that.
#
# Setting COUNTER_PC=1 opts this machine into the local-replica path. It only does
# something once portable PostgreSQL binaries are bundled in resources/pgsql — until
# then the app logs a warning and stays in live mode.
# COUNTER_PC=1

# Connection string for the local replica. Leave this unset: the app sets it itself,
# and only after it has confirmed a local PostgreSQL is actually listening. Pointing
# it at a database that does not exist turns a brief Supabase blip into a hard failure.
# LOCAL_DATABASE_URL=postgresql://postgres@localhost:54329/smx

# Where to serve reads from: live | shadow | local
# Keep "live" until a replica exists and has been verified.
READ_MODE=live

# ── App mode ─────────────────────────────────────────────────────────────────
APP_MODE=office

# ── Optional integrations ────────────────────────────────────────────────────
# Payments, Cloudinary uploads, Dropbox backup, WhatsApp and email each need their
# own keys. They are not listed here because none of them is required to start the
# app or to log in — add only the ones this counter actually uses, copying the key
# names from the main project .env.
